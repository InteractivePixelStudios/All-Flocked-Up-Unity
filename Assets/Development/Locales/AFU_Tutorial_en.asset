  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: Now for some basics.   <sprite name="KBM_WASD">   /   <sprite name="Con_L">  
      lets you <color=red>MOVE</color> around.   <sprite name="KBM_Mouse">   /  
      <sprite name="Con_R">   moves the <color=red>CAMERA</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Great! Press   <sprite name="KBM_Space">   /   <sprite name="Con_A">  
      to <color=red>JUMP</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: Now <color=red>JUMP</color> then press <sprite name="KBM_Space"> 
      or <sprite name="Con_A"> again to start <color=red>FLYING</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: You've done so well Peep! There's a few other pigeons you should
      go see...
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert will show you how to <color=red>SNEAK</color> around
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: Ruffle can tell you where to find <color=red>FOOD</color>
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: <color=red>RACE</color> Arnesto to test your skills!
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: 'Anytime you think you''re ready, you can take the <color=red>SWAN</color>
      to Pigeonton Market! '
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: You can use <sprite name="KBM_E"> or <sprite name="Con_X"> to <color=red>INTERACT</color>
      or <color=red>SPEAK</color> with other pigeons
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: If you need to see the controls again you can find them in the <color=red>PAUSE</color>
      menu with   <sprite name="KBM_Esc">   or   <sprite name="Con_Start">   !
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: Peep, my feathery friend... You have soo much to learn!
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: See your <color=red>FACE</color> right there? A healthy bird is
      important so make sure to always look your best!
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: That <color=green>GREEN</color> bar? Stamina helps you <color=red>RUN</color>
      and <color=red>FLAP</color> your way out of danger. Or in... It's your choice...
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: The WHITE? What do we do best? <color=red>POOP</color>! Make sure
      to keep that belly full!
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: 'Always keep an eye out at your <color=red>MINI-MAP</color> and
      <color=red>COMPASS</color>! '
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: <sprite name="KBM_I">   or   <sprite name="Con_Select">  will open
      your <color=red>WINGVENTORY</color>. Any <color=red>ITEMS</color> or <color=red>ACCESSORIES</color>
      you find can go in here.
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: 'Pressing <sprite name="KBM_M"> or <sprite name="Con_DUp"> will
      show your <color=red>MAP</color> '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
