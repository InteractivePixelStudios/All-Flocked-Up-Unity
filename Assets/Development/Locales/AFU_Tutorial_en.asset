  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: Now for some basics. <color=red>WASD</color> or <sprite name="StickL">
      lets you WALK around. <color=red>MOUSE or RIGHT STICK</color> moves the camera!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Great! Press <color=red>SPACE or A BUTTON</color> to JUMP!
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: Now JUMP then press <color=red>SPACE  or A BUTTON </color>again
      to start flying!
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: You've done so well Peep! There's a few other pigeons you should
      go see...
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert will show you how to SNEAK around
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: Ruffle can tell you where to find food
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: Race Arnesto to test your skills!
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: 'Anytime you think you''re ready, you can take the Coober to Pigeonton
      Market! '
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: You can use <color=red>E or X BUTTON to INTERACT</color> or SPEAK
      with other pigeons
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: If you need to see the controls again you can find them in the PAUSE
      menu with <color=red>ESCAPE or START BUTTON!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: Peep, my feathery friend... You have soo much to learn!
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: See your face right there? A healthy bird is important so make sure
      to always look your best!
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: That GREEN bar? Stamina helps you RUN and FLAP your way out of danger.
      Or in... It's your choice...
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: The WHITE? What do we do best? POOP! Make sure to keep that belly
      full!
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: 'Always keep an eye out at your MINI-MAP and COMPASS! '
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: <color=red>I or SELECT BUTTON</color> will open your WINGVENTORY.
      Any ITEMS or ACCESSORIES you find can go in here
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: 'Pressing <color=red>M or D-PAD UP</color> will show your MAP '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
