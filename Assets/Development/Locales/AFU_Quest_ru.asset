  m_TableData:
  - m_Id: 12737099546415104
    m_Localized: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
      \u0441 \u043C\u0443\u0441\u043E\u0440\u043E\u043C \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \u0437\u0430\u043A\u0443\u0441\u043E\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737056970035200
    m_Localized: "\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043E\u0439
      \u041F\u0420\u0418\u0417!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737008773287936
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439
      \u043C\u0443\u0441\u043E\u0440 \u0438 \u0432\u044B\u0431\u0440\u043E\u0441\u044C\u0442\u0435
      \u0435\u0433\u043E \u0432 \u043C\u0443\u0441\u043E\u0440\u043D\u044B\u0439
      \u0431\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 12736899411005440
    m_Localized: "\u0413\u0440\u044F\u0437\u043D\u044B\u0435 \u043B\u044E\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12736881279029248
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12736858042585088
    m_Localized: "\u041C\u0443\u0441\u043E\u0440\u043D\u0430\u044F \u043F\u0442\u0438\u0446\u0430?
      \u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u043E\u043B\u043E\u0434\u043D\u0430\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 12736838291607552
    m_Localized: "\u0423\u0437\u043D\u0430\u0439\u0442\u0435, \u0433\u0434\u0435
      \u043D\u0430\u0439\u0442\u0438 \u0435\u0434\u0443 \u0438 \u043A\u0430\u043A
      \u0443\u0431\u0438\u0440\u0430\u0442\u044C \u0437\u0430 \u0441\u043E\u0431\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736818372857856
    m_Localized: "\u0423\u0437\u043D\u0430\u0439\u0442\u0435, \u0433\u0434\u0435
      \u043D\u0430\u0439\u0442\u0438 \u0435\u0434\u0443 \u0438 \u043A\u0430\u043A
      \u0443\u0431\u0438\u0440\u0430\u0442\u044C \u0437\u0430 \u0441\u043E\u0431\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736719018184704
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0439\u0442\u0435
      \u043E\u0442\u0445\u043E\u0434\u044B, \u0435\u0448\u044C\u0442\u0435, \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12734258014507008
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12734229006700544
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12734174208118784
    m_Localized: "\u041A\u0443\u0431\u0435\u0440\u0442 \u0443\u0432\u0438\u0434\u0435\u043B
      \u0432 \u0442\u0435\u0430\u0442\u0440\u0435 \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
      \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438... \u041C\u043E\u0436\u0435\u0442,
      \u0442\u044B \u0441\u0430\u043C \u0438\u0445 \u0432\u043E\u0437\u044C\u043C\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 12734130943873024
    m_Localized: "\u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0438\u0442\u0435 \u0432
      \u0442\u0435\u0430\u0442\u0440 \u0442\u0430\u0439\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 12734078028533760
    m_Localized: "\u041F\u0440\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
