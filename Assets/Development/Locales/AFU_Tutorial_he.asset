  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: "\u05D0\u05DD \u05D0\u05EA\u05DD \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD
      \u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05EA \u05D4\u05E4\u05E7\u05D3\u05D9\u05DD
      \u05E9\u05D5\u05D1, \u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05DE\u05E6\u05D5\u05D0
      \u05D0\u05D5\u05EA\u05DD \u05D1\u05EA\u05E4\u05E8\u05D9\u05D8 PAUSE!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "\u05E0\u05D9\u05EA\u05DF \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1-E
      \u05D0\u05D5 \u05D1-X \u05DB\u05D3\u05D9 \u05DC\u05EA\u05E7\u05E9\u05E8 \u05D0\u05D5
      \u05DC\u05D3\u05D1\u05E8 \u05E2\u05DD \u05D9\u05D5\u05E0\u05D9\u05DD \u05D0\u05D7\u05E8\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "\u05D1\u05DB\u05DC \u05E2\u05EA \u05E9\u05EA\u05D7\u05E9\u05D1\u05D5
      \u05E9\u05D0\u05EA\u05DD \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD, \u05D0\u05EA\u05DD
      \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05E7\u05D7\u05EA \u05D0\u05EA
      \u05D4\u05E7\u05D5\u05D1\u05E8 \u05DC\u05E9\u05D5\u05E7 \u05E4\u05D9\u05D2'\u05E0\u05D8\u05D5\u05DF!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "\u05D4\u05EA\u05D7\u05E8\u05D5 \u05D1\u05D0\u05E8\u05E0\u05E1\u05D8\u05D5
      \u05DB\u05D3\u05D9 \u05DC\u05D1\u05D7\u05D5\u05DF \u05D0\u05EA \u05DB\u05D9\u05E9\u05D5\u05E8\u05D9\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "\u05E8\u05D0\u05E4\u05DC \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D2\u05D9\u05D3
      \u05DC\u05DA \u05D0\u05D9\u05E4\u05D4 \u05DC\u05DE\u05E6\u05D5\u05D0 \u05D0\u05D5\u05DB\u05DC"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "\u05E7\u05D5\u05D1\u05E8 \u05D9\u05E8\u05D0\u05D4 \u05DC\u05DA
      \u05D0\u05D9\u05DA \u05DC\u05D4\u05EA\u05D2\u05E0\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "\u05D9\u05E9 \u05E2\u05D5\u05D3 \u05DB\u05DE\u05D4 \u05D9\u05D5\u05E0\u05D9\u05DD
      \u05E9\u05DB\u05D3\u05D0\u05D9 \u05DC\u05DB\u05DD \u05DC\u05DC\u05DB\u05EA
      \u05DC\u05E8\u05D0\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "\u05E7\u05E4\u05D5\u05E5 \u05D5\u05D0\u05D6 \u05DC\u05D7\u05E5
      \u05E9\u05D5\u05D1 \u05E2\u05DC \u05E8\u05D5\u05D5\u05D7 \u05DB\u05D3\u05D9
      \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05DC\u05E2\u05D5\u05E3!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05E8\u05D5\u05D5\u05D7
      \u05DB\u05D3\u05D9 \u05DC\u05E7\u05E4\u05D5\u05E5!"
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: "WASD \u05DC\u05DC\u05DB\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "\u05E4\u05D9\u05E4, \u05D9\u05D3\u05D9\u05D3\u05D9 \u05D4\u05E0\u05D5\u05E6\u05E5...
      \u05D9\u05E9 \u05DC\u05DA \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D3\u05D9 \u05DC\u05DC\u05DE\u05D5\u05D3!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "\u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA \u05D4\u05E4\u05E0\u05D9\u05DD
      \u05E9\u05DC\u05DA \u05E9\u05DD? \u05E6\u05D9\u05E4\u05D5\u05E8 \u05D1\u05E8\u05D9\u05D0\u05D4
      \u05D7\u05E9\u05D5\u05D1\u05D4, \u05D0\u05D6 \u05EA\u05D5\u05D5\u05D3\u05D0\u05D5
      \u05E9\u05EA\u05DE\u05D9\u05D3 \u05E0\u05E8\u05D0\u05D9\u05DD \u05D1\u05DE\u05D9\u05D8\u05D1\u05DB\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "\u05D4\u05E1\u05E8\u05D2\u05DC \u05D4\u05D9\u05E8\u05D5\u05E7 \u05D4\u05D6\u05D4?
      \u05E1\u05D9\u05D1\u05D5\u05DC\u05EA \u05E2\u05D5\u05D6\u05E8\u05EA \u05DC\u05DA
      \u05DC\u05E8\u05D5\u05E5 \u05D5\u05DC\u05E0\u05E4\u05E0\u05E3 \u05D1\u05D3\u05E8\u05DB\u05DA
      \u05D4\u05D7\u05D5\u05E6\u05D4 \u05DE\u05E1\u05DB\u05E0\u05D4. \u05D0\u05D5
      \u05E4\u05E0\u05D9\u05DE\u05D4... \u05D6\u05D5 \u05D4\u05D1\u05D7\u05D9\u05E8\u05D4
      \u05E9\u05DC\u05DA..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: "\u05D4\u05DC\u05D1\u05DF? \u05DE\u05D4 \u05D0\u05E0\u05D7\u05E0\u05D5
      \u05E2\u05D5\u05E9\u05D9\u05DD \u05D4\u05DB\u05D9 \u05D8\u05D5\u05D1? \u05DC\u05E2\u05E9\u05D5\u05EA
      \u05E7\u05E7\u05D9! \u05DC\u05D5\u05D5\u05D3\u05D0 \u05E9\u05D4\u05D1\u05D8\u05DF
      \u05DE\u05DC\u05D0\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "\u05EA\u05DE\u05D9\u05D3 \u05E9\u05D9\u05DE\u05D5 \u05E2\u05D9\u05DF
      \u05E2\u05DC \u05D4\u05DE\u05D9\u05E0\u05D9-\u05DE\u05E4\u05D4 \u05D5\u05D4\u05DE\u05E6\u05E4\u05DF
      \u05E9\u05DC\u05DB\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "\u05DC\u05D7\u05D9\u05E6\u05D4 \u05E2\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8
      I \u05D0\u05D5 \u05E2\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8 \u05D4\u05D1\u05D7\u05D9\u05E8\u05D4
      \u05EA\u05E4\u05EA\u05D7 \u05D0\u05EA WINGVENTORY \u05E9\u05DC\u05DA. \u05DB\u05DC
      \u05E4\u05E8\u05D9\u05D8 \u05D0\u05D5 \u05D0\u05D1\u05D9\u05D6\u05E8 \u05E9\u05EA\u05DE\u05E6\u05D0
      \u05E0\u05D9\u05EA\u05DF \u05DC\u05D4\u05DB\u05E0\u05D9\u05E1 \u05DC\u05DB\u05D0\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "\u05DC\u05D7\u05D9\u05E6\u05D4 \u05E2\u05DC M \u05D0\u05D5 D-PAD
      UP \u05EA\u05E6\u05D9\u05D2 \u05D0\u05EA \u05D4\u05DE\u05E4\u05D4 \u05E9\u05DC\u05DA"
