  - m_Id: 9050606470615040
    m_Localized: "\u0627\u0633\u062A\u062E\u062F\u0645 \u0645\u0641\u0627\u062A\u064A\u062D
      WASD \u0644\u0644\u0645\u0634\u064A!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0645\u0633\u0627\u0641\u0629
      \u0644\u0644\u0642\u0641\u0632!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "\u0627\u0642\u0641\u0632 \u062B\u0645 \u0627\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0645\u0633\u0627\u0641\u0629
      \u0645\u0631\u0629 \u0623\u062E\u0631\u0649 \u0644\u0628\u062F\u0621 \u0627\u0644\u0637\u064A\u0631\u0627\u0646!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "\u0647\u0646\u0627\u0643 \u0623\u0646\u0648\u0627\u0639 \u0623\u062E\u0631\u0649
      \u0645\u0646 \u0627\u0644\u062D\u0645\u0627\u0645 \u064A\u062C\u0628 \u0623\u0646
      \u062A\u0630\u0647\u0628 \u0644\u0631\u0624\u064A\u062A\u0647\u0627!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "\u0633\u064A\u064F\u0631\u064A\u0643 \u0643\u0648\u0628\u0631\u062A
      \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u0633\u0644\u0644"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "\u064A\u0645\u0643\u0646 \u0644\u0631\u0627\u0641\u0644 \u0623\u0646
      \u064A\u062E\u0628\u0631\u0643 \u0623\u064A\u0646 \u062A\u062C\u062F \u0627\u0644\u0637\u0639\u0627\u0645"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "\u062A\u0633\u0627\u0628\u0642 \u0645\u0639 \u0623\u0631\u0646\u064A\u0633\u062A\u0648
      \u0644\u0627\u062E\u062A\u0628\u0627\u0631 \u0645\u0647\u0627\u0631\u0627\u062A\u0643!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "\u0641\u064A \u0623\u064A \u0648\u0642\u062A \u062A\u0639\u062A\u0642\u062F
      \u0623\u0646\u0643 \u0645\u0633\u062A\u0639\u062F\u060C \u064A\u0645\u0643\u0646\u0643
      \u0631\u0643\u0648\u0628 \u062D\u0627\u0641\u0644\u0629 \u0643\u0648\u0628\u0631
      \u0625\u0644\u0649 \u0633\u0648\u0642 \u0628\u064A\u062C\u0648\u0646\u062A\u0648\u0646!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "\u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0627\u0644\u062D\u0631\u0641 E \u0623\u0648 X \u0644\u0644\u062A\u0641\u0627\u0639\u0644
      \u0623\u0648 \u0627\u0644\u062A\u062D\u062F\u062B \u0645\u0639 \u0627\u0644\u062D\u0645\u0627\u0645
      \u0627\u0644\u0622\u062E\u0631"
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: "\u0625\u0630\u0627 \u0643\u0646\u062A \u0628\u062D\u0627\u062C\u0629
      \u0625\u0644\u0649 \u0631\u0624\u064A\u0629 \u0639\u0646\u0627\u0635\u0631
      \u0627\u0644\u062A\u062D\u0643\u0645 \u0645\u0631\u0629 \u0623\u062E\u0631\u0649\u060C
      \u064A\u0645\u0643\u0646\u0643 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u064A\u0647\u0627
      \u0641\u064A \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0625\u064A\u0642\u0627\u0641
      \u0627\u0644\u0645\u0624\u0642\u062A!"
    m_Metadata:
      m_Items: []
