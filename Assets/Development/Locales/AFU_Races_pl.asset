  - m_Id: 287992340992000
    m_Localized: "Zaakceptuj nagrod\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 287472998076416
    m_Localized: "Anulowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 287452647313408
    m_Localized: "Zaakceptuj wy\u015Bcig"
    m_Metadata:
      m_Items: []
  - m_Id: 286638046367744
    m_Localized: "Odrzuci\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 286611370594304
    m_Localized: "Pon\xF3w wy\u015Bcig"
    m_Metadata:
      m_Items: []
  - m_Id: 286476381114368
    m_Localized: "Wy\u015Bcig si\u0119 nie uda\u0142!"
    m_Metadata:
      m_Items: []
  - m_Id: 639919640576
    m_Localized: "Ma\u0142e nogi id\u0105 szybko"
    m_Metadata:
      m_Items: []
  - m_Id: 613923344384
    m_Localized: "Ma\u0142y wy\u015Bcig"
    m_Metadata:
      m_Items: []
  - m_Id: 593933291520
    m_Localized: Wojownicy szos!
    m_Metadata:
      m_Items: []
  - m_Id: 570722013184
    m_Localized: Parkuj do parku
    m_Metadata:
      m_Items: []
  - m_Id: 545900122112
    m_Localized: Kto tam jest?
    m_Metadata:
      m_Items: []
  - m_Id: 519308234752
    m_Localized: "Przeja\u017Cd\u017Cka na dachu"
    m_Metadata:
      m_Items: []
  - m_Id: 497732734976
    m_Localized: "Naucz si\u0119 \u015Bciga\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 456293011456
    m_Localized: "Wy\u015Bcig dooko\u0142a parku"
    m_Metadata:
      m_Items: []
  - m_Id: 12828708392849408
    m_Localized: "Zdolno\u015B\u0107 do lotu"
    m_Metadata:
      m_Items: []
  - m_Id: 12828425994555392
