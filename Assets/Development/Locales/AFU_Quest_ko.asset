  m_TableData:
  - m_Id: 12737099546415104
    m_Localized: "\uC4F0\uB808\uAE30\uD1B5\uC744 \uB4A4\uC838 \uAC04\uC2DD\uC744
      \uCC3E\uC544\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737056970035200
    m_Localized: "\uC0C1\uD488\uC744 \uBC1B\uC73C\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737008773287936
    m_Localized: "\uADFC\uCC98\uC5D0 \uC788\uB294 \uC4F0\uB808\uAE30\uB97C \uCC3E\uC544
      \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB9AC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12736899411005440
    m_Localized: "\uB354\uB7EC\uC6B4 \uC778\uAC04\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 12736881279029248
    m_Localized: "\uB54C\uB85C\uB294 \uBA39\uACE0 \uC0B4\uAE30 \uC704\uD574 \uC77C\uD574\uC57C
      \uD560 \uB54C\uB3C4 \uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 12736858042585088
    m_Localized: "\uC4F0\uB808\uAE30\uC778\uAC00... \uC0C8\uC778\uAC00? \uC544\uB2C8\uBA74
      \uADF8\uB0E5 \uBC30\uACE0\uD508 \uAC74\uAC00..."
    m_Metadata:
      m_Items: []
  - m_Id: 12736838291607552
    m_Localized: "\uC74C\uC2DD\uC744 \uC5B4\uB514\uC11C \uAD6C\uD560 \uC218 \uC788\uB294\uC9C0,
      \uADF8\uB9AC\uACE0 \uB4B7\uC815\uB9AC\uB294 \uC5B4\uB5BB\uAC8C \uD558\uB294\uC9C0
      \uBC30\uC6CC\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736818372857856
    m_Localized: "\uC74C\uC2DD\uC744 \uC5B4\uB514\uC11C \uAD6C\uD560 \uC218 \uC788\uB294\uC9C0,
      \uADF8\uB9AC\uACE0 \uB4B7\uC815\uB9AC\uB294 \uC5B4\uB5BB\uAC8C \uD558\uB294\uC9C0
      \uBC30\uC6CC\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736719018184704
    m_Localized: "\uC7AC\uD65C\uC6A9\uD558\uACE0, \uBA39\uACE0, \uBC18\uBCF5\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 12734258014507008
    m_Localized: "\uC7A5\uC2E0\uAD6C\uB97C \uBAA8\uC73C\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 12734229006700544
