%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_sv
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12858535531433984
    m_Localized: AHHHHH!
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\xC5h-- Det \xE4r du! Du m\xE5ste sluta skr\xE4mma fj\xE4drarna
      av mig!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "H\xE5ll n\xE4stan p\xE5 att f\xF6rst\xF6ra mitt g\xF6mst\xE4lle
      ocks\xE5!! De d\xE4r m\xE4nniskorna d\xE4r borta slog av mig fj\xE4derdr\xE4kten!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Visste du att legenden s\xE4ger att vi en g\xE5ng hj\xE4lpte m\xE4nniskor?
      Vi bar post tusentals kilometer \xE5t dem!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Vi var hj\xE4ltar! Himmelsbudb\xE4rare! Sm\xE5 fj\xE4derlika leveranslegender!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "L\xE5ter galet, jag vet. Nu jagar och skriker de mest p\xE5 oss.
      S\xE5\xE5\xE5\xE5 L\xC4SKIGT! M\xE4nniskor \xE4r of\xF6ruts\xE4gbara."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "De tenderar att kasta saker, sparka eller jaga dig om de ser dig.
      S\xE5 n\xE4r du vill vara osynlig ... m\xE5ste du smyga."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "H\xE5ll ner V\xC4NSTER CTRL ELLER V\xC4NSTER ST\xD6TF\xC5NGARE
      och r\xF6r dig l\xE5ngsamt. H\xE5ll dig bakom saker. L\xE5dor. B\xE4nkar. Staket.
      Dekorativa buskar."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "F\xF6r att spurta, h\xE5ll ner V\xC4NSTER SHIFT ELLER L3. Det tar
      dig ur stealth-l\xE4get, s\xE5 var snabb!! Om du ser n\xE5got du vill ha ...
      rycka upp det med F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "K\xE4nner du dig s\xE4ker? Jag beh\xF6ver lite hj\xE4lp. Jag tappade
      den h\xE4r s\xF6ta NYCKELRINGEN inne i TEATREN! Och det \xE4r fullt av m\xE4nniskor!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Om du kan f\xE5 tag p\xE5 den, s\xE5 l\xE5ter jag dig beh\xE5lla
      den! Kanske du hittar n\xE5gon anv\xE4ndning f\xF6r den senare."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "F\xF6rs\xF6k att smyga f\xF6rbi m\xE4nniskorna. Om de ser dig ...
      s\xE5 \xE4r det b\xE4st att du r\xF6r p\xE5 de sm\xE5 f\xF6tterna!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Jaha. Det \xE4r okej. Det \xE4r bra. Jag g\xE5r bara... och h\xE4mtar
      det sj\xE4lv. Det \xE4r bra. Jag gillar att \xF6va. \xD6vning \xE4r s\xE4kert."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Skojar bara. Den h\xE4r \xE4r bara f\xF6r dig. K\xD6R!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "DU KLARADES!!! Du \xE4r den modigaste f\xE5geln jag k\xE4nner.
      Vilket inte \xE4r en h\xF6g ribba men \xE4nd\xE5!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "OMG! HEJ!! Du \xE4r h\xE4r!! Okej okej okej, oroa dig inte, men
      jag hittade de B\xC4STA grejerna!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "Den l\xE5g i en soptunna!! Vilket betyder att den \xE4r premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Okej, typ \u2014 ser du den gl\xE4nsande ut? Eller knaprig? Eller
      vagt matformad? Spring bara \xF6ver och \xE4t! Om du inte kan \xC4TA den, f\xF6rs\xF6k
      att TA GRIPANDE DEN genom att H\xC5LLA IN F- eller X-KNAPPEN."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "JA!! L\xE4gg den i ditt vingf\xF6rr\xE5d! Det \xE4r din skattficka!
      Tryck p\xE5 I ELLER UPP\xC5T P\xC5 RIKTNINGSPLATTAN f\xF6r att se vad du har."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Nu kommer den B\xC4STA delen. Anv\xE4nd V\xC4NSTERKLICK ELLER H\xD6GER
      AVTRYCKARE f\xF6r att bajsa p\xE5 de d\xE4r irriterande m\xE4nniskorna! Och
      H\xD6GERKLICK ELLER V\xC4NSTER AVTRYCKARE f\xF6r att sikta s\xE5 att du sl\xF6sar
      mindre!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "N\xE4r din bajsm\xE4tare b\xF6rjar bli l\xE5g? Du m\xE5ste \xE4ta.
      Sopgodis fyller p\xE5 den igen. Naturen \xE4r VACKER."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Soptunnor \xE4r som mystiska l\xE5dor! Anv\xE4nd E- ELLER X-KNAPPEN
      f\xF6r att interagera! Du vet aldrig vad du f\xE5r!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Kanske pommes frites. Kanske br\xF6d. Kanske n\xE5got som bygger
      karakt\xE4r. Om det skakar, kanske det inte ska bli s\xE5."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Hall\xE5 d\xE4r kompis! \xC4r du redo att l\xE4ra dig n\xE5gra
      sjuka moves?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Slappna av med fj\xE4drarna. Himlen \xE4r kylig. Den ser bara stor
      ut. Okej, ja, den \xE4r massiv. Men det kommer att g\xE5 bra."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Du kan grunderna men vill ha mer! Att flyga snabbt \xE4r enkelt.
      Att flyga coolt? Det \xE4r skicklighet."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Beh\xF6ver du dyka ner snabbt? Anv\xE4nd Q. Kanske en mjukare metod?
      H\xE5ll muspekaren med G eller glid bara ner."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "Nu ska vi se hur du s\xE4tter ihop allt. Leta efter t\xE4vlingsaffischer
      som den p\xE5 den h\xE4r skylten och testa dina vingar! Visa mig vad du kan!"
    m_Metadata:
      m_Items: []
  - m_Id: 47017676951552
    m_Localized: "Hej unge v\xE4n! Du ser ut att vara vilse? Kan du be om lite hj\xE4lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Alla mina flo-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "HUR SOM HELST *Fr\xE5gade inte om hela din livshistoria h\xE4r*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Jag har ett gammalt bo h\xE4r omkring om du vill ha det? Det \xE4r
      en renoveringsl\xF6sning men \xE4nd\xE5... bra."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: Okej
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "J\xC4TTEBRA! Det \xE4r n\xE4ra picknickborden!"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "Ska duvbo se s\xE5 h\xE4r d\xE5liga ut?"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "F\xF6rr i tiden sov vi p\xE5 spikar och var GLADDA. *SK\xD6N* Okej,
      kanske du skulle kunna piffa upp det med n\xE5gra pinnar?"
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "Kolla boet! Kanske jag l\xE4mnade n\xE5gra kvar?"
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "Eftersom du \xE4r ny h\xE4r s\xE5 ska jag ge dig n\xE5gra tips."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Alla k\xE4nner oss f\xF6r att vi bajsar \xF6verallt. Men du m\xE5ste
      fylla tanken f\xF6rst! Det finns s\xE4kert mat h\xE4r omkring."
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "Nu s\xE4ger jag det h\xE4r f\xF6r att jag bryr mig... Men du ser...
      svag ut. Du kommer att bli starkare, men vi beh\xF6ver alla lite hj\xE4lp ibland."
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "F\xF6rs\xF6k att anv\xE4nda det d\xE4r brunnsh\xE5let f\xF6r en
      boost s\xE5 att du har en b\xE4ttre chans att komma upp till toppen av byggnaden.
      Det \xE4r ett bra st\xE4lle att g\xF6mma sig fr\xE5n arga m\xE4nniskor!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: "Hur kom du upp hit s\xE5 snabbt?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "Fort...? Det tog s\xE5 l\xE5ng tid att jag n\xE4stan gick!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "Du vet var du hittar mat. Du vet hur du h\xE5ller dig s\xE4ker.
      Jag har sparat det b\xE4sta till sist!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "Ser du m\xE4nniskorna d\xE4r nere? Vet du vad du ska g\xF6ra! G\xF6r
      mig stolt!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Jag har redan l\xE4rt dig allt jag kan. Dags att g\xE5 och hitta
      n\xE5gra andra f\xE5glar att st\xF6ra!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: HEJ!! HEJ COO!!
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: "K\xE4nner jag dig?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: Nej.
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "MEN har n\xE5gon sagt till dig att du ser PRECIS ut som n\xE5gon
      jag k\xE4nner? Misst\xE4nkt identisk *KISA*"
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "Du M\xC5STE tr\xE4ffa dem!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: "Det d\xE4r...inte till hj\xE4lp. Vem \xE4r det?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Eftersom du \xE4nd\xE5 ska \xE5ka, kan du ta med dem det h\xE4r
      br\xF6det jag \xE4r skyldig dem?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "Kan du inte g\xF6ra det sj\xE4lv? Jag gick inte med p\xE5 det h\xE4r?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: "... Jag klarar mig med lite hj\xE4lp fr\xE5n mina v\xE4nner?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Sj\xE4lvklart g\xF6r du det."
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "Du ser\u2026 bekant ut? Konstigt."
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "Sa Wingo att jag skulle ta med det h\xE4r till dig?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "\xC5h, vilket br\xF6d han \xE4r skyldig. Vilken VILD natt. Tack
      Wingo f\xF6r mig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "\xC5h, jag t\xE4nker inte g\xE5 tillbaka dit. Jag har aldrig tr\xE4ffat
      dem i hela mitt liv ... och de skr\xE4mmer mig lite."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "Vi \xE4r m\xE5nga h\xE4r! Vi duvor har starka gener *blinkar*"
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Du hittar n\xE5gon att prata med ... Jag tr\xE4ffade en f\xE5gel
      h\xE4r f\xF6r inte s\xE5 l\xE4nge sedan! Talade med en konstig accent."
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "\xC5h! Ta det h\xE4r f\xF6r besv\xE4ret. Det \xE4r det minsta jag
      kan g\xF6ra."
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: "JAG S\xC4GER, min gode v\xE4n!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "Du ser ung och pigg ut, tuff nog att skr\xE4mma en katt eller tv\xE5!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "Har du lust att hj\xE4lpa en gammal karl som mig med ett dilemma?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "\xD6h. Jag \xE4r lite upptagen-"
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "UTM\xC4RKT min k\xE4ra f\xE5gel! Tack s\xE5 mycket!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "En flock blandraser har fattat tycke f\xF6r min favoritgr\xE4nd.
      De har det finaste utbudet h\xE4r ni ser\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "Inte f\xF6r m\xF6gligt... men precis tillr\xE4ckligt f\xF6r att
      ge lite smak! Inget annat duger!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "Hur som helst, de d\xE4r rackarna har h\xE5llit mig borta tillr\xE4ckligt
      l\xE4nge."
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "Ge dem en rej\xE4l skv\xE4tt BAJS! DET borde l\xE4ra dem en l\xE4xa!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "\xC5h, jag tror att en ung f\xE5gel ocks\xE5 fastnade d\xE4r. Du
      ser ganska lik henne ut! Ja! Ja, verkligen!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "...men \xE4nnu viktigare - SN\xC4LLA HJ\xC4LP MIG ATT F\xC5 TILLBAKA
      MINA SNACKS!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "Tally Ho k\xE4ra v\xE4n! - Ja. Iv\xE4g nu!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "Du hittade mig!! Jag var S\xC5\xC5\xC5 r\xE4dd!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "Jag hoppades att Arnesto skulle.. komma men jag \xE4r s\xE5 glad
      att se dig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Tack\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "K\xE4nner du igen f\xE5geln d\xE4r borta? Han sprang iv\xE4g n\xE4r
      katterna kom och skrek \"\xC4T HENNE! \xC4T HENNE!\""
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "Pish posh - Nu sticker du! Ut ur min gr\xE4nd!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "Oroa dig inte, jag \xE4r borta..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "Jag ska g\xE5 och vila mina vingar efter en s\xE5 hemsk dag!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "\xC5h! Innan jag g\xE5r, tr\xE4ffade jag den konstigaste gamla
      Kr\xE5kan. Han har en butik h\xE4r n\xE5gonstans! Kanske har han n\xE5got du
      kan byta de d\xE4r prydnadssakerna mot?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Han brukar h\xE4nga i gr\xE4nder men var f\xF6rsiktig med de h\xE4r
      irriterande katterna. Du vill inte tillbringa natten i en container som jag."
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "Jag h\xF6rde att du letar efter prylar?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "Butiken \xE4r st\xE4ngd. Kom tillbaka senare\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ Jag kan se \u2026 Okej, jag ser vad som h\xE4nder. Vad
      beh\xF6ver du?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "En r\xE4ttvis handel, eller hur? Prydnadssaker mot skatter? En
      handling mot en handling."
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "Det h\xE4r st\xE5ndet har blivit mitt f\xE4ngelse. Jag s\xF6ker
      en ROS f\xF6r min sanna k\xE4rlek. Bara de kan f\xE5 mig att k\xE4nna mig FRI!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "Du vet att du bara kan g\xE5, eller hur?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "En resen\xE4r p\xE5 himlen, tyngd av syfte. S\xE4g mig, viskar
      vindar hemligheter till dig som de g\xF6r till mig?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "Jag f\xF6rst\xE5r. V\xE4ldigt poetiskt."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "Ge mig rosen s\xE5 kan du byta med mig. Tills dess har vi st\xE4ngt."
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "Kr\xE5kan hittar varor ... om du har prydnadssaker."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
