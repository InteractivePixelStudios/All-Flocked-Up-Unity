%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12859020745297920
    m_Localized: "Ahora veamos si lo haces bien. Busca carteles de carreras como
      el de este letrero y \xA1pon a prueba tus habilidades! \xA1Demu\xE9strame de
      lo que eres capaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "\xBFNecesitas descender r\xE1pidamente? Usa la tecla Q. \xBFPrefieres
      un enfoque m\xE1s suave? Mantente suspendido en el aire con la tecla G o simplemente
      planea hacia abajo."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Ya conoces lo b\xE1sico, \xA1pero quieres m\xE1s! Volar r\xE1pido
      es f\xE1cil. \xBFVolar con estilo? Eso s\xED que es habilidad."
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Rel\xE1jate. El cielo est\xE1 fresco. Solo parece grande. Bueno,
      s\xED, es enorme. Pero estar\xE1s bien."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "\xA1Hola chico! \xBFEst\xE1s listo para aprender algunos movimientos
      incre\xEDbles?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Tal vez papas fritas. Tal vez pan. Tal vez algo que te fortalezca
      el car\xE1cter. Si se mueve, mejor no."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\xA1Los cubos de basura son como cajas misteriosas! \xA1Usa el
      bot\xF3n E o X para interactuar! \xA1Nunca sabes lo que te tocar\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\xBFCuando te faltan ganas de ir al ba\xF1o? Tienes que comer.
      Los bocadillos de basura te recargan. La naturaleza es HERMOSA."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Ahora viene lo MEJOR. \xA1Usa el clic izquierdo o el gatillo derecho
      para cagar sobre esos molestos humanos! \xA1Y el clic derecho o el gatillo
      izquierdo para apuntar y as\xED desperdiciar menos!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\xA1S\xCD! \xA1Gu\xE1rdalo en tu inventario de alas! \xA1Ese es
      tu bolsillo del tesoro! Presiona I o la cruceta direccional hacia arriba para
      ver qu\xE9 tienes."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Vale, entonces, \xBFves algo brillante? \xBFO crujiente? \xBFO
      con forma de comida? \xA1Corre y c\xF3melo! Si no puedes COMERLO, intenta AGARRARLO
      MANTENIENDO PULSADO EL BOT\xD3N F o X."
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\xA1Estaba en un cubo de basura! Lo que significa que es de primera
      calidad."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\xA1\xA1Dios m\xEDo!! \xA1\xA1Hola!! \xA1Est\xE1s aqu\xED!! Vale,
      vale, vale, no te asustes, \xA1pero encontr\xE9 las MEJORES cosas!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\xA1\xA1\xA1LO LOGRASTE!!! Eres el p\xE1jaro m\xE1s valiente que
      conozco. Lo cual no es decir mucho, \xA1pero aun as\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Es broma. Esta es toda tuya. \xA1Vamos!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Oh. Est\xE1 bien. No hay problema. Ir\xE9... a buscarlo yo mismo.
      Eso est\xE1 bien. Me gusta practicar. Practicar es seguro."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Intenta escabullirte entre los humanos. Si te ven\u2026 \xA1m\xE1s
      te vale mover esos piececitos!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Si logras agarrarlo, \xA1te lo dejo qued\xE1rtelo! Quiz\xE1s le
      encuentres alguna utilidad m\xE1s adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\xBFTe sientes seguro? Necesito ayuda. \xA1Se me cay\xF3 este llavero
      tan chulo dentro del teatro! \xA1Y est\xE1 lleno de gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Para correr, mant\xE9n pulsada la tecla SHIFT IZQUIERDA o L3. Esto
      te sacar\xE1 del modo sigilo, \xA1as\xED que date prisa! Si ves algo que quieres...
      \xA1c\xF3gelo con F!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Mant\xE9n pulsada la tecla CTRL izquierda o el bot\xF3n BUMPER
      izquierdo y mu\xE9vete lentamente. Mantente detr\xE1s de objetos: cajas, bancos,
      vallas, arbustos decorativos."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Suelen lanzar cosas, patearte o perseguirte si te ven. As\xED que
      si quieres ser invisible\u2026 tienes que escabullirte."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Suena descabellado, lo s\xE9. Ahora casi siempre nos persiguen
      y nos gritan. \xA1Qu\xE9 miedo! Los humanos son impredecibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "\xA1\xC9ramos h\xE9roes! \xA1Mensajeros del cielo! \xA1Peque\xF1as
      leyendas de reparto aladas!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "\xBFSab\xEDas que, seg\xFAn la leyenda, una vez ayudamos a los
      humanos? \xA1Les llev\xE1bamos el correo miles de kil\xF3metros!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "\xA1Casi arruinan mi escondite tambi\xE9n! \xA1Esos humanos de
      all\xE1 me quitaron el plumaje!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\xA1Oh, eres t\xFA! \xA1Deja de asustarme tanto!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: "\xA1AHHHHHHH!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: "\xBFTe conozco?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: "\xA1\xA1HEY!! \xA1\xA1HEY COO!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Ya te he ense\xF1ado todo lo que s\xE9. \xA1Es hora de ir a buscar
      otros p\xE1jaros a los que molestar!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "\xBFVes a esos humanos ah\xED abajo? \xA1Ya sabes qu\xE9 hacer!
      \xA1Hazme sentir orgulloso!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "Sabes d\xF3nde encontrar comida. Sabes c\xF3mo mantenerte a salvo.
      \xA1He guardado lo mejor para el final!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "\xBFR\xE1pido...? \xA1Tardaste tanto que casi me voy!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: "\xBFC\xF3mo subiste aqu\xED tan r\xE1pido?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "Intenta usar esa alcantarilla para impulsarte y as\xED tener m\xE1s
      posibilidades de llegar a la cima del edificio. \xA1Es un lugar estupendo para
      esconderse de los humanos enfadados!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "Lo digo porque me importas... Pero te ves... d\xE9bil. Te har\xE1s
      m\xE1s fuerte, pero todos necesitamos ayuda a veces."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Todos nos conocen por defecar por todas partes. \xA1Pero primero
      tienes que llenar el tanque! Seguro que hay comida por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "Como eres nuevo por aqu\xED, d\xE9jame darte algunos consejos."
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "\xA1Revisa el nido! \xBFTal vez dej\xE9 algunos por ah\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "En mis tiempos dorm\xEDamos sobre estacas y \xE9ramos FELICES.
      *SE R\xCDE* Bueno, \xBFquiz\xE1s podr\xEDas decorarlo con unas ramitas?"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "\xBFSe supone que los nidos de palomas deben verse tan... mal?"
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "\xA1GENIAL! \xA1Est\xE1 cerca de las mesas de picnic!"
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: "Est\xE1 bien"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Tengo un nido viejo por aqu\xED, \xBFte interesa? Necesita algunas
      reparaciones, pero a\xFAn as\xED... est\xE1 bien."
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "EN FIN *No te ped\xED que contaras toda tu vida aqu\xED*"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Todo mi flo-
    m_Metadata:
      m_Items: []
  - m_Id: 47017676951552
    m_Localized: "\xA1Hola, joven! \xBFPareces perdido? \xBFNecesitas ayuda?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "El cuervo encuentra mercanc\xEDas... si tienes baratijas."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "Tr\xE1eme la rosa y podr\xE1s negociar conmigo. Hasta entonces,
      estamos cerrados."
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "Lo entiendo. Muy po\xE9tico."
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "Un viajero del cielo, cargado de un prop\xF3sito. Dime, \xBFte
      susurran los vientos secretos como a m\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "Sabes que puedes irte, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "Este puesto se ha convertido en mi prisi\xF3n. Busco una ROSA para
      mi verdadero amor. \xA1Solo ellas pueden hacerme sentir LIBRE!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "Un trato justo, \xBFno? \xBFBaratijas por tesoros? Un trato por
      otro."
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ Puedo ver el\u2026 Vale, ya veo lo que est\xE1 pasando.
      \xBFQu\xE9 necesitas?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "La tienda est\xE1 cerrada. Vuelva m\xE1s tarde\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "\xBFHe o\xEDdo que est\xE1s buscando baratijas?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Suele merodear por callejones, pero ten cuidado con estos gatos
      tan molestos. No querr\xE1s pasar la noche en un contenedor de basura como
      yo."
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "\xA1Oh! Antes de irme, conoc\xED al cuervo m\xE1s extra\xF1o. \xA1Tiene
      una tienda por aqu\xED cerca! \xBFQuiz\xE1s tenga algo que puedas intercambiar
      por esas baratijas?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "\xA1Voy a descansar mis alas despu\xE9s de un d\xEDa tan horrible!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: No te preocupes, ya me fui...
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "\xA1Tonter\xEDas! \xA1L\xE1rgate! \xA1Fuera de mi callej\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "\xBFConoces a ese p\xE1jaro de ah\xED? Sali\xF3 corriendo cuando
      llegaron los gatos gritando \"\xA1C\xD3MELA! \xA1C\xD3MELA!\""
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Gracias\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "Esperaba que Arnesto viniera ... \xA1pero estoy tan contenta de
      verte!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "\xA1Me encontraste! \xA1Estaba MUY asustada!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "\xA1Tally Ho querido amigo! - S\xED. \xA1Adelante!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "...pero lo m\xE1s importante: \xA1POR FAVOR, AY\xDADENME A RECUPERAR
      MIS BOCADILLOS!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "Oh, creo que un pajarito tambi\xE9n se qued\xF3 atrapado ah\xED.
      \xA1Te pareces mucho a ella! \xA1S\xED! \xA1S\xED, en efecto!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "\xA1Dales una buena paliza de MIERDA! \xA1Eso les ense\xF1ar\xE1
      una lecci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: En fin, esos brutos me han mantenido fuera el tiempo suficiente.
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "No est\xE1 demasiado mohoso... \xA1pero lo suficiente para darle
      sabor! \xA1No hay otro igual!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "Una manada de perros callejeros se ha aficionado a mi callej\xF3n
      favorito. Aqu\xED tienen la mejor selecci\xF3n, \xBFsabes?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "\xA1EXCELENTE, mi querido p\xE1jaro! \xA1Much\xEDsimas gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: Uhhh. Estoy un poco ocupado.
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "\xBFPodr\xEDas ayudar a un viejo como yo con un dilema?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "Te ves joven y vivaz, \xA1lo suficientemente fuerte como para asustar
      a un par de gatos!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: "\xA1DIGO, mi buen compa\xF1ero!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "\xA1Oh! Toma esto como compensaci\xF3n por las molestias. Es lo
      m\xEDnimo que puedo hacer."
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Encontrar\xE1s a alguien con quien hablar\u2026 \xA1Hace poco conoc\xED
      a un p\xE1jaro por aqu\xED! Hablaba con un acento extra\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "\xA1Somos muchos por aqu\xED! Las palomas tenemos genes fuertes
      *gui\xF1o*."
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "Oh, no voy a volver all\xED. Nunca los he visto en mi vida... y
      me dan un poco de miedo."
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "\xA1Ah, el pan que debe! \xA1Qu\xE9 noche tan loca! \xA1Dale las
      gracias a Wingo de mi parte!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "\xBFWingo me dijo que te trajera esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "\xBFMe resultas familiar? Extra\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Por supuesto que s\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: ... Me las arreglo con un poco de ayuda de mis amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "\xBFNo puedes hacerlo t\xFA mismo? \xA1Yo no acept\xE9 esto!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Ya que vas a ir de todas formas, \xBFpuedes llevarles el pan que
      les debo?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: "Eso... no ayuda. \xBFQui\xE9n es?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "\xA1NECESITAS conocerlos!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "\xBFPero alguien te ha dicho que te pareces much\xEDsimo a alguien
      que conozco? Sospechosamente id\xE9nticos *entrecierra los ojos*."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
