  - m_Id: 12737099546415104
    m_Localized: "Interagera med soporna f\xF6r att leta efter snacks!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737056970035200
    m_Localized: "H\xE4mta ditt PRIS!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737008773287936
    m_Localized: "Hitta skr\xE4p i n\xE4rheten och sl\xE4ng det i soporna"
    m_Metadata:
      m_Items: []
  - m_Id: 12736899411005440
    m_Localized: "Smutsiga m\xE4nniskor"
    m_Metadata:
      m_Items: []
  - m_Id: 12736881279029248
    m_Localized: "Ibland m\xE5ste man jobba f\xF6r maten"
    m_Metadata:
      m_Items: []
  - m_Id: 12736858042585088
    m_Localized: "Skr\xE4p... F\xE5gel? Eller bara hungrig..."
    m_Metadata:
      m_Items: []
  - m_Id: 12736838291607552
    m_Localized: "L\xE4r dig var du hittar mat och hur du st\xE4dar!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736818372857856
    m_Localized: "L\xE4r dig var du hittar mat och hur du st\xE4dar!"
    m_Metadata:
      m_Items: []
