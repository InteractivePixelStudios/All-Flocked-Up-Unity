  - m_Id: 478567350587392
    m_Localized: Schiene
    m_Metadata:
      m_Items: []
  - m_Id: 12733910025687040
    m_Localized: "Heimt\xFCckischer Schnabel"
    m_Metadata:
      m_Items: []
  - m_Id: 12734028586078208
    m_Localized: Lerne, listig zu sein
    m_Metadata:
      m_Items: []
  - m_Id: 12734078028533760
    m_Localized: Schleich dich ins Theater, um Coobert zu sehen
    m_Metadata:
      m_Items: []
  - m_Id: 12734130943873024
    m_Localized: Sich ins Theater schleichen
    m_Metadata:
      m_Items: []
  - m_Id: 12734174208118784
    m_Localized: Coobert hat im Theater ein paar Kleinigkeiten gesehen... Vielleicht
      kannst du sie dir ja selbst mitnehmen?
    m_Metadata:
      m_Items: []
  - m_Id: 12734229006700544
    m_Localized: "Sammle die Schmuckst\xFCcke"
    m_Metadata:
      m_Items: []
  - m_Id: 12734258014507008
    m_Localized: "Sammle die Schmuckst\xFCcke"
    m_Metadata:
      m_Items: []
  - m_Id: 12736719018184704
    m_Localized: Recyceln, essen, wiederholen
    m_Metadata:
      m_Items: []
  - m_Id: 12736818372857856
    m_Localized: Lerne, wo du Nahrung findest und wie du sie beseitigen kannst!
    m_Metadata:
      m_Items: []
  - m_Id: 12736838291607552
    m_Localized: Lerne, wo du Nahrung findest und wie du sie beseitigen kannst!
    m_Metadata:
      m_Items: []
  - m_Id: 12736858042585088
    m_Localized: "M\xFCll...Vogel? Oder einfach nur hungrig..."
    m_Metadata:
      m_Items: []
  - m_Id: 12736881279029248
    m_Localized: "Manchmal muss man f\xFCr Essen arbeiten."
    m_Metadata:
      m_Items: []
  - m_Id: 12736899411005440
    m_Localized: Schmutzige Menschen
    m_Metadata:
      m_Items: []
  - m_Id: 12737008773287936
    m_Localized: "Suche M\xFCll in der N\xE4he und wirf ihn in den M\xFClleimer."
    m_Metadata:
      m_Items: []
  - m_Id: 12737056970035200
    m_Localized: Sichern Sie sich Ihren PREIS!
    m_Metadata:
      m_Items: []
  - m_Id: 12737099546415104
    m_Localized: "Durchsuche den M\xFCll nach Snacks!"
    m_Metadata:
      m_Items: []
