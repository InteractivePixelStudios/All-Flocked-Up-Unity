  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: Se hai bisogno di rivedere i comandi, li trovi nel menu PAUSA!
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "\xC8 possibile utilizzare i tasti E o X per interagire o parlare
      con altri piccioni."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: Quando ti sentirai pronto, potrai prendere il Coober per raggiungere
      il mercato di Pigeonton!
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "Gareggia contro Arnesto e metti alla prova le tue abilit\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle pu\xF2 dirti dove trovare il cibo"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "Coobert ti mostrer\xE0 come intrufolarsi"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Ci sono altri piccioni che dovreste andare a vedere!
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: Salta e poi premi di nuovo la barra spaziatrice per iniziare a volare!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Premi la barra spaziatrice per saltare!
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: WASD per camminare!
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "Pip\xEC, amico mio pennuto... Hai ancora tanto da imparare!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "Vedete la vostra faccia l\xEC? Un uccello in salute \xE8 importante,
      quindi assicuratevi di avere sempre un aspetto impeccabile!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "Quella barra VERDE? La resistenza ti aiuta a CORRERE e SBATTERRA
      per uscire dal pericolo. O per entrarci... La scelta \xE8 tua..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: Il BIANCO? Cosa sappiamo fare meglio? La CACCA! Assicurati di tenere
      la pancia piena!
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: Tenete sempre d'occhio la vostra MINI-MAPPA e la BUSSOLA!
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "Il pulsante I o SELECT aprir\xE0 il tuo WINGVENTORY. Tutti gli
      OGGETTI o ACCESSORI che trovi possono essere inseriti qui."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "Premendo M o D-PAD SU verr\xE0 visualizzata la mappa"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
