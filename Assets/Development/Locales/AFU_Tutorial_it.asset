  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: Se hai bisogno di rivedere i comandi, li trovi nel menu PAUSA!
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "\xC8 possibile utilizzare i tasti E o X per interagire o parlare
      con altri piccioni."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: Quando ti sentirai pronto, potrai prendere il Coober per raggiungere
      il mercato di Pigeonton!
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "Gareggia contro Arnesto e metti alla prova le tue abilit\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle pu\xF2 dirti dove trovare il cibo"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "Coobert ti mostrer\xE0 come intrufolarsi"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Ci sono altri piccioni che dovreste andare a vedere!
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: Salta e poi premi di nuovo la barra spaziatrice per iniziare a volare!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Premi la barra spaziatrice per saltare!
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: WASD per camminare!
    m_Metadata:
      m_Items: []
  references:
