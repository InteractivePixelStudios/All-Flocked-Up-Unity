  m_TableData:
  - m_Id: 12858535531433984
    m_Localized: "\u0410\u0410\u0410\u0410\u0410\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\u041E\u0439, \u044D\u0442\u043E \u0442\u044B! \u041F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C
      \u0441\u0434\u0438\u0440\u0430\u0442\u044C \u0441 \u043C\u0435\u043D\u044F
      \u043F\u0435\u0440\u044C\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "\u041E\u043D\u0438 \u0447\u0443\u0442\u044C \u043D\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0438
      \u0438 \u043C\u043E\u0435 \u0443\u043A\u0440\u044B\u0442\u0438\u0435!! \u042D\u0442\u0438
      \u043B\u044E\u0434\u0438 \u0442\u0430\u043C \u0441\u0431\u0438\u043B\u0438
      \u0441 \u043C\u0435\u043D\u044F \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "\u0410 \u0432\u044B \u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E,
      \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043B\u0435\u0433\u0435\u043D\u0434\u0435,
      \u043C\u044B \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0438
      \u043B\u044E\u0434\u044F\u043C? \u0414\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0438
      \u0438\u043C \u043F\u043E\u0447\u0442\u0443 \u043D\u0430 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "\u041C\u044B \u0431\u044B\u043B\u0438 \u0433\u0435\u0440\u043E\u044F\u043C\u0438!
      \u041D\u0435\u0431\u0435\u0441\u043D\u044B\u043C\u0438 \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438!
      \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C\u0438 \u043F\u0435\u0440\u043D\u0430\u0442\u044B\u043C\u0438
      \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u043C\u0438-\u043A\u0443\u0440\u044C\u0435\u0440\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0431\u0435\u0437\u0443\u043C\u043D\u043E,
      \u044F \u0437\u043D\u0430\u044E. \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0438
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u043E
      \u0433\u043E\u043D\u044F\u044E\u0442\u0441\u044F \u0437\u0430 \u043D\u0430\u043C\u0438
      \u0438 \u043A\u0440\u0438\u0447\u0430\u0442. \u0423\u0436\u0430\u0441\u043D\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E! \u041B\u044E\u0434\u0438 \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "\u041E\u043D\u0438 \u0441\u043A\u043B\u043E\u043D\u043D\u044B \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u043F\u0438\u043D\u0430\u0442\u044C
      \u0438\u043B\u0438 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0441, \u0435\u0441\u043B\u0438 \u0437\u0430\u043C\u0435\u0442\u044F\u0442.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443, \u0435\u0441\u043B\u0438 \u0432\u044B
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u0442\u0430\u0442\u044C \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u043C\u2026
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u043A\u0440\u0430\u0441\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043B\u0435\u0432\u0443\u044E \u043A\u043B\u0430\u0432\u0438\u0448\u0443 CTRL
      \u0438\u043B\u0438 \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u0431\u0430\u043C\u043F\u0435\u0440\u0430 \u0438 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.
      \u041A\u043E\u0440\u043E\u0431\u043E\u043A. \u0421\u043A\u0430\u043C\u0435\u0435\u043A.
      \u0417\u0430\u0431\u043E\u0440\u043E\u0432. \u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
      \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u0431\u0435\u0436\u0430\u0442\u044C,
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043B\u0435\u0432\u0443\u044E
      \u043A\u043B\u0430\u0432\u0438\u0448\u0443 SHIFT \u0438\u043B\u0438 L3. \u042D\u0442\u043E
      \u0432\u044B\u0432\u0435\u0434\u0435\u0442 \u0432\u0430\u0441 \u0438\u0437
      \u0440\u0435\u0436\u0438\u043C\u0430 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
      \u0431\u044B\u0441\u0442\u0440\u043E! \u0415\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0442\u0435
      \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E\u2026
      \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u044D\u0442\u043E \u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439
      F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0441\u0435\u0431\u044F
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E? \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430
      \u043F\u043E\u043C\u043E\u0449\u044C. \u042F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430\u2026
      \u0448\u043B\u044F\u043F\u0443\u2026 \u0432 \u0442\u0435\u0430\u0442\u0440\u0435!
      \u0410 \u0442\u0430\u043C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
      \u044D\u0442\u043E \u043C\u043E\u0439 \u043D\u043E\u0447\u043D\u0438\u043A.
      \u0411\u0430\u043D\u043A\u0430 \u0441\u043E \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u0430\u043C\u0438.
      \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E
      \u0443\u0441\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "\u0422\u044B \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0435\u0448\u044C?!
      \u041E, \u0441\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0443. \u041B\u0430\u0434\u043D\u043E,
      \u043B\u0430\u0434\u043D\u043E. \u041F\u0440\u043E\u043A\u0440\u0430\u0434\u0438\u0441\u044C
      \u043C\u0438\u043C\u043E \u043B\u044E\u0434\u0435\u0439. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0443\u043A\u0440\u044B\u0442\u0438\u044F. \u0415\u0441\u043B\u0438 \u043E\u043D\u0438
      \u0442\u0435\u0431\u044F \u0443\u0432\u0438\u0434\u044F\u0442\u2026 \u043B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0448\u0435\u0432\u0435\u043B\u0438 \u0441\u0432\u043E\u0438\u043C\u0438
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C\u0438 \u043D\u043E\u0436\u043A\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\u041E\u0445. \u200B\u200B\u0412\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435.
      \u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
      \u042F \u043F\u0440\u043E\u0441\u0442\u043E\u2026 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0443\u0434\u0443
      \u0441\u043F\u0430\u0442\u044C. \u041C\u044B \u043C\u043E\u0436\u0435\u043C
      \u043F\u043E\u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u0438. \u042D\u0442\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
      \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\u0428\u0443\u0447\u0443, \u043C\u043D\u0435 \u041D\u0423\u0416\u0415\u041D
      \u043D\u043E\u0447\u043D\u0438\u043A. \u041F\u0420\u042F\u041C\u041E \u0421\u0415\u0419\u0427\u0410\u0421!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\u0422\u044B \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0430!!!
      \u0422\u044B \u0441\u0430\u043C\u0430\u044F \u0441\u043C\u0435\u043B\u0430\u044F
      \u043F\u0442\u0438\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0437\u043D\u0430\u044E. \u042D\u0442\u043E \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u043F\u043B\u0430\u043D\u043A\u0430, \u043D\u043E \u0432\u0441\u0451 \u0436\u0435!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\u041E \u0431\u043E\u0436\u0435! \u041F\u0440\u0438\u0432\u0435\u0442!!
      \u0422\u044B \u0437\u0434\u0435\u0441\u044C!! \u041B\u0430\u0434\u043D\u043E,
      \u043B\u0430\u0434\u043D\u043E, \u043B\u0430\u0434\u043D\u043E, \u043D\u0435
      \u043F\u0430\u043D\u0438\u043A\u0443\u0439, \u043D\u043E \u044F \u043D\u0430\u0448\u043B\u0430
      \u0421\u0410\u041C\u042B\u0415 \u041B\u0423\u0427\u0428\u0418\u0415 \u0432\u0435\u0449\u0438!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\u041E\u043D\u043E \u043B\u0435\u0436\u0430\u043B\u043E \u0432
      \u043C\u0443\u0441\u043E\u0440\u043D\u043E\u043C \u0432\u0435\u0434\u0440\u0435!
      \u0410 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u043F\u0440\u0435\u043C\u0438\u0443\u043C-\u043A\u043B\u0430\u0441\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "\u0418\u0442\u0430\u043A, \u0432\u0438\u0434\u0438\u0442\u0435
      \u0447\u0442\u043E-\u0442\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0435?
      \u0418\u043B\u0438 \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0435\u0435?
      \u0418\u043B\u0438 \u043F\u043E\u0445\u043E\u0436\u0435\u0435 \u043D\u0430
      \u0435\u0434\u0443? \u041C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u044C!
      \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      F \u0438\u043B\u0438 Y, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\u0414\u0410!! \u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435
      \u044D\u0442\u043E \u0432 \u0441\u0432\u043E\u0439 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C
      \u043D\u0430 \u043A\u0440\u044B\u043B\u044C\u044F\u0445! \u042D\u0442\u043E
      \u0432\u0430\u0448 \u043A\u0430\u0440\u043C\u0430\u043D \u0441 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\u043C\u0438!
      \u041D\u0430\u0436\u043C\u0438\u0442\u0435 I \u0418\u041B\u0418 \u041A\u041D\u041E\u041F\u041A\u0423
      \u041D\u0410\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u042F \u0412\u0412\u0415\u0420\u0425,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u0447\u0442\u043E \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0430\u043C\u043E\u0435
      \u0412\u0410\u0416\u041D\u041E\u0415. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u041B\u0415\u0412\u0423\u042E \u041A\u041D\u041E\u041F\u041A\u0423 \u0418\u041B\u0418
      \u041F\u0420\u0410\u0412\u042B\u0419 \u041A\u0423\u0420\u041E\u041A, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0433\u0430\u0434\u0438\u0442\u044C \u043D\u0430 \u044D\u0442\u0438\u0445
      \u043D\u0430\u0434\u043E\u0435\u0434\u043B\u0438\u0432\u044B\u0445 \u043B\u044E\u0434\u0435\u0439!
      \u0418 \u041F\u0420\u0410\u0412\u0423\u042E \u041A\u041D\u041E\u041F\u041A\u0423
      \u0418\u041B\u0418 \u041B\u0415\u0412\u042B\u0419 \u041A\u0423\u0420\u041E\u041A
      \u0434\u043B\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0441\u0442\u0443\u043B\u0430 \u043F\u0430\u0434\u0430\u0435\u0442? \u041D\u0443\u0436\u043D\u043E
      \u043F\u043E\u0435\u0441\u0442\u044C. \u041F\u0435\u0440\u0435\u043A\u0443\u0441\u044B
      \u0438\u0437 \u043C\u0443\u0441\u043E\u0440\u0430 \u0432\u043E\u0441\u043F\u043E\u043B\u043D\u044F\u044E\u0442
      \u0435\u0433\u043E. \u041F\u0440\u0438\u0440\u043E\u0434\u0430 \u041F\u0420\u0415\u041A\u0420\u0410\u0421\u041D\u0410."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\u041C\u0443\u0441\u043E\u0440\u043D\u044B\u0435 \u0431\u0430\u043A\u0438
      \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0438-\u0441\u044E\u0440\u043F\u0440\u0438\u0437\u044B!
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0438
      E \u0438\u043B\u0438 X \u0434\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F!
      \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0430
      \u0444\u0440\u0438. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
      \u0445\u043B\u0435\u0431. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
      \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E \u0437\u0430\u043A\u0430\u043B\u044F\u0435\u0442
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440. \u0415\u0441\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F,
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043B\u0443\u0447\u0448\u0435
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u0430\u043B\u044B\u0448!!
      \u0413\u043E\u0442\u043E\u0432 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u043A\u0440\u0443\u0442\u044B\u043C \u0442\u0440\u044E\u043A\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "\u0420\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0441\u044F. \u041D\u0435\u0431\u043E
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0435. \u041E\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C.
      \u0414\u0430, \u043E\u043D\u043E \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435.
      \u041D\u043E \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0447\u0443\u0432\u0430\u043A.
      \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u043E\u0441\u043D\u043E\u0432\u044B,
      \u043D\u043E \u0445\u043E\u0447\u0435\u0448\u044C \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E!
      \u041F\u0435\u0440\u0432\u043E\u0435, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C? \u0412\u0437\u043B\u0435\u0442\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043B\u0430\u0432\u0438\u0448\u0438 WASD \u0438\u043B\u0438 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043D\u0430\u0443\u0447\u0438\u043B\u0430 Birdadette, \u0447\u0442\u043E\u0431\u044B
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u043B\u0435\u0442\u0430. \u041D\u0435 \u0431\u043E\u0440\u0438\u0442\u0435\u0441\u044C
      \u0441 \u0432\u0435\u0442\u0440\u043E\u043C \u2014 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      \u0432 \u0435\u0433\u043E \u0440\u0438\u0442\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0435\u0442\u043E\u043C
      \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
      \u0432\u043D\u0438\u0437. \u0411\u044B\u0441\u0442\u0440\u043E \u043B\u0435\u0442\u0430\u0442\u044C
      \u043B\u0435\u0433\u043A\u043E. \u041A\u0440\u0443\u0442\u043E \u043B\u0435\u0442\u0430\u0442\u044C?
      \u042D\u0442\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
