  - m_Id: 22288820656328704
    m_Localized: "\u0412\u0438\u0434\u0438\u0442\u0435 \u0442\u0435\u0445 \u043B\u044E\u0434\u0435\u0439
      \u0432\u043D\u0438\u0437\u0443? \u0412\u044B \u0437\u043D\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C! \u0417\u0430\u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u043C\u0435\u043D\u044F \u0433\u043E\u0440\u0434\u0438\u0442\u044C\u0441\u044F
      \u0432\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "\u042F \u0443\u0436\u0435 \u0432\u0441\u0435\u043C\u0443 \u0442\u0435\u0431\u044F
      \u043D\u0430\u0443\u0447\u0438\u043B. \u041F\u043E\u0440\u0430 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u0442\u0438\u0446, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: "\u042D\u0419!! \u042D\u0419 \u041A\u0423!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: "\u042F \u0442\u0435\u0431\u044F \u0437\u043D\u0430\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: "\u041D\u0435\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "\u041D\u043E \u0432\u0430\u043C \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u0432\u044B
      \u0422\u041E\u0427\u041D\u041E \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430
      \u043A\u043E\u0433\u043E-\u0442\u043E \u0438\u0437 \u043C\u043E\u0438\u0445
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445? \u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u044B *\u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F*."
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "\u0412\u0430\u043C \u041E\u0411\u042F\u0417\u0410\u0422\u0415\u041B\u042C\u041D\u041E
      \u043D\u0443\u0436\u043D\u043E \u0441 \u043D\u0438\u043C\u0438 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: "\u042D\u0442\u043E... \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E.
      \u041A\u0442\u043E \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "\u0420\u0430\u0437 \u0443\u0436 \u0442\u044B \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
      \u0438\u0434\u0442\u0438, \u043D\u0435 \u043C\u043E\u0433 \u0431\u044B \u0442\u044B
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0438\u043C \u0442\u043E\u0442
      \u0445\u043B\u0435\u0431, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u044F
      \u0438\u043C \u0434\u043E\u043B\u0436\u0435\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "\u0412\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u044D\u0442\u043E \u0441\u0430\u043C\u0438?
      \u042F \u043D\u0430 \u044D\u0442\u043E \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u043B\u0441\u044F?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: "...\u041C\u043D\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0434\u0440\u0443\u0437\u044C\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0432\u044B \u0442\u0430\u043A
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "\u0412\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442\u0435\u2026
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E? \u0421\u0442\u0440\u0430\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "\u0412\u0438\u043D\u0433\u043E \u0432\u0435\u043B\u0435\u043B \u043C\u043D\u0435
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u044D\u0442\u043E \u0442\u0435\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "\u0410\u0445, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0436\u0435
      \u0445\u043B\u0435\u0431\u0430 \u043E\u043D \u0435\u043C\u0443 \u0434\u043E\u043B\u0436\u0435\u043D!
      \u041A\u0430\u043A\u0430\u044F \u0411\u0415\u0417\u0423\u041C\u041D\u0410\u042F
      \u043D\u043E\u0447\u044C! \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0412\u0438\u043D\u0433\u043E
      \u0437\u0430 \u043C\u0435\u043D\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "\u041E, \u044F \u0442\u0443\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u043E\u0439\u0434\u0443. \u042F \u0438\u0445 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u0432 \u0436\u0438\u0437\u043D\u0438 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0430\u2026
      \u0438 \u043E\u043D\u0438 \u043C\u0435\u043D\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u0443\u0433\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "\u041D\u0430\u0441 \u0432\u043E\u043A\u0440\u0443\u0433 \u043E\u0447\u0435\u043D\u044C
      \u043C\u043D\u043E\u0433\u043E! \u0423 \u043D\u0430\u0441, \u0433\u043E\u043B\u0443\u0431\u0435\u0439,
      \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0433\u0435\u043D\u044B
      *\u043F\u043E\u0434\u043C\u0438\u0433\u0438\u0432\u0430\u0435\u0442*."
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "\u0422\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0439\u0434\u0435\u0448\u044C, \u0441 \u043A\u0435\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u2026
      \u042F \u0442\u0443\u0442 \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
      \u043F\u0442\u0438\u0446\u0443! \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
      \u0441\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "\u041E! \u0412\u043E\u0437\u044C\u043C\u0438 \u044D\u0442\u043E
      \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438.
      \u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435\u0435,
      \u0447\u0442\u043E \u044F \u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: "\u042F \u0433\u043E\u0432\u043E\u0440\u044E, \u043C\u043E\u0439
      \u0434\u043E\u0431\u0440\u044B\u0439 \u0434\u0440\u0443\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "\u0412\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442\u0435
      \u043C\u043E\u043B\u043E\u0434\u043E \u0438 \u0431\u043E\u0434\u0440\u043E,
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043A\u0440\u0443\u0442\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u0443\u0433\u0430\u0442\u044C
      \u043F\u0430\u0440\u0443 \u043A\u043E\u0448\u0435\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B
      \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0430\u043A\u043E\u043C\u0443 \u043F\u043E\u0436\u0438\u043B\u043E\u043C\u0443
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u043A\u0430\u043A \u044F,
      \u0441 \u043E\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "\u042D\u044D\u044D... \u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0437\u0430\u043D\u044F\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u043C\u043E\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430\u044F \u043F\u0442\u0438\u0447\u043A\u0430!
      \u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "\u0421\u0442\u0430\u044F \u0434\u0432\u043E\u0440\u043D\u044F\u0433
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043B\u0430\u0441\u044C \u043A \u043C\u043E\u0435\u043C\u0443
      \u043B\u044E\u0431\u0438\u043C\u043E\u043C\u0443 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0443.
      \u0412\u0438\u0434\u0438\u0442\u0435 \u043B\u0438, \u0437\u0434\u0435\u0441\u044C
      \u0441\u0430\u043C\u044B\u0439 \u043B\u0443\u0447\u0448\u0438\u0439 \u0432\u044B\u0431\u043E\u0440..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "\u041D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043B\u0435\u0441\u043D\u0435\u0432\u0435\u0435\u0442...
      \u043D\u043E \u0440\u043E\u0432\u043D\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u043A\u0443\u0441\u0430!
      \u041D\u0438\u0447\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u043D\u0435 \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "\u0412 \u043E\u0431\u0449\u0435\u043C, \u044D\u0442\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044F\u043A\u0438
      \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u0434\u0430\u0432\u0430\u043B\u0438
      \u043C\u043D\u0435 \u043F\u043E\u043A\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0435\u043D\u044C\u043A\u043E \u0438\u0445
      \u043E\u0442\u0448\u043B\u0451\u043F\u0430\u0439\u0442\u0435 \u043A\u0430\u043A\u0430\u0448\u043A\u0430\u043C\u0438!
      \u0412\u043E\u0442 \u044D\u0442\u043E \u0438\u043C \u0443\u0440\u043E\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "\u041E, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0442\u0430\u043C \u0435\u0449\u0451 \u0438 \u043F\u0442\u0435\u043D\u0447\u0438\u043A
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B. \u0422\u044B \u043E\u0447\u0435\u043D\u044C
      \u043D\u0430 \u043D\u0435\u0451 \u043F\u043E\u0445\u043E\u0436\u0430! \u0414\u0430!
      \u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "...\u043D\u043E \u0447\u0442\u043E \u0435\u0449\u0435 \u0432\u0430\u0436\u043D\u0435\u0435
      \u2014 \u041F\u041E\u0416\u0410\u041B\u0423\u0419\u0421\u0422\u0410, \u041F\u041E\u041C\u041E\u0413\u0418\u0422\u0415
      \u041C\u041D\u0415 \u0412\u0415\u0420\u041D\u0423\u0422\u042C \u041C\u041E\u0418
      \u0417\u0410\u041A\u0423\u0421\u041A\u0418!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "\u0422\u0430\u043B\u043B\u0438 \u0425\u043E, \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u0434\u0440\u0443\u0433! \u2014 \u0414\u0430. \u0412\u043F\u0435\u0440\u0451\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "\u0412\u044B \u043C\u0435\u043D\u044F \u043D\u0430\u0448\u043B\u0438!!
      \u042F \u0431\u044B\u043B\u0430 \u0422\u0410\u041A \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "\u042F \u043D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C,
      \u0447\u0442\u043E \u0410\u0440\u043D\u0435\u0441\u0442\u043E \u043F\u0440\u0438\u0434\u0435\u0442,
      \u043D\u043E \u044F \u0442\u0430\u043A \u0440\u0430\u0434\u0430 \u0442\u0435\u0431\u044F
      \u0432\u0438\u0434\u0435\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "\u0417\u043D\u0430\u0435\u0442\u0435 \u0442\u0443 \u043F\u0442\u0438\u0446\u0443
      \u0432\u043E\u043D \u0442\u0430\u043C? \u041E\u043D\u0430 \u0443\u0431\u0435\u0436\u0430\u043B\u0430,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0431\u0435\u0436\u0430\u043B\u0438
      \u043A\u043E\u0448\u043A\u0438 \u0441 \u043A\u0440\u0438\u043A\u0430\u043C\u0438:
      \xAB\u0421\u042A\u0415\u0428\u042C\u0422\u0415 \u0415\u0401! \u0421\u042A\u0415\u0428\u042C\u0422\u0415
      \u0415\u0401!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "\u0414\u0430 \u043D\u0443 \u043D\u0430\u0444\u0438\u0433! \u0410
      \u0442\u0435\u043F\u0435\u0440\u044C \u0438\u0434\u0438 \u043E\u0442\u0441\u044E\u0434\u0430!
      \u041F\u0440\u043E\u0447\u044C \u0438\u0437 \u043C\u043E\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C,
      \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
      \u0443\u0436\u0430\u0441\u043D\u043E\u0433\u043E \u0434\u043D\u044F \u044F
      \u043F\u043E\u0439\u0434\u0443 \u043E\u0442\u0434\u043E\u0445\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "\u041E! \u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
      \u0443\u0439\u0442\u0438, \u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u0430
      \u0412\u043E\u0440\u043E\u043D\u0430. \u0423 \u043D\u0435\u0433\u043E \u0433\u0434\u0435-\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u043B\u0430\u0432\u043A\u0430!
      \u041C\u043E\u0436\u0435\u0442, \u0443 \u043D\u0435\u0433\u043E \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C, \u043D\u0430 \u0447\u0442\u043E
      \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C
      \u044D\u0442\u0438 \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u043E \u043E\u043D \u043E\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430\u0445, \u043D\u043E
      \u0431\u0443\u0434\u044C\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B
      \u0441 \u044D\u0442\u0438\u043C\u0438 \u043D\u0430\u0434\u043E\u0435\u0434\u043B\u0438\u0432\u044B\u043C\u0438
      \u043A\u043E\u0442\u0430\u043C\u0438. \u0412\u0430\u043C \u0436\u0435 \u043D\u0435
      \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043D\u043E\u0447\u044C \u0432 \u043C\u0443\u0441\u043E\u0440\u043D\u043E\u043C
      \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0435, \u043A\u0430\u043A
      \u043C\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0432\u044B \u0438\u0449\u0435\u0442\u0435
      \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0437\u0430\u043A\u0440\u044B\u0442.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u043E\u0437\u0436\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ \u042F \u0432\u0438\u0436\u0443\u2026 \u0425\u043E\u0440\u043E\u0448\u043E,
      \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442.
      \u0427\u0442\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D, \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430
      \u043B\u0438? \u0411\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438
      \u043D\u0430 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430? \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u0437\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A
      \u0441\u0442\u0430\u043B \u043C\u043E\u0435\u0439 \u0442\u044E\u0440\u044C\u043C\u043E\u0439.
      \u042F \u0438\u0449\u0443 \u0440\u043E\u0437\u0443 \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u043B\u044E\u0431\u0432\u0438.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442
      \u043F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u043C\u043D\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "\u0422\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0439\u0442\u0438, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A
      \u043F\u043E \u043D\u0435\u0431\u0443, \u043E\u0431\u0440\u0435\u043C\u0435\u043D\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C.
      \u0421\u043A\u0430\u0436\u0438 \u043C\u043D\u0435, \u0448\u0435\u043F\u0447\u0443\u0442
      \u043B\u0438 \u0442\u0435\u0431\u0435 \u0432\u0435\u0442\u0440\u044B \u0442\u0430\u0439\u043D\u044B
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u043C\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "\u042F \u043F\u043E\u043D\u044F\u043B. \u041E\u0447\u0435\u043D\u044C
      \u043F\u043E\u044D\u0442\u0438\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0438\u0442\u0435 \u043C\u043D\u0435
      \u0440\u043E\u0437\u0443, \u0438 \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F.
      \u0414\u043E \u0442\u0435\u0445 \u043F\u043E\u0440 \u043C\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "\u0412\u043E\u0440\u043E\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u0442\u043E\u0432\u0430\u0440\u044B\u2026 \u0435\u0441\u043B\u0438 \u0443
      \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
