  m_TableData:
  - m_Id: 12859020745297920
    m_Localized: "\u0627\u0631\u0641\u0639 \u0625\u0635\u0628\u0639\u0643 \u0639\u0646
      \u0632\u0631 \u0627\u0644\u0637\u064A\u0631\u0627\u0646\u060C \u0648\u0627\u0646\u0632\u0644\u0642
      \u0644\u0644\u0623\u0633\u0641\u0644. \u0627\u0644\u0637\u064A\u0631\u0627\u0646
      \u0628\u0633\u0631\u0639\u0629 \u0623\u0645\u0631 \u0633\u0647\u0644. \u0623\u0645\u0627
      \u0627\u0644\u0637\u064A\u0631\u0627\u0646 \u0628\u0631\u0634\u0627\u0642\u0629\u061F
      \u0641\u0647\u0630\u0647 \u0645\u0647\u0627\u0631\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "\u0627\u0633\u062A\u062E\u062F\u0645 \u0645\u0641\u0627\u062A\u064A\u062D
      WASD \u0623\u0648 \u0639\u0635\u0627 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u064A\u0645\u0646\u0649
      \u0627\u0644\u062A\u064A \u0639\u0644\u0645\u062A\u0643 \u0625\u064A\u0627\u0647\u0627
      \u0628\u064A\u0631\u062F\u0627\u062F\u064A\u062A \u0644\u0644\u062A\u062D\u0643\u0645
      \u0641\u064A \u0648\u062C\u0647\u062A\u0643 \u0623\u062B\u0646\u0627\u0621
      \u0627\u0644\u0637\u064A\u0631\u0627\u0646. \u0644\u0627 \u062A\u0642\u0627\u0648\u0645
      \u0627\u0644\u0631\u064A\u0627\u062D\u060C \u0628\u0644 \u0627\u0646\u0633\u062C\u0645
      \u0645\u0639\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "\u062D\u0633\u0646\u0627\u064B \u064A\u0627 \u0631\u062C\u0644.
      \u0623\u0646\u062A \u062A\u0639\u0631\u0641 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0627\u062A
      \u0644\u0643\u0646\u0643 \u062A\u0631\u064A\u062F \u0627\u0644\u0645\u0632\u064A\u062F!
      \u0623\u0648\u0644 \u0634\u064A\u0621\u061F \u0627\u0646\u0637\u0644\u0642."
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "\u0627\u0633\u062A\u0631\u062E\u0650. \u0627\u0644\u0633\u0645\u0627\u0621
      \u0628\u0627\u0631\u062F\u0629. \u062A\u0628\u062F\u0648 \u0643\u0628\u064A\u0631\u0629
      \u0641\u0642\u0637. \u062D\u0633\u0646\u0627\u064B\u060C \u0646\u0639\u0645
      \u0625\u0646\u0647\u0627 \u0636\u062E\u0645\u0629. \u0644\u0643\u0646\u0643
      \u0633\u062A\u0643\u0648\u0646 \u0628\u062E\u064A\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "\u0645\u0631\u062D\u0628\u0627\u064B \u0623\u064A\u0647\u0627 \u0627\u0644\u0635\u063A\u064A\u0631!
      \u0647\u0644 \u0623\u0646\u062A \u0645\u0633\u062A\u0639\u062F \u0644\u062A\u0639\u0644\u0645
      \u0628\u0639\u0636 \u0627\u0644\u062D\u0631\u0643\u0627\u062A \u0627\u0644\u0631\u0627\u0626\u0639\u0629\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "\u0631\u0628\u0645\u0627 \u0628\u0637\u0627\u0637\u0633 \u0645\u0642\u0644\u064A\u0629.
      \u0631\u0628\u0645\u0627 \u062E\u0628\u0632. \u0631\u0628\u0645\u0627 \u0634\u064A\u0621
      \u064A\u0628\u0646\u064A \u0627\u0644\u0634\u062E\u0635\u064A\u0629. \u0625\u0630\u0627
      \u0643\u0627\u0646 \u0627\u0644\u0634\u064A\u0621 \u064A\u0647\u062A\u0632\u060C
      \u0641\u0631\u0628\u0645\u0627 \u0645\u0646 \u0627\u0644\u0623\u0641\u0636\u0644
      \u0639\u062F\u0645 \u062A\u0646\u0627\u0648\u0644\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\u0635\u0646\u0627\u062F\u064A\u0642 \u0627\u0644\u0642\u0645\u0627\u0645\u0629
      \u0623\u0634\u0628\u0647 \u0628\u0635\u0646\u0627\u062F\u064A\u0642 \u0627\u0644\u0645\u0641\u0627\u062C\u0622\u062A!
      \u0627\u0633\u062A\u062E\u062F\u0645 \u0632\u0631 E \u0623\u0648 X \u0644\u0644\u062A\u0641\u0627\u0639\u0644!
      \u0644\u0627 \u062A\u062F\u0631\u064A \u0623\u0628\u062F\u064B\u0627 \u0645\u0627
      \u0633\u062A\u062C\u062F\u0647 \u0628\u062F\u0627\u062E\u0644\u0647\u0627!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\u0639\u0646\u062F\u0645\u0627 \u064A\u0646\u062E\u0641\u0636 \u200B\u200B\u0645\u0633\u062A\u0648\u0649
      \u0627\u0644\u062A\u0628\u0631\u0632 \u0644\u062F\u064A\u0643\u061F \u0639\u0644\u064A\u0643
      \u0623\u0646 \u062A\u0623\u0643\u0644. \u0627\u0644\u0648\u062C\u0628\u0627\u062A
      \u0627\u0644\u062E\u0641\u064A\u0641\u0629 \u063A\u064A\u0631 \u0627\u0644\u0635\u062D\u064A\u0629
      \u062A\u0639\u064A\u062F \u0645\u0644\u0621 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062A\u0648\u0649.
      \u0627\u0644\u0637\u0628\u064A\u0639\u0629 \u062C\u0645\u064A\u0644\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "\u0648\u0627\u0644\u0622\u0646 \u0625\u0644\u064A\u0643\u0645 \u0627\u0644\u062C\u0632\u0621
      \u0627\u0644\u0645\u0647\u0645. \u0627\u0633\u062A\u062E\u062F\u0645\u0648\u0627
      \u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0627\u0644\u0623\u064A\u0633\u0631
      \u0623\u0648 \u0627\u0644\u0632\u0631 \u0627\u0644\u0623\u064A\u0645\u0646
      \u0644\u0644\u062A\u0628\u0631\u0632 \u0639\u0644\u0649 \u0647\u0624\u0644\u0627\u0621
      \u0627\u0644\u0628\u0634\u0631 \u0627\u0644\u0645\u0632\u0639\u062C\u064A\u0646!
      \u0648\u0627\u0633\u062A\u062E\u062F\u0645\u0648\u0627 \u0627\u0644\u0632\u0631
      \u0627\u0644\u0623\u064A\u0645\u0646 \u0623\u0648 \u0627\u0644\u0623\u064A\u0633\u0631
      \u0644\u0644\u062A\u0635\u0648\u064A\u0628 \u062D\u062A\u0649 \u0644\u0627
      \u062A\u0647\u062F\u0631\u0648\u0627 \u0627\u0644\u0643\u062B\u064A\u0631!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\u0646\u0639\u0645!! \u0636\u0639\u0647\u0627 \u0641\u064A \u0645\u062E\u0632\u0648\u0646
      \u062C\u0646\u0627\u062D\u0643! \u0647\u0630\u0627 \u0647\u0648 \u062C\u064A\u0628
      \u0643\u0646\u0632\u0643! \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0632\u0631
      I \u0623\u0648 \u0644\u0648\u062D\u0629 \u0627\u0644\u0627\u062A\u062C\u0627\u0647\u0627\u062A
      \u0644\u0623\u0639\u0644\u0649 \u0644\u0644\u062A\u062D\u0642\u0642 \u0645\u0645\u0627
      \u062D\u0635\u0644\u062A \u0639\u0644\u064A\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "\u062D\u0633\u0646\u064B\u0627\u060C \u0647\u0644 \u062A\u0631\u0649
      \u0634\u064A\u0626\u064B\u0627 \u0644\u0627\u0645\u0639\u064B\u0627\u061F \u0623\u0648
      \u0645\u0642\u0631\u0645\u0634\u064B\u0627\u061F \u0623\u0648 \u064A\u0634\u0628\u0647
      \u0627\u0644\u0637\u0639\u0627\u0645 \u0646\u0648\u0639\u064B\u0627 \u0645\u0627\u061F
      \u064A\u0645\u0643\u0646\u0643 \u0627\u0644\u062A\u0642\u0627\u0637\u0647!
      \u0641\u0642\u0637 \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 F \u0623\u0648
      Y \u0644\u0627\u0644\u062A\u0642\u0627\u0637\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\u0644\u0642\u062F \u0643\u0627\u0646 \u0641\u064A \u0633\u0644\u0629
      \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062A!! \u0645\u0645\u0627 \u064A\u0639\u0646\u064A
      \u0623\u0646\u0647 \u0645\u0646\u062A\u062C \u0641\u0627\u062E\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\u064A\u0627 \u0625\u0644\u0647\u064A! \u0623\u0647\u0644\u0627\u064B!!
      \u0623\u0646\u062A\u0650 \u0647\u0646\u0627!! \u062D\u0633\u0646\u0627\u064B
      \u062D\u0633\u0646\u0627\u064B \u062D\u0633\u0646\u0627\u064B \u0644\u0627
      \u062F\u0627\u0639\u064A \u0644\u0644\u0630\u0639\u0631\u060C \u0644\u0643\u0646\u0646\u064A
      \u0648\u062C\u062F\u062A\u064F \u0623\u0641\u0636\u0644 \u0627\u0644\u0623\u0634\u064A\u0627\u0621!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\u0623\u062D\u0633\u0646\u062A\u0650! \u0623\u0646\u062A\u0650
      \u0623\u0634\u062C\u0639 \u0637\u0627\u0626\u0631 \u0623\u0639\u0631\u0641\u0647.
      \u0648\u0647\u0630\u0627 \u0644\u064A\u0633 \u0625\u0646\u062C\u0627\u0632\u064B\u0627
      \u0639\u0638\u064A\u0645\u064B\u0627\u060C \u0644\u0643\u0646\u0647 \u064A\u0628\u0642\u0649
      \u0625\u0646\u062C\u0627\u0632\u064B\u0627!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\u0623\u0645\u0632\u062D \u0641\u0642\u0637\u060C \u0623\u0646\u0627
      \u0628\u062D\u0627\u062C\u0629 \u0625\u0644\u0649 \u0636\u0648\u0621 \u0627\u0644\u0644\u064A\u0644.
      \u0627\u0644\u0622\u0646!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\u0623\u0648\u0647. \u0644\u0627 \u0628\u0623\u0633. \u0639\u0644\u0649
      \u0645\u0627 \u064A\u0631\u0627\u0645 \u062A\u0645\u0627\u0645\u064B\u0627.
      \u0633\u0623\u0643\u062A\u0641\u064A \u0628\u0640... \u0639\u062F\u0645 \u0627\u0644\u0646\u0648\u0645
      \u0645\u062C\u062F\u062F\u064B\u0627. \u064A\u0645\u0643\u0646\u0646\u0627
      \u0627\u0644\u062A\u062F\u0631\u0628 \u0639\u0644\u0649 \u0627\u0644\u062A\u0633\u0644\u0644
      \u0623\u0643\u062B\u0631. \u0647\u0630\u0627 \u062C\u064A\u062F. \u0623\u062D\u0628
      \u0627\u0644\u062A\u062F\u0631\u064A\u0628. \u0627\u0644\u062A\u062F\u0631\u064A\u0628
      \u0622\u0645\u0646."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "\u0633\u062A\u0641\u0639\u0644\u061F! \u064A\u0627 \u0625\u0644\u0647\u064A\u060C
      \u0627\u0644\u062D\u0645\u062F \u0644\u0644\u0647. \u062D\u0633\u0646\u064B\u0627
      \u062D\u0633\u0646\u064B\u0627. \u062A\u0633\u0644\u0644 \u0645\u0646 \u0628\u064A\u0646
      \u0627\u0644\u0628\u0634\u0631. \u0627\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0623\u0634\u064A\u0627\u0621
      \u0644\u0644\u0627\u062E\u062A\u0628\u0627\u0621. \u0625\u0630\u0627 \u0631\u0623\u0648\u0643...
      \u0641\u0645\u0646 \u0627\u0644\u0623\u0641\u0636\u0644 \u0623\u0646 \u062A\u064F\u0633\u0631\u0639!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "\u0641\u064A \u0627\u0644\u062D\u0642\u064A\u0642\u0629\u060C \u0625\u0646\u0647
      \u0645\u0635\u0628\u0627\u062D\u064A \u0627\u0644\u0644\u064A\u0644\u064A.
      \u0645\u0631\u0637\u0628\u0627\u0646 \u0645\u0644\u064A\u0621 \u0628\u0627\u0644\u064A\u0631\u0627\u0639\u0627\u062A.
      \u0644\u0627 \u0623\u0633\u062A\u0637\u064A\u0639 \u0627\u0644\u0646\u0648\u0645
      \u0628\u062F\u0648\u0646\u0647."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\u0647\u0644 \u062A\u0634\u0639\u0631 \u0628\u0627\u0644\u062B\u0642\u0629\u061F
      \u0623\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u0628\u0639\u0636 \u0627\u0644\u0645\u0633\u0627\u0639\u062F\u0629.
      \u0644\u0642\u062F \u0641\u0642\u062F\u062A \u0642\u0628\u0639\u062A\u064A
      \u0641\u064A \u0627\u0644\u0645\u0633\u0631\u062D! \u0648\u0647\u0648 \u0645\u0643\u062A\u0638
      \u0628\u0627\u0644\u0646\u0627\u0633!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "\u0644\u0644\u0631\u0643\u0636 \u0627\u0644\u0633\u0631\u064A\u0639\u060C
      \u0627\u0636\u063A\u0637 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631 \u0639\u0644\u0649
      \u0632\u0631 Shift \u0627\u0644\u0623\u064A\u0633\u0631 \u0623\u0648 L3. \u0633\u064A\u062E\u0631\u062C\u0643
      \u0647\u0630\u0627 \u0645\u0646 \u0648\u0636\u0639 \u0627\u0644\u062A\u062E\u0641\u064A\u060C
      \u0644\u0630\u0627 \u0643\u0646 \u0633\u0631\u064A\u0639\u064B\u0627! \u0625\u0630\u0627
      \u0631\u0623\u064A\u062A \u0634\u064A\u0626\u064B\u0627 \u062A\u0631\u064A\u062F\u0647...
      \u0627\u0644\u062A\u0642\u0637\u0647 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
      F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "\u0627\u0636\u063A\u0637 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631
      \u0639\u0644\u0649 \u0632\u0631 CTRL \u0627\u0644\u0623\u064A\u0633\u0631 \u0623\u0648
      \u0627\u0644\u0632\u0631 \u0627\u0644\u0623\u064A\u0633\u0631 \u0627\u0644\u0639\u0644\u0648\u064A
      \u0648\u062A\u062D\u0631\u0643 \u0628\u0628\u0637\u0621. \u0627\u0628\u0642\u064E
      \u062E\u0644\u0641 \u0627\u0644\u0623\u0634\u064A\u0627\u0621: \u0627\u0644\u0635\u0646\u0627\u062F\u064A\u0642\u060C
      \u0627\u0644\u0645\u0642\u0627\u0639\u062F\u060C \u0627\u0644\u0623\u0633\u0648\u0627\u0631\u060C
      \u0627\u0644\u0634\u062C\u064A\u0631\u0627\u062A \u0627\u0644\u0632\u062E\u0631\u0641\u064A\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "\u064A\u0645\u064A\u0644\u0648\u0646 \u0625\u0644\u0649 \u0631\u0645\u064A
      \u0627\u0644\u0623\u0634\u064A\u0627\u0621 \u0623\u0648 \u0631\u0643\u0644\u0643
      \u0623\u0648 \u0645\u0637\u0627\u0631\u062F\u062A\u0643 \u0625\u0630\u0627
      \u0631\u0623\u0648\u0643. \u0644\u0630\u0627 \u0639\u0646\u062F\u0645\u0627
      \u062A\u0631\u064A\u062F \u0623\u0646 \u062A\u0643\u0648\u0646 \u063A\u064A\u0631
      \u0645\u0631\u0626\u064A... \u0639\u0644\u064A\u0643 \u0627\u0644\u062A\u0633\u0644\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\u0623\u0639\u0644\u0645 \u0623\u0646 \u0647\u0630\u0627 \u064A\u0628\u062F\u0648
