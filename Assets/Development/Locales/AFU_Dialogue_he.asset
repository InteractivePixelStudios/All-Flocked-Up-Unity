  - m_Id: 12858535531433984
    m_Localized: "\u05D0\u05D4\u05D4\u05D4\u05D4\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\u05D0\u05D4-- \u05D6\u05D4 \u05D0\u05EA\u05D4! \u05D0\u05EA\u05D4
      \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05E4\u05E1\u05D9\u05E7 \u05DC\u05D4\u05E4\u05D7\u05D9\u05D3
      \u05D0\u05D5\u05EA\u05D9 \u05E2\u05D3 \u05D4\u05E1\u05D5\u05E3!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "\u05DB\u05DE\u05E2\u05D8 \u05D4\u05E8\u05E1\u05EA\u05D9 \u05D2\u05DD
      \u05D0\u05EA \u05DE\u05E7\u05D5\u05DD \u05D4\u05DE\u05D7\u05D1\u05D5\u05D0
      \u05E9\u05DC\u05D9!! \u05D1\u05E0\u05D9 \u05D4\u05D0\u05D3\u05DD \u05E9\u05DD
      \u05D6\u05E8\u05E7\u05D5 \u05DC\u05D9 \u05D0\u05EA \u05D4\u05E0\u05D5\u05E6\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "\u05D4\u05D0\u05DD \u05D9\u05D3\u05E2\u05EA\u05DD \u05E9\u05D4\u05D0\u05D2\u05D3\u05D4
      \u05DE\u05E1\u05E4\u05E8\u05EA \u05E9\u05E4\u05E2\u05DD \u05E2\u05D6\u05E8\u05E0\u05D5
      \u05DC\u05D1\u05E0\u05D9 \u05D0\u05D3\u05DD? \u05E0\u05E9\u05D0\u05E0\u05D5
      \u05D3\u05D5\u05D0\u05E8 \u05D0\u05DC\u05E4\u05D9 \u05E7\u05D9\u05DC\u05D5\u05DE\u05D8\u05E8\u05D9\u05DD
      \u05E2\u05D1\u05D5\u05E8\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "\u05D4\u05D9\u05D9\u05E0\u05D5 \u05D2\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD!
      \u05E9\u05DC\u05D9\u05D7\u05D9\u05DD \u05DE\u05E9\u05DE\u05D9\u05D9\u05DD!
      \u05D0\u05D2\u05D3\u05D5\u05EA \u05DE\u05E9\u05DC\u05D5\u05D7\u05D9\u05DD \u05D6\u05E2\u05D9\u05E8\u05D5\u05EA
      \u05D5\u05E0\u05D5\u05E6\u05D5\u05EA\u05D9\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\u05E0\u05E9\u05DE\u05E2 \u05DE\u05D8\u05D5\u05E8\u05E3, \u05D0\u05E0\u05D9
      \u05D9\u05D5\u05D3\u05E2. \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D4\u05DD \u05D1\u05E2\u05D9\u05E7\u05E8
      \u05E8\u05D5\u05D3\u05E4\u05D9\u05DD \u05D5\u05E6\u05D5\u05E2\u05E7\u05D9\u05DD
      \u05E2\u05DC\u05D9\u05E0\u05D5. \u05DB\u05DC \u05DB\u05DA \u05DE\u05E4\u05D7\u05D9\u05D3!
      \u05D1\u05E0\u05D9 \u05D0\u05D3\u05DD \u05D4\u05DD \u05D1\u05DC\u05EA\u05D9
      \u05E6\u05E4\u05D5\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "\u05D4\u05DD \u05E0\u05D5\u05D8\u05D9\u05DD \u05DC\u05D6\u05E8\u05D5\u05E7
      \u05D3\u05D1\u05E8\u05D9\u05DD, \u05DC\u05D1\u05E2\u05D5\u05D8 \u05D0\u05D5
      \u05DC\u05E8\u05D3\u05D5\u05E3 \u05D0\u05D7\u05E8\u05D9\u05DA \u05D0\u05DD
      \u05D4\u05DD \u05DE\u05D1\u05D7\u05D9\u05E0\u05D9\u05DD \u05D1\u05DA. \u05D0\u05D6
      \u05DB\u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA
      \u05D1\u05DC\u05EA\u05D9 \u05E0\u05E8\u05D0\u05D4... \u05D0\u05EA\u05D4 \u05D7\u05D9\u05D9\u05D1
      \u05DC\u05D4\u05EA\u05D2\u05E0\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "\u05D4\u05D7\u05D6\u05E7 \u05D0\u05EA \u05DE\u05E7\u05E9 CTRL \u05E9\u05DE\u05D0\u05DC\u05D9
      \u05D0\u05D5 \u05D0\u05EA \u05DE\u05E7\u05E9 \u05D4\u05E4\u05D2\u05D5\u05E9
      \u05E9\u05DE\u05D0\u05DC\u05D9 \u05D5\u05D6\u05D5\u05D6\u05D5 \u05DC\u05D0\u05D8.
      \u05D4\u05D9\u05E9\u05D0\u05E8\u05D5 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D3\u05D1\u05E8\u05D9\u05DD.
      \u05E7\u05D5\u05E4\u05E1\u05D0\u05D5\u05EA. \u05E1\u05E4\u05E1\u05DC\u05D9\u05DD.
      \u05D2\u05D3\u05E8\u05D5\u05EA. \u05E9\u05D9\u05D7\u05D9\u05DD \u05D3\u05E7\u05D5\u05E8\u05D8\u05D9\u05D1\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "\u05DB\u05D3\u05D9 \u05DC\u05E8\u05D5\u05E5, \u05D4\u05D7\u05D6\u05D9\u05E7\u05D5
      \u05D0\u05EA \u05DE\u05E7\u05E9 \u05D4-SHIFT \u05D4\u05E9\u05DE\u05D0\u05DC\u05D9
      \u05D0\u05D5 \u05D0\u05EA L3 \u05DC\u05D7\u05D5\u05E5. \u05D6\u05D4 \u05D9\u05D5\u05E6\u05D9\u05D0
      \u05D0\u05EA\u05DB\u05DD \u05DE\u05DE\u05E6\u05D1 \u05D4\u05EA\u05D2\u05E0\u05D1\u05D5\u05EA,
      \u05D0\u05D6 \u05D4\u05D9\u05D5 \u05DE\u05D4\u05D9\u05E8\u05D9\u05DD!! \u05D0\u05DD
      \u05D0\u05EA\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD \u05DE\u05E9\u05D4\u05D5
      \u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD... \u05D7\u05D8\u05E4\u05D5
      \u05D0\u05D5\u05EA\u05D5 \u05E2\u05DD \u05DE\u05E7\u05E9 F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05D1\u05D8\u05D5\u05D7\u05D9\u05DD
      \u05D1\u05E2\u05E6\u05DE\u05DB\u05DD? \u05D0\u05E0\u05D9 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD
      \u05E2\u05D6\u05E8\u05D4. \u05D4\u05E4\u05DC\u05EA\u05D9 \u05D0\u05EA \u05DE\u05D7\u05D6\u05D9\u05E7
      \u05D4\u05DE\u05E4\u05EA\u05D7\u05D5\u05EA \u05D4\u05DE\u05EA\u05D5\u05E7 \u05D4\u05D6\u05D4
      \u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D9\u05D0\u05D8\u05E8\u05D5\u05DF!
      \u05D5\u05D4\u05D5\u05D0 \u05DE\u05DC\u05D0 \u05D1\u05D0\u05E0\u05E9\u05D9\u05DD!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "\u05D0\u05DD \u05EA\u05E6\u05DC\u05D9\u05D7 \u05DC\u05EA\u05E4\u05D5\u05E1
      \u05D0\u05EA \u05D6\u05D4, \u05D0\u05E0\u05D9 \u05D0\u05EA\u05DF \u05DC\u05DA
      \u05DC\u05E9\u05DE\u05D5\u05E8 \u05D0\u05EA \u05D6\u05D4! \u05D0\u05D5\u05DC\u05D9
      \u05EA\u05DE\u05E6\u05D0 \u05DC\u05D6\u05D4 \u05E9\u05D9\u05DE\u05D5\u05E9
      \u05D0\u05D7\u05E8 \u05DB\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "\u05E0\u05E1\u05D5 \u05DC\u05D4\u05EA\u05D2\u05E0\u05D1 \u05D5\u05DC\u05E2\u05D1\u05D5\u05E8
      \u05D0\u05EA \u05D1\u05E0\u05D9 \u05D4\u05D0\u05D3\u05DD. \u05D0\u05DD \u05D4\u05DD
      \u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD... \u05DB\u05D3\u05D0\u05D9
      \u05E9\u05EA\u05D6\u05D9\u05D6\u05D5 \u05D0\u05EA \u05D4\u05E8\u05D2\u05DC\u05D9\u05D9\u05DD
      \u05D4\u05E7\u05D8\u05E0\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\u05D0\u05D4. \u05D6\u05D4 \u05D1\u05E1\u05D3\u05E8. \u05D6\u05D4
      \u05D1\u05E1\u05D3\u05E8. \u05D0\u05E0\u05D9 \u05E4\u05E9\u05D5\u05D8 \u05D0\u05DC\u05DA...
      \u05D5\u05D0\u05D1\u05D9\u05D0 \u05D0\u05EA \u05D6\u05D4 \u05D1\u05E2\u05E6\u05DE\u05D9.
      \u05D6\u05D4 \u05D8\u05D5\u05D1. \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1
      \u05DC\u05D4\u05EA\u05D0\u05DE\u05DF. \u05DC\u05D4\u05EA\u05D0\u05DE\u05DF
      \u05D6\u05D4 \u05D1\u05D8\u05D5\u05D7."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\u05E1\u05EA\u05DD \u05E6\u05D5\u05D7\u05E7. \u05D6\u05D4 \u05DC\u05D2\u05DE\u05E8\u05D9
      \u05D0\u05EA\u05D4. \u05E7\u05D3\u05D9\u05DE\u05D4!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\u05E2\u05E9\u05D9\u05EA \u05D0\u05EA \u05D6\u05D4!!! \u05D0\u05EA
      \u05D4\u05E6\u05D9\u05E4\u05D5\u05E8 \u05D4\u05DB\u05D9 \u05D0\u05DE\u05D9\u05E6\u05D4
      \u05E9\u05D0\u05E0\u05D9 \u05DE\u05DB\u05D9\u05E8\u05D4. \u05D5\u05D6\u05D4
      \u05DC\u05D0 \u05E8\u05E3 \u05D2\u05D1\u05D5\u05D4 \u05D0\u05D1\u05DC \u05D1\u05DB\u05DC
      \u05D6\u05D0\u05EA!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\u05D0\u05DC\u05D5\u05D4\u05D9\u05DD \u05D0\u05D3\u05D9\u05E8\u05D9\u05DD!
      \u05D4\u05D9\u05D9!! \u05D4\u05D2\u05E2\u05EA!! \u05D0\u05D5\u05E7\u05D9\u05D9
      \u05D0\u05D5\u05E7\u05D9\u05D9 \u05D0\u05D5\u05E7\u05D9\u05D9 \u05D0\u05DC
      \u05EA\u05D9\u05D1\u05D4\u05DC \u05D0\u05D1\u05DC \u05DE\u05E6\u05D0\u05EA\u05D9
      \u05D0\u05EA \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD \u05D4\u05DB\u05D9 \u05D8\u05D5\u05D1\u05D9\u05DD!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05E4\u05D7 \u05D0\u05E9\u05E4\u05D4!!
      \u05DE\u05D4 \u05E9\u05D0\u05D5\u05DE\u05E8 \u05E9\u05D6\u05D4 \u05E4\u05E8\u05D9\u05DE\u05D9\u05D5\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "\u05D0\u05D5\u05E7\u05D9\u05D9, \u05D0\u05D6 \u05DB\u05D0\u05D9\u05DC\u05D5
      - \u05E8\u05D5\u05D0\u05D9\u05DD \u05DE\u05D1\u05E8\u05D9\u05E7? \u05D0\u05D5
      \u05E4\u05E8\u05D9\u05DA? \u05D0\u05D5 \u05E7\u05E6\u05EA \u05D1\u05E6\u05D5\u05E8\u05EA
      \u05D0\u05D5\u05DB\u05DC? \u05E4\u05E9\u05D5\u05D8 \u05E8\u05D5\u05E6\u05D5
      \u05DC\u05D0\u05DB\u05D5\u05DC! \u05D0\u05DD \u05D0\u05EA\u05DD \u05DC\u05D0
      \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D0\u05DB\u05D5\u05DC \u05D0\u05EA
      \u05D6\u05D4, \u05E0\u05E1\u05D5 \u05DC\u05EA\u05E4\u05D5\u05E1 \u05D0\u05EA
      \u05D6\u05D4 \u05E2\u05DC \u05D9\u05D3\u05D9 \u05DC\u05D7\u05D9\u05E6\u05D4
      \u05DE\u05DE\u05D5\u05E9\u05DB\u05EA \u05E2\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8
      F \u05D0\u05D5 X."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\u05DB\u05DF!! \u05E9\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D6\u05D4
      \u05D1\u05DB\u05D9\u05E1 \u05D4\u05D0\u05D5\u05E6\u05E8 \u05E9\u05DC\u05DB\u05DD!
      \u05D6\u05D4 \u05DB\u05D9\u05E1 \u05D4\u05D0\u05D5\u05E6\u05E8 \u05E9\u05DC\u05DB\u05DD!
      \u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC I \u05D0\u05D5 \u05E2\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8
      \u05D4\u05DB\u05D9\u05D5\u05D5\u05DF \u05DC\u05DE\u05E2\u05DC\u05D4 \u05DB\u05D3\u05D9
      \u05DC\u05D1\u05D3\u05D5\u05E7 \u05DE\u05D4 \u05D9\u05E9 \u05DC\u05DB\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "\u05D5\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D4\u05D7\u05DC\u05E7 \u05D4\u05DB\u05D9
      \u05D8\u05D5\u05D1. \u05D4\u05E9\u05EA\u05DE\u05E9\u05D5 \u05D1\u05DC\u05D7\u05D9\u05E6\u05D4
      \u05E9\u05DE\u05D0\u05DC\u05D9\u05EA \u05D0\u05D5 \u05D1\u05D4\u05D3\u05E7
      \u05D9\u05DE\u05E0\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
      \u05E7\u05E7\u05D9 \u05E2\u05DC \u05D1\u05E0\u05D9 \u05D4\u05D0\u05D3\u05DD
      \u05D4\u05DE\u05E2\u05E6\u05D1\u05E0\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4!
      \u05D5\u05D1\u05DC\u05D7\u05D9\u05E6\u05D4 \u05D9\u05DE\u05E0\u05D9\u05EA \u05D0\u05D5
      \u05D1\u05D4\u05D3\u05E7 \u05E9\u05DE\u05D0\u05DC\u05D9 \u05DB\u05D3\u05D9
      \u05DC\u05DB\u05D5\u05D5\u05DF, \u05DB\u05DA \u05E9\u05EA\u05D1\u05D6\u05D1\u05D6\u05D5
      \u05E4\u05D7\u05D5\u05EA!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\u05DB\u05E9\u05DE\u05D3 \u05D4\u05E6\u05D5\u05D0\u05D4 \u05E9\u05DC\u05DA
      \u05D9\u05D5\u05E8\u05D3? \u05D0\u05EA\u05D4 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D0\u05DB\u05D5\u05DC.
      \u05D7\u05D8\u05D9\u05E4\u05D9 \u05D0\u05E9\u05E4\u05D4 \u05DE\u05DE\u05DC\u05D0\u05D9\u05DD
      \u05D0\u05D5\u05EA\u05D5 \u05D1\u05D7\u05D6\u05E8\u05D4. \u05D4\u05D8\u05D1\u05E2
      \u05D9\u05E4\u05D4\u05E4\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\u05E4\u05D7\u05D9 \u05D0\u05E9\u05E4\u05D4 \u05D4\u05DD \u05DB\u05DE\u05D5
      \u05E7\u05D5\u05E4\u05E1\u05D0\u05D5\u05EA \u05DE\u05E1\u05EA\u05D5\u05E8\u05D9\u05DF!
