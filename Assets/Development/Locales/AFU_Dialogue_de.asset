%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12859020745297920
    m_Localized: "Jetzt zeig mir, was du drauf hast! Halte Ausschau nach Rennplakaten
      wie dem auf diesem Schild und teste dein K\xF6nnen! Zeig mir, was du kannst!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: Schnell abtauchen? Dann Q benutzen. Oder lieber sanfter? Mit G schweben
      oder einfach hinabgleiten.
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: Na gut, Mann. Du kennst die Grundlagen, willst aber mehr! Was kommt
      als Erstes? Abheben!
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Entspann dich. Der Himmel ist k\xFChl. Er sieht nur so gro\xDF
      aus. Okay, ja, er ist riesig. Aber dir wird nichts passieren."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: Hey Kleiner! Bist du bereit, ein paar coole Moves zu lernen?
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Vielleicht Pommes. Vielleicht Brot. Vielleicht etwas, das den Charakter
      st\xE4rkt. Wenn es wackelt, lass es lieber."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "M\xFClltonnen sind wie \xDCberraschungsboxen! Benutze die E- ODER
      X-Taste, um zu interagieren! Du wei\xDFt nie, was du bekommst!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "Wenn dein Stuhlgangpegel sinkt? Dann musst du essen. M\xFCllsnacks
      f\xFCllen ihn wieder auf. Die Natur ist wundersch\xF6n."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Und jetzt kommt der wichtige Teil: Benutze die LINKE KLICKE ODER
      DIE RECHTE TRIGGER-TASTE, um diese l\xE4stigen Menschen zu bekacken! Und benutze
      die RECHTE KLICKE ODER DIE LINKE TRIGGER-TASTE, um zu zielen und so weniger
      zu verschwenden!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "JAAA!! Pack es in dein Fl\xFCgelinventar! Das ist deine Schatztasche!
      Dr\xFCcke I ODER den Richtungspfeil nach oben, um zu sehen, was du bekommen
      hast."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Okay, also \u2013 gl\xE4nzt es? Ist es knusprig? Oder hat es eine
      entfernte Form wie Essen? Dann schnell hin und essen! Wenn du es nicht essen
      kannst, versuche, es zu greifen, indem du die Taste F oder X gedr\xFCckt h\xE4ltst."
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "Es lag in einem M\xFClleimer!! Das hei\xDFt, es ist Premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: OMG! HALLO!! Du bist da!! Okay, okay, okay, keine Panik, aber ich
      habe die BESTEN Sachen gefunden!!
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "DU HAST ES GESCHAFFT!!! Du bist der mutigste Vogel, den ich kenne.
      Was zwar keine gro\xDFe Leistung ist, aber trotzdem!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Nur Spa\xDF. Das hier ist ganz allein deine Aufgabe. Los!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Oh. Schon gut. Kein Problem. Ich hole es mir dann einfach selbst.
      Das ist gut. Ich \xFCbe gern. \xDCbung ist sicher."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Versuch, dich an den Menschen vorbeizuschleichen. Wenn sie dich
      sehen\u2026 dann beweg deine kleinen F\xFC\xDFe besser!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Wenn du es ergattern kannst, darfst du es behalten! Vielleicht
      findest du sp\xE4ter noch Verwendung daf\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "F\xFChlst du dich selbstsicher? Ich brauche Hilfe. Ich habe diesen
      tollen Schl\xFCsselanh\xE4nger im Theater verloren! Und es ist total \xFCberf\xFCllt!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Zum Sprinten die linke SHIFT-Taste oder L3 gedr\xFCckt halten.
      Dadurch verl\xE4sst du den Schleichmodus, also sei schnell! Wenn du etwas siehst,
      das du haben willst, schnapp es dir mit F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Halten Sie die linke Strg-Taste oder die linke Sto\xDFstange gedr\xFCckt
      und bewegen Sie sich langsam. Bleiben Sie hinter Objekten. Kisten. B\xE4nken.
      Z\xE4unen. Zierstr\xE4uchern."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Wenn sie dich entdecken, werfen sie oft mit Gegenst\xE4nden, treten
      nach dir oder jagen dich. Wenn du also unsichtbar sein willst \u2026 musst
      du dich anschleichen."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Klingt verr\xFCckt, ich wei\xDF. Jetzt jagen und beschimpfen sie
      uns nur noch. So gruselig! Menschen sind unberechenbar."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: Wir waren Helden! Himmelsboten! Winzige, gefiederte Lieferlegenden!
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Wusstest du, dass die Legende besagt, wir h\xE4tten einst den Menschen
      geholfen? Wir transportierten f\xFCr sie Post \xFCber Tausende von Kilometern!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Fast h\xE4tten sie auch noch mein Versteck ruiniert!! Diese Menschen
      da dr\xFCben haben mir das Gefieder ausgerissen!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Oh \u2013 du bist es! H\xF6r auf, mir so eine Angst einzujagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Mein ganzer Flo-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: Naja, egal *Ich habe hier nicht deine ganze Lebensgeschichte abgefragt*
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Ich h\xE4tte hier ein altes Nest, falls du es haben willst. Es
      ist renovierungsbed\xFCrftig, aber immer noch... gut."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: In Ordnung
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "SUPER! Es ist dr\xFCben in der N\xE4he der Picknicktische!"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: Sollen Taubennester wirklich so... schlimm aussehen?
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "Fr\xFCher haben wir auf Spikes geschlafen und waren gl\xFCcklich.
      *SCHNAUZ* Okay, vielleicht k\xF6nntest du es mit ein paar St\xF6cken etwas
      aufpeppen?"
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: Schau mal im Nest nach! Vielleicht habe ich ein paar herumliegen
      lassen?
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "Da du neu hier bist, m\xF6chte ich dir ein paar Tipps geben."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Jeder kennt uns daf\xFCr, dass wir \xFCberall hinkacken. Aber du
      musst erst mal deinen Tank f\xFCllen! Hier gibt es bestimmt etwas zu essen."
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "Ich sage das, weil es mir wichtig ist\u2026 Aber du siehst\u2026
      schwach aus. Du wirst wieder st\xE4rker werden, aber wir alle brauchen manchmal
      Hilfe."
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "Versuch, den Gullydeckel als Sprungbrett zu benutzen, damit du
      besser auf das Dach des Geb\xE4udes kommst. Dort kannst du dich super vor w\xFCtenden
      Menschen verstecken!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: Wie bist du denn so schnell hier hochgekommen?!
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "Schnell...? Du hast so lange gebraucht, dass ich fast gegangen
      w\xE4re!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "Du wei\xDFt, wo du Essen findest. Du wei\xDFt, wie du dich sch\xFCtzen
      kannst. Das Beste kommt zum Schluss!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: Seht ihr die Menschen da unten? Ihr wisst, was zu tun ist! Macht
      mich stolz!
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Ich habe dir alles beigebracht, was ich schon wei\xDF. Zeit, andere
      V\xF6gel zu \xE4rgern!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: HEY!! HEY COO!!
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: Kenne ich dich?
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: Nein.
    m_Metadata:
      m_Items: []
  - m_Id: 47017676951552
    m_Localized: "Hallo junger Mann! Du scheinst dich verlaufen zu haben? K\xF6nntest
      du mir vielleicht helfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "Crow findet Waren\u2026 wenn man Schmuckst\xFCcke hat."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: Bring mir die Rose, dann kannst du mit mir handeln. Bis dahin haben
      wir geschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: Ich verstehe. Sehr poetisch.
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "Ein Reisender des Himmels, beladen mit einer Bestimmung. Sag mir,
      fl\xFCstern dir die Winde Geheimnisse zu, wie sie es mir tun?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "Du wei\xDFt schon, dass du einfach gehen kannst, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "Dieser Stand ist zu meinem Gef\xE4ngnis geworden. Ich suche eine
      Rose f\xFCr meine wahre Liebe. Nur sie kann mir Freiheit schenken!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "Ein fairer Tausch, nicht wahr? Schmuckst\xFCcke gegen Sch\xE4tze?
      Eine Tat gegen eine Tat."
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "Ich sehe \u2026 Okay, ich verstehe, was los ist. Was brauchst du?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "Das Gesch\xE4ft ist geschlossen. Kommen Sie sp\xE4ter wieder\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "Ich habe geh\xF6rt, Sie suchen nach Schmuckst\xFCcken?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Er treibt sich normalerweise in Gassen herum, aber Vorsicht vor
      diesen l\xE4stigen Katzen. Du willst ja nicht wie ich die Nacht in einem M\xFCllcontainer
      verbringen."
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "Oh! Bevor ich gehe, habe ich noch einen seltsamen alten Raben getroffen.
      Er hat hier irgendwo einen Laden! Vielleicht hat er ja etwas, gegen das du
      die Schmuckst\xFCcke eintauschen kannst?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: Nach so einem schrecklichen Tag werde ich mich erst einmal ausruhen!
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: Keine Sorge, ich bin weg...
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "Pff \u2013 Verschwinde jetzt! Raus aus meiner Gasse!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "Kennst du den Vogel da dr\xFCben? Er ist weggelaufen, als die Katzen
      kamen und riefen: \u201EFriss sie! Friss sie!\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Danke\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "Ich hatte gehofft, Arnesto w\xFCrde kommen, aber ich freue mich
      sehr, dich zu sehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "Du hast mich gefunden!! Ich hatte so gro\xDFe Angst!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "Tally Ho, lieber Freund! \u2013 Ja. Auf geht's!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "\u2026aber viel wichtiger \u2013 BITTE HELFT MIR, MEINE SNACKS
      ZUR\xDCCKZUBEKOMMEN!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "Oh, ich glaube, da ist auch ein junger Vogel reingeraten. Du siehst
      ihr ja total \xE4hnlich! Ja! Ja, wirklich!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: Verpasst ihnen einen ordentlichen Schlag mit KACKE! DAS sollte ihnen
      eine Lektion erteilen!
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: Nun gut, diese Grobiane haben mich lange genug aufgehalten.
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: Nicht zu schimmelig... aber gerade genug, um dem Ganzen etwas Geschmack
      zu verleihen! Anders geht's nicht!
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "Eine Meute Mischlinge hat meine Lieblingsgasse f\xFCr sich entdeckt.
      Hier gibt es die beste Auswahl, sehen Sie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: Ausgezeichnet, mein lieber Vogel! Vielen Dank!
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "\xC4hm. Ich bin gerade etwas besch\xE4ftigt."
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "K\xF6nnten Sie einem alten Herrn wie mir bei einem Dilemma helfen?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: Du siehst jung und lebhaft aus, robust genug, um ein oder zwei Katzen
      zu erschrecken!
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: Ich sage nur, mein Lieber!
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "Oh! Hier, nimm das als Entsch\xE4digung f\xFCr deine M\xFChe. Das
      ist das Mindeste, was ich tun kann."
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Du wirst schon jemanden zum Reden finden\u2026 Ich habe hier vor
      Kurzem einen Vogel getroffen! Er sprach mit einem seltsamen Akzent."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: Wir sind viele! Wir Tauben haben starke Gene *zwinkert*
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "Oh, da gehe ich nicht mehr hin. Ich habe sie noch nie in meinem
      Leben getroffen\u2026 und sie machen mir irgendwie Angst."
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "Ach, was f\xFCr ein Geld er doch schuldet! \u200B\u200BWas f\xFCr
      eine wilde Nacht! Gott sei Dank f\xFCr mich!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: Wingo hat mir gesagt, ich solle Ihnen das bringen?
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "Du siehst\u2026 bekannt aus? Seltsam."
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Nat\xFCrlich tust du das."
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: ...mit ein bisschen Hilfe meiner Freunde komme ich zurecht?
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: Kannst du das nicht selbst machen? Ich habe dem nicht zugestimmt?!
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Da du ja sowieso hingehst, k\xF6nntest du ihnen bitte das Brot
      mitbringen, das ich dir schulde?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: Das ist... nicht hilfreich. Wer ist es?
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: Du MUSST sie kennenlernen!
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "Aber hat dir schon mal jemand gesagt, dass du jemandem, den ich
      kenne, verdammt \xE4hnlich siehst? *schielt*"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
