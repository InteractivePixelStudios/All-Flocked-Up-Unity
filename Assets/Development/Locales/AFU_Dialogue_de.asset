%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12859055969062912
    m_Localized: "Jetzt zeig mir, was du drauf hast! Halte Ausschau nach Rennplakaten
      wie dem auf diesem Schild und teste dein K\xF6nnen! Zeig mir, was du kannst!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859043797192704
    m_Localized: "Letzter Zug. Ansitzplatz. Geeignete Ansitzpl\xE4tze sind mit einem
      kleinen Symbol gekennzeichnet. Langsam ansetzen. F\xFC\xDFe nach vorne. Lass
      dich fangen. Dr\xFCcke E, sobald das Symbol erscheint!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859032170582016
    m_Localized: Jetzt komm rein. Willst du schnell runtertauchen? Benutze Q. Oder
      lieber sanfter? Schwebe mit G oder gleite einfach runter.
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "Lass den Flugknopf los und gleite einfach nach unten. Schnell fliegen
      ist einfach. Cool fliegen? Das ist K\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Benutze WASD ODER DEN RECHTEN STEUER, den Birdadette dir beigebracht
      hat, um deine Flugrichtung zu steuern. K\xE4mpfe nicht gegen den Wind an \u2013
      lass dich von ihm tragen."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: Na gut, Mann. Du kennst die Grundlagen, willst aber mehr! Was kommt
      als Erstes? Abheben!
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Entspann dich. Der Himmel ist k\xFChl. Er sieht nur so gro\xDF
      aus. Okay, ja, er ist riesig. Aber dir wird nichts passieren."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: Hey Kleiner! Bist du bereit, ein paar coole Moves zu lernen?
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Vielleicht Pommes. Vielleicht Brot. Vielleicht etwas, das den Charakter
      st\xE4rkt. Wenn es wackelt, lass es lieber."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "M\xFClltonnen sind wie \xDCberraschungsboxen! Benutze die E- ODER
      X-Taste, um zu interagieren! Du wei\xDFt nie, was du bekommst!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "Wenn dein Stuhlgangpegel sinkt? Dann musst du essen. M\xFCllsnacks
      f\xFCllen ihn wieder auf. Die Natur ist wundersch\xF6n."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Und jetzt kommt der wichtige Teil: Benutze die LINKE KLICKE ODER
      DIE RECHTE TRIGGER-TASTE, um diese l\xE4stigen Menschen zu bekacken! Und benutze
      die RECHTE KLICKE ODER DIE LINKE TRIGGER-TASTE, um zu zielen und so weniger
      zu verschwenden!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "JAAA!! Pack es in dein Fl\xFCgelinventar! Das ist deine Schatztasche!
      Dr\xFCcke I ODER den Richtungspfeil nach oben, um zu sehen, was du bekommen
      hast."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Okay, also \u2013 siehst du etwas Gl\xE4nzendes? Oder Knuspriges?
      Oder etwas, das entfernt an Essen erinnert? Du kannst es aufheben! Dr\xFCcke
      einfach F ODER Y, um es zu greifen."
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "Es lag in einem M\xFClleimer!! Das hei\xDFt, es ist Premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: OMG! HALLO!! Du bist da!! Okay, okay, okay, keine Panik, aber ich
      habe die BESTEN Sachen gefunden!!
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "DU HAST ES GESCHAFFT!!! Du bist der mutigste Vogel, den ich kenne.
      Was zwar keine gro\xDFe Leistung ist, aber trotzdem!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Spa\xDF beiseite, ich BRAUCHE mein Nachtlicht. JETZT!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Oh. Schon gut. Alles in Ordnung. Ich werde dann einfach\u2026 nie
      wieder schlafen. Wir k\xF6nnen das Schleichen weiter \xFCben. Das ist gut.
      Ich mag \xDCbung. \xDCbung ist sicher."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "WIRST DU DAS WIRKLICH?! Oh Gott sei Dank. Okay, okay. Schleich
      dich an den Menschen vorbei. Benutze Gegenst\xE4nde als Deckung. Wenn sie dich
      sehen \u2026 dann beweg deine kleinen F\xFC\xDFe besser!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Es ist eigentlich mein Nachtlicht. Ein Glas voller Gl\xFChw\xFCrmchen.
      Ohne es kann ich nicht schlafen."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "F\xFChle ich mich selbstsicher? Ich brauche dringend Hilfe. Ich
      habe meinen Hut im Theater verloren! Und es ist brechend voll!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Zum Sprinten die linke SHIFT-Taste oder L3 gedr\xFCckt halten.
      Dadurch verl\xE4sst du den Schleichmodus, also sei schnell! Wenn du etwas siehst,
      das du haben willst, schnapp es dir mit F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Halten Sie die linke Strg-Taste oder die linke Sto\xDFstange gedr\xFCckt
      und bewegen Sie sich langsam. Bleiben Sie hinter Objekten. Kisten. B\xE4nken.
      Z\xE4unen. Zierstr\xE4uchern."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Wenn sie dich entdecken, werfen sie oft mit Gegenst\xE4nden, treten
      nach dir oder jagen dich. Wenn du also unsichtbar sein willst \u2026 musst
      du dich anschleichen."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Klingt verr\xFCckt, ich wei\xDF. Jetzt jagen und beschimpfen sie
      uns nur noch. So gruselig! Menschen sind unberechenbar."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: Wir waren Helden! Himmelsboten! Winzige, gefiederte Lieferlegenden!
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Wusstest du, dass die Legende besagt, wir h\xE4tten einst den Menschen
      geholfen? Wir transportierten f\xFCr sie Post \xFCber Tausende von Kilometern!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Fast h\xE4tten sie auch noch mein Versteck ruiniert!! Diese Menschen
      da dr\xFCben haben mir das Gefieder ausgerissen!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Oh \u2013 du bist es! H\xF6r auf, mir so eine Angst einzujagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
