%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_da
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12859020745297920
    m_Localized: "Slip din flyknap, og glid bare ned. Det er nemt at flyve hurtigt.
      At flyve sejt? Det er f\xE6rdighed."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Brug WASD ELLER H\xD8JRE PINDPINDE, som Birdadette l\xE6rte dig,
      til at kontrollere, hvor du flyver hen. K\xE6mp ikke mod vinden \u2013 vib
      med den."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Okay, mand. Du kender det grundl\xE6ggende, men du vil have mere!
      F\xF8rste skridt? Slip afsted."
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Slap af med fjerene. Himlen er kold. Den ser bare stor ud. Okay,
      ja, den er massiv. Men det skal nok g\xE5."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Hej lille mand!! Er du klar til at l\xE6re nogle fede moves?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "M\xE5ske pommes frites. M\xE5ske br\xF8d. M\xE5ske noget der opbygger
      karakter. Hvis det bev\xE6ger sig, s\xE5 lad v\xE6re."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Skraldespande er som mystiske kasser! Brug E- ELLER X-KNAPPEN til
      at interagere! Du ved aldrig, hvad du f\xE5r!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "N\xE5r din aff\xF8ringsm\xE5ler bliver lav? Du skal spise. Affaldssnacks
      fylder den op igen. Naturen er SMUK."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Her kommer den VIGTIGE del. Brug VENSTREKLIK ELLER H\xD8JRE AFTR\xC6KKER
      til at lave skidt p\xE5 de irriterende mennesker! Og H\xD8JREKLIK ELLER VENSTRE
      AFTR\xC6KKER til at sigte, s\xE5 du spilder mindre!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "JA!! L\xE6g den i dit vingelager! Det er din skattelomme! Tryk
      p\xE5 I ELLER OPAD-PLADEN for at se, hvad du har."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Okay, s\xE5dan noget - ser du den skinnende ud? Eller knasende?
      Eller en smule madformet? Bare l\xF8b hen og spis! Hvis du ikke kan SPISE den,
      s\xE5 pr\xF8v at GRIB den ved at HOLDE F- eller X-KNAPPEN NEDE"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "Den l\xE5 i en skraldespand!! Hvilket betyder, at den er premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: OMG! HEJ!! Du er her!! Okay okay okay, bare rolig, men jeg har fundet
      de BEDSTE ting!!
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "DU KLAREDE DET!!! Du er den modigste fugl jeg kender. Hvilket ikke
      er en h\xF8j standard, men stadig!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Bare for sjov. Denne her er dig til gode. K\xD8R!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\xC5h. Det er okay. Helt fint. Jeg skal bare\u2026 Aldrig sove
      igen. Vi kan \xF8ve os mere i at snige os. Det er godt. Jeg kan godt lide at
      \xF8ve. \xD8velse er sikkert."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Pr\xF8v at snige dig forbi menneskerne. Hvis de ser dig ... s\xE5
      m\xE5 du hellere flytte de sm\xE5 f\xF8dder!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Hvis du kan f\xE5 fat i den, s\xE5 beholder du den! M\xE5ske kan
      du bruge den til noget senere."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "F\xF8ler du dig selvsikker? Jeg har brug for hj\xE6lp. Jeg tabte
      denne s\xF8de N\xD8GLERING inde i TEATRET! Og det er proppet med mennesker!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "For at spurte, hold VENSTRE SHIFT ELLER L3 nede. Det vil tage dig
      ud af stealth-tilstand, s\xE5 v\xE6r hurtig!! Hvis du ser noget, du vil have
      ... snup det med F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Hold VENSTRE CTRL ELLER VENSTRE KOFANGER nede, og bev\xE6g dig
      langsomt. Bliv bag ting. Kasser. B\xE6nke. Hegn. Dekorative buskads."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "De har en tendens til at kaste med ting, sparke eller jagte dig,
      hvis de ser dig. S\xE5 n\xE5r du vil v\xE6re usynlig ... skal du snige dig."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Det lyder sk\xF8rt, jeg ved det. Nu jagter og r\xE5ber de for det
      meste bare ad os. S\xE5 UHYGGELIGT! Mennesker er uforudsigelige."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Vi var helte! Himmelbudbringere! Sm\xE5, fjerkl\xE6dte leveringslegender!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: Vidste du, at legenden siger, at vi engang hjalp mennesker? Vi bar
      post tusindvis af kilometer for dem!
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Jeg var lige ved at \xF8del\xE6gge mit skjulested ogs\xE5!! De
      mennesker derovre slog fjerdragten af \u200B\u200Bmig!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\xC5h-- Det er dig! Du skal holde op med at skr\xE6mme fjerene
      af mig!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: "\xC5HHHHH!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: Krage finder varer ... hvis du har nipsgenstande.
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "Bring mig rosen, s\xE5 kan du bytte med mig. Indtil da har vi lukket."
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "Jeg forst\xE5r det. Meget poetisk."
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "En himmelrejsende, tynget af form\xE5l. Fort\xE6l mig, hvisker
      vindene hemmeligheder til dig, som de g\xF8r til mig?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "Du ved godt, at du bare kan g\xE5, ikke?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "Denne bod er blevet mit f\xE6ngsel. Jeg s\xF8ger en ROSE til min
      store k\xE6rlighed. Kun de kan f\xE5 mig til at f\xF8le mig FRI!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: En fair handel, ikke sandt? Nipsgenstande for skatte? En gerning
      for en gerning.
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ Jeg kan se \u2026 Ok, jeg kan se, hvad der sker. Hvad
      har du brug for?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "Butikken er lukket. Kom tilbage senere\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "Jeg h\xF8rer, at du leder efter nipsgenstande?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Han plejer at h\xE6nge ud i gyder, men pas p\xE5 disse irriterende
      katte. Du vil ikke tilbringe natten i en skraldespand ligesom mig."
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "\xC5h! Inden jeg g\xE5r, m\xF8dte jeg den m\xE6rkeligste gamle
      Krage. Han har en butik et sted her i n\xE6rheden! M\xE5ske har han noget,
      du kan bytte de nipsgenstande til?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "Jeg vil lige hvile mine vinger efter s\xE5dan en forf\xE6rdelig
      dag!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "Bare rolig, jeg er v\xE6k..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: Pish posh - Nu skal du afsted! Ud af min gyde!
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "Kender du den fugl derovre? Den l\xF8b v\xE6k, da kattene kom og
      r\xE5bte \"SPIS HENDE! SPIS HENDE!\""
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Tak\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "Jeg h\xE5bede, at Arnesto ville ... komme, men jeg er s\xE5 glad
      for at se dig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "Du fandt mig!! Jeg var S\xC5 bange!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "Tally Ho, k\xE6re ven! - Ja. Afsted med dig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "...men endnu vigtigere - HJ\xC6LP MIG MED AT F\xC5 MINE SNACKS
      TILBAGE!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "\xC5h, jeg tror ogs\xE5, at en ung fugl sad fast derinde. Du ligner
      hende ret meget! Ja! Ja, sandelig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "Giv dem en god omgang AFK\xD8R! DET burde l\xE6re dem en lektie!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "N\xE5, de b\xF8ller har holdt mig ude l\xE6nge nok."
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "Ikke for muggen ... men lige nok til at tilf\xF8je lidt smag! Intet
      andet duer!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "En flok blandingshunder har f\xE5et lyst til min yndlingsgade.
      De har det fineste udvalg her, du kan se ..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "FANTASTISK min k\xE6re fugl! Mange tak!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "\xD8\xF8\xF8h. Jeg har lidt travlt-"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "Har du lyst til at hj\xE6lpe en gammel fyr som mig med et dilemma?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "Du ser ung og livlig ud, sej nok til at skr\xE6mme en KAT eller
      to!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: JEG SIGER, min gode ven!
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "\xC5h! Tag det her for din ulejlighed. Det er det mindste, jeg
      kan g\xF8re."
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Du finder nok en at snakke med ... Jeg m\xF8dte en fugl heromkring
      for ikke s\xE5 l\xE6nge siden! Talte med en m\xE6rkelig accent."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "Der er mange af os her omkring! Vi duer har st\xE6rke gener *blinker*"
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "\xC5h, jeg tager ikke tilbage dertil. Jeg har aldrig m\xF8dt dem
      i mit liv ... og de skr\xE6mmer mig lidt."
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "\xC5h, det br\xF8d han skylder. Sikke en VILD nat. Tak Wingo for
      mig!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: Wingo sagde, jeg skulle bringe dig dette?
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "Du ser ... bekendt ud? M\xE6rkeligt."
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Selvf\xF8lgelig g\xF8r du det."
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: "... jeg klarer mig med lidt hj\xE6lp fra mine venner?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "Kan du ikke g\xF8re det selv? Jeg var ikke enig i det her?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Siden du alligevel skal afsted, kan du s\xE5 bringe dem dette br\xF8d,
      jeg skylder dem?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: Det er...ikke nyttigt. Hvem er det?
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "Du SKAL m\xF8de dem!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "MEN har nogen fortalt dig, at du ligner en, jeg kender? Mist\xE6nkeligt
      identisk *SK\xC6BENDE \xD8JNENE*"
    m_Metadata:
      m_Items: []
  - m_Id: 47017676951552
    m_Localized: "Hej unge fyr! Du ser ud til at v\xE6re faret vild? Hvad med noget
      hj\xE6lp?"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Alle mine flo-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: ANYWAYYY *Spurgte ikke om hele din livshistorie her*
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: Jeg har en gammel rede heromkring, hvis du vil have den? Den er
      til at reparere, men stadig... god.
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: Okay
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "FEDT! Det er ovre ved siden af \u200B\u200Bpicnicbordene!"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "Skal dueslag se s\xE5 slemt ud?"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "Dengang sov vi p\xE5 pigge og var GLADE. *F\xC5RN* Okay, m\xE5ske
      kunne du pifte det op med et par pinde?"
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "Tjek reden! M\xE5ske har jeg ladet et par stykker ligge?"
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: Siden du er ny her, vil jeg gerne give dig et par tips.
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Alle kender os for at lave skidt overalt. Men du skal fylde din
      tank f\xF8rst! Der skal helt sikkert v\xE6re noget mad heromkring."
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "Nu siger jeg det, fordi jeg holder af det ... Men du ser ... svag
      ud. Du bliver st\xE6rkere, men vi har alle brug for hj\xE6lp nogle gange."
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "Pr\xF8v at bruge det br\xF8ndhul til et boost, s\xE5 du har en
      bedre chance for at komme op p\xE5 toppen af \u200B\u200Bbygningen. Det er
      et godt sted at gemme sig for vrede mennesker!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: "Hvordan kom du s\xE5 hurtigt herop?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "Hurtigt...? Det tog s\xE5 lang tid, at jeg n\xE6sten gik!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: Du ved, hvor du finder mad. Du ved, hvordan du holder dig sikker.
      Jeg har gemt det bedste til sidst!
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "Ser du de mennesker dernede? Ved du hvad du skal g\xF8re! G\xF8r
      mig stolt!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Jeg har allerede l\xE6rt dig alt, hvad jeg ved. Tid til at finde
      nogle andre fugle at genere!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: HEJ!! HEJ COO!!
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: Kender jeg dig?
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: Nej.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
