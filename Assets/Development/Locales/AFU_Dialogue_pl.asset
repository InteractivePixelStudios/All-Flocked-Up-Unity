%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47017676951552
    m_Localized: "Cze\u015B\u0107, m\u0142ody przyjacielu! Wygl\u0105dasz, jakby\u015B
      si\u0119 zgubi\u0142? Mo\u017Ce troch\u0119 pomocy?"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Wszystkie moje kwiaty-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "W KA\u017BDYM RAZIE *Nie pyta\u0142em tutaj o ca\u0142\u0105 histori\u0119
      twojego \u017Cycia*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Mam tu stare gniazdo, je\u015Bli chcesz? Wymaga remontu, ale wci\u0105\u017C...
      jest dobre."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: "W porz\u0105dku"
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "\u015AWIETNIE! Jest niedaleko sto\u0142\xF3w piknikowych!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "A teraz zobaczmy, jak to wszystko posk\u0142adasz. Szukaj plakat\xF3w
      wy\u015Bcigowych, takich jak ten na tym znaku, i sprawd\u017A swoje skrzyd\u0142a!
      Poka\u017C, na co ci\u0119 sta\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Musisz szybko zanurkowa\u0107? U\u017Cyj Q. Mo\u017Ce delikatniej?
      Zawi\u015Bnij w powietrzu klawiszem G albo po prostu szybuj w d\xF3\u0142."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Znasz podstawy, ale chcesz wi\u0119cej! Szybkie latanie jest \u0142atwe.
      Latanie jest fajne? To jest umiej\u0119tno\u015B\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Rozlu\u017Anij pi\xF3ra. Niebo jest ch\u0142odne. Tylko wygl\u0105da
      na du\u017Ce. No dobra, tak, jest ogromne. Ale dasz sobie rad\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Hej dzieciaku! Jeste\u015B gotowy na nauk\u0119 zajebistych ruch\xF3w?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Mo\u017Ce frytki. Mo\u017Ce chleb. Mo\u017Ce co\u015B, co kszta\u0142tuje
      charakter. Je\u015Bli co\u015B si\u0119 chwieje, mo\u017Ce nie."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Kosze na \u015Bmieci s\u0105 jak tajemnicze pude\u0142ka! U\u017Cyj
      przycisku E LUB X, aby wej\u015B\u0107 w interakcj\u0119! Nigdy nie wiesz,
      co dostaniesz!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "Kiedy wska\u017Anik kupy si\u0119 ko\u0144czy? Trzeba je\u015B\u0107.
      \u015Amieciowe przek\u0105ski go uzupe\u0142niaj\u0105. Natura jest PI\u0118KNA."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "A teraz NAJLEPSZA cz\u0119\u015B\u0107. U\u017Cyj LEWEGO PRZYCISKU
      LUB PRAWEGO SPUSTU, \u017Ceby zrobi\u0107 kup\u0119 tym irytuj\u0105cym ludziom!
      I PRAWEGO PRZYCISKU LUB LEWEGO SPUSTU, \u017Ceby celowa\u0107, \u017Ceby mniej
      marnowa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "TAK!! Wrzu\u0107 to do swojego ekwipunku! To twoja kiesze\u0144
      na skarby! Naci\u015Bnij I LUB PAD KIERUNKOWY W G\xD3R\u0118, aby sprawdzi\u0107,
      co masz."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "No dobra, wi\u0119c jak to jest \u2013 widzisz b\u0142yszcz\u0105ce?
      Albo chrupi\u0105ce? Albo co\u015B w kszta\u0142cie jedzenia? Po prostu podbiegnij
      i zjedz! Je\u015Bli nie mo\u017Cesz tego ZJE\u015A\u0106, spr\xF3buj Z\u0141APA\u0106,
      PRZYTRZYMUJ\u0104C PRZYCISK F lub X"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "By\u0142o w koszu na \u015Bmieci!! A to znaczy, \u017Ce jest premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "O m\xF3j Bo\u017Ce! Cze\u015B\u0107!! Jeste\u015B tutaj!! Dobra,
      dobra, dobra, nie panikuj, ale znalaz\u0142am NAJLEPSZE rzeczy!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "Uda\u0142o Ci si\u0119!!! Jeste\u015B najodwa\u017Cniejszym ptakiem,
      jakiego znam. Co nie jest wysoko postawion\u0105 poprzeczk\u0105, ale i tak!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\u017Bartuj\u0119. To wszystko ty. START!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Och. W porz\u0105dku. W porz\u0105dku. P\xF3jd\u0119... i sam to
      przynios\u0119. To dobrze. Lubi\u0119 \u0107wiczy\u0107. \u0106wiczenia s\u0105
      bezpieczne."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Spr\xF3buj przemkn\u0105\u0107 obok ludzi. Je\u015Bli ci\u0119
      zobacz\u0105\u2026 lepiej rusz te ma\u0142e st\xF3pki!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Je\u015Bli uda ci si\u0119 go z\u0142apa\u0107, pozwol\u0119 ci
      go zatrzyma\u0107! Mo\u017Ce kiedy\u015B ci si\u0119 przyda."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "Czujesz si\u0119 pewnie? Potrzebuj\u0119 pomocy. Zostawi\u0142em
      ten uroczy BRELOK w kinie! I jest tam t\u0142oczno!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Aby biec sprintem, przytrzymaj LEWY SHIFT LUB L3. To wy\u0142\u0105czy
      Ci\u0119 z trybu skradania, wi\u0119c b\u0105d\u017A szybki! Je\u015Bli zobaczysz
      co\u015B, czego chcesz\u2026 z\u0142ap to klawiszem F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Przytrzymaj LEWY CTRL LUB LEWY BUMPER i poruszaj si\u0119 powoli.
      Trzymaj si\u0119 z ty\u0142u. Skrzynek. \u0141awek. P\u0142ot\xF3w. Dekoracyjnych
      krzew\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Maj\u0105 tendencj\u0119 do rzucania przedmiotami, kopania lub
      gonienia ci\u0119, je\u015Bli ci\u0119 zauwa\u017C\u0105. Wi\u0119c je\u015Bli
      chcesz by\u0107 niewidzialny\u2026 musisz si\u0119 skrada\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Brzmi szalenie, wiem. Teraz przewa\u017Cnie tylko nas goni\u0105
      i na nas krzycz\u0105. Straszne! Ludzie s\u0105 nieprzewidywalni."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Byli\u015Bmy bohaterami! Podniebnymi pos\u0142a\u0144cami! Male\u0144kimi,
      pierzastymi legendami dostaw!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Czy wiesz, \u017Ce legenda g\u0142osi, i\u017C kiedy\u015B pomagali\u015Bmy
      ludziom? Nosili\u015Bmy dla nich poczt\u0119 na tysi\u0105ce kilometr\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Prawie zniszczy\u0142em te\u017C swoj\u0105 kryj\xF3wk\u0119!!
      Ci ludzie tam zrzucili ze mnie upierzenie!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Och, to ty! Musisz przesta\u0107 mnie straszy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: Nie.
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: "Czy ja ci\u0119 znam?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: HEJ!! HEJ COO!!
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Ju\u017C wszystko, co wiem, ci\u0119 nauczy\u0142em. Czas poszuka\u0107
      innych ptak\xF3w, kt\xF3rymi mo\u017Cna si\u0119 zaj\u0105\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "Widzisz tych ludzi na dole? Wiesz, co robi\u0107! Spraw, \u017Cebym
      by\u0142 dumny!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "Wiesz, gdzie znale\u017A\u0107 jedzenie. Wiesz, jak zachowa\u0107
      bezpiecze\u0144stwo. Najlepsze zostawi\u0142em na koniec!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "Szybko...? Tak d\u0142ugo zwleka\u0142e\u015B, \u017Ce prawie wyszed\u0142em!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: "Jak uda\u0142o ci si\u0119 tu tak szybko dotrze\u0107?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "Spr\xF3buj u\u017Cy\u0107 tego w\u0142azu jako dopalacza, \u017Ceby
      zwi\u0119kszy\u0107 szans\u0119 na dostanie si\u0119 na szczyt tego budynku.
      To \u015Bwietne miejsce do ukrycia si\u0119 przed w\u015Bciek\u0142ymi lud\u017Ami!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "M\xF3wi\u0119 to, bo mi zale\u017Cy... Ale wygl\u0105dasz... s\u0142abo.
      B\u0119dziesz silniejszy, ale wszyscy czasami potrzebujemy pomocy."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Wszyscy wiedz\u0105, \u017Ce wsz\u0119dzie nas sra. Ale najpierw
      musisz zatankowa\u0107! Na pewno znajdzie si\u0119 tu jakie\u015B jedzenie."
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "Poniewa\u017C jeste\u015B tu nowy, pozw\xF3l, \u017Ce dam ci kilka
      wskaz\xF3wek."
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "Sprawd\u017A gniazdo! Mo\u017Ce zostawi\u0142em kilka?"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "Za moich czas\xF3w spali\u015Bmy na kolcach i byli\u015Bmy SZCZ\u0118\u015ALIWI.
      *DRIPNI\u0118CIE* Okej, mo\u017Ce mog\u0142aby\u015B to urozmaici\u0107 kilkoma
      patykami?"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "Czy gniazdo go\u0142\u0119bi powinno wygl\u0105da\u0107 a\u017C
      tak... \u017Ale?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "Crow znajduje towary\u2026 je\u015Bli masz drobiazgi."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "Przynie\u015B mi r\xF3\u017C\u0119, a mo\u017Cesz si\u0119 ze mn\u0105
      wymieni\u0107. Do tego czasu jeste\u015Bmy zamkni\u0119ci."
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: Rozumiem. Bardzo poetyckie.
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "W\u0119drownik nieba, obci\u0105\u017Cony celem. Powiedz mi, czy
      wiatry szepcz\u0105 ci sekrety tak jak mnie?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "Wiesz, \u017Ce mo\u017Cesz po prostu wyj\u015B\u0107, prawda?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "To stoisko sta\u0142o si\u0119 moim wi\u0119zieniem. Szukam R\xD3\u017BY
      dla mojej prawdziwej mi\u0142o\u015Bci. Tylko ona mo\u017Ce sprawi\u0107, \u017Ce
      poczuj\u0119 si\u0119 WOLNY!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: Uczciwa wymiana, prawda? Drobiazgi za skarby? Czyn za czyn.
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ Widz\u0119... Ok, widz\u0119, co si\u0119 dzieje. Czego
      potrzebujesz?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "Sklep jest zamkni\u0119ty. Wr\xF3\u0107 p\xF3\u017Aniej\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "S\u0142ysza\u0142em, \u017Ce szukasz drobiazg\xF3w?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Zwykle kr\u0119ci si\u0119 po zau\u0142kach, ale uwa\u017Caj na
      te irytuj\u0105ce koty. Nie chcesz przecie\u017C sp\u0119dzi\u0107 nocy w \u015Bmietniku,
      tak jak ja."
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "Och! Zanim p\xF3jd\u0119, spotka\u0142em najdziwniejszego starego
      Kruka. Ma gdzie\u015B tu sklepik! Mo\u017Ce ma co\u015B, na co mo\u017Cna by
      wymieni\u0107 te drobiazgi?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "Id\u0119 da\u0107 odpocz\u0105\u0107 skrzyd\u0142om po tak okropnym
      dniu!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "Nie martw si\u0119, ju\u017C mnie nie ma..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "Pish posh - A teraz wyno\u015Bcie si\u0119! Wynocha z mojej alejki!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "Znasz tego ptaka tam? Uciek\u0142, gdy koty zacz\u0119\u0142y krzycze\u0107:
      \u201EZJEDZ J\u0104! ZJEDZ J\u0104!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Dzi\u0119ki\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "Mia\u0142am nadziej\u0119, \u017Ce Arnesto... przyjdzie, ale tak
      si\u0119 ciesz\u0119, \u017Ce widz\u0119 ciebie!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "Znalaz\u0142e\u015B mnie!! By\u0142em TAK przestraszony!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: Tally Ho, drogi przyjacielu! - Tak. Ruszaj!
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "..ale co wa\u017Cniejsze - PROSZ\u0118, POM\xD3\u017BCIE MI ODZYSKA\u0106
      \u200B\u200BMOJE PRZEK\u0104SKI!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "Och, chyba te\u017C utkn\u0105\u0142 tam m\u0142ody ptaszek. Wygl\u0105dasz
      do niej bardzo podobnie! Tak! Tak, rzeczywi\u015Bcie!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "Dajcie im porz\u0105dnego ku*asa! To powinno ich czego\u015B nauczy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "No c\xF3\u017C, te bestie trzyma\u0142y mnie z daleka wystarczaj\u0105co
      d\u0142ugo."
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "Nie za bardzo sple\u015Bnia\u0142e... ale wystarczaj\u0105co, \u017Ceby
      doda\u0107 troch\u0119 smaku! \u017Badne inne si\u0119 nie nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "Banda kundli upodoba\u0142a sobie moj\u0105 ulubion\u0105 alejk\u0119.
      Maj\u0105 tu najwi\u0119kszy wyb\xF3r, widzisz\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "WSPANIALE, m\xF3j drogi ptaszku! Dzi\u0119kuj\u0119 bardzo!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "Uhhh. Jestem troch\u0119 zaj\u0119ty-"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "Czy m\xF3g\u0142by\u015B pom\xF3c takiemu starszemu panu jak ja,
      kt\xF3ry ma dylemat?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "Wygl\u0105dasz m\u0142odo i energicznie, jeste\u015B na tyle silny,
      \u017Ce mo\u017Cesz wystraszy\u0107 jednego lub dwa KOTY!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: "POWIEM, m\xF3j dobry przyjacielu!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "Och! We\u017A to sobie do serca. To najmniej, co mog\u0119 zrobi\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Znajdziesz kogo\u015B, z kim b\u0119dziesz m\xF3g\u0142 porozmawia\u0107\u2026
      Niedawno spotka\u0142em tu ptaka! M\xF3wi\u0142 z dziwnym akcentem."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "Jest nas tu mn\xF3stwo! My, go\u0142\u0119bie, mamy silne geny
      *puszcza oko*"
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "Och, nie wr\xF3c\u0119 tam. Nigdy w \u017Cyciu ich nie spotka\u0142em\u2026
      i troch\u0119 mnie przera\u017Caj\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "Ach, chleb, kt\xF3ry mu si\u0119 nale\u017Cy. Co za SZALONA noc.
      Podzi\u0119kuj Wingo ode mnie!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "Wingo kaza\u0142 mi to do ciebie przynie\u015B\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "Wygl\u0105dasz\u2026 znajomo? Dziwne."
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Oczywi\u015Bcie, \u017Ce tak."
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: "...radz\u0119 sobie z niewielk\u0105 pomoc\u0105 przyjaci\xF3\u0142?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "Nie mo\u017Cesz tego zrobi\u0107 sam? Nie wyrazi\u0142em na to
      zgody?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Skoro i tak jedziesz, mo\u017Cesz im przynie\u015B\u0107 chleb,
      kt\xF3ry jestem ci winien?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: To...nie jest pomocne. Kto to jest?
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "MUSISZ ich pozna\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "ALE czy kto\u015B ci powiedzia\u0142, \u017Ce wygl\u0105dasz DOK\u0141ADNIE
      jak kto\u015B, kogo znam? Podejrzanie identycznie *MRU\u017BENIE OKA*"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
