MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47017676951552
    m_Localized: "Masz racj\u0119... Wszystkie moje kwiaty-"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Wszystkie moje kwiaty-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "W KA\u017BDYM RAZIE *Nie pyta\u0142em tutaj o ca\u0142\u0105 histori\u0119
      twojego \u017Cycia*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Mam takie stare gniazdo w parku, je\u015Bli chcesz? Wymaga remontu,
      ale wci\u0105\u017C... jest dobre."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: "W porz\u0105dku"
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "\u015AWIETNIE! Pod\u0105\u017Caj za mn\u0105 do swojego nowego
      domu!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "Pu\u015B\u0107 przycisk lotu i po prostu szybuj w d\xF3\u0142.
      Szybkie latanie jest \u0142atwe. Latanie fajne? To umiej\u0119tno\u015B\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "U\u017Cyj WASD lub prawego dr\u0105\u017Cka, kt\xF3rych nauczy\u0142a
      ci\u0119 Birdadette, aby kontrolowa\u0107 kierunek lotu. Nie walcz z wiatrem
      \u2013 dostosuj si\u0119 do niego."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Dobra, cz\u0142owieku. Znasz podstawy, ale chcesz wi\u0119cej!
      Pierwsze, co? Start."
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "Rozlu\u017Anij pi\xF3ra. Niebo jest ch\u0142odne. Tylko wygl\u0105da
      na du\u017Ce. No dobra, tak, jest ogromne. Ale dasz sobie rad\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Hej, ma\u0142y! Jeste\u015B gotowy nauczy\u0107 si\u0119 kilku
      zajebistych ruch\xF3w?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Mo\u017Ce frytki. Mo\u017Ce chleb. Mo\u017Ce co\u015B, co kszta\u0142tuje
      charakter. Je\u015Bli co\u015B si\u0119 chwieje, mo\u017Ce nie."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Kosze na \u015Bmieci s\u0105 jak tajemnicze pude\u0142ka! U\u017Cyj
      przycisku E LUB X, aby wej\u015B\u0107 w interakcj\u0119! Nigdy nie wiesz,
      co dostaniesz!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "Kiedy wska\u017Anik kupy si\u0119 ko\u0144czy? Trzeba je\u015B\u0107.
      \u015Amieciowe przek\u0105ski go uzupe\u0142niaj\u0105. Natura jest PI\u0118KNA."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "A teraz WA\u017BNA cz\u0119\u015B\u0107. U\u017Cyj LEWEGO KLIKU
      LUB PRAWEGO SPUSTU, \u017Ceby zrobi\u0107 kup\u0119 tym irytuj\u0105cym ludziom!
      I PRAWEGO KLIKU LUB LEWEGO SPUSTU, \u017Ceby celowa\u0107, \u017Ceby mniej
      marnowa\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "TAK!! Wrzu\u0107 to do swojego ekwipunku! To twoja kiesze\u0144
      na skarby! Naci\u015Bnij I LUB PAD KIERUNKOWY W G\xD3R\u0118, aby sprawdzi\u0107,
      co masz."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "No dobra, wi\u0119c jak to jest \u2013 widzisz: b\u0142yszcz\u0105ce?
      Albo chrupi\u0105ce? Albo co\u015B w kszta\u0142cie jedzenia? Mo\u017Cesz je
      podnie\u015B\u0107! Wystarczy nacisn\u0105\u0107 F LUB Y, \u017Ceby je z\u0142apa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "By\u0142o w koszu na \u015Bmieci!! A to znaczy, \u017Ce jest premium."
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "O m\xF3j Bo\u017Ce! Cze\u015B\u0107!! Jeste\u015B tutaj!! Dobra,
      dobra, dobra, nie panikuj, ale znalaz\u0142am NAJLEPSZE rzeczy!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "Uda\u0142o Ci si\u0119!!! Jeste\u015B najodwa\u017Cniejszym ptakiem,
      jakiego znam. Co nie jest wysoko postawion\u0105 poprzeczk\u0105, ale i tak!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\u017Bartuj\u0119, POTRZEBUJ\u0118 mojej lampki nocnej. TERAZ!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Och. W porz\u0105dku. Ca\u0142kowicie w porz\u0105dku. Po prostu\u2026
      Nigdy wi\u0119cej nie zasn\u0119. Mo\u017Cemy wi\u0119cej \u0107wiczy\u0107
      skradanie si\u0119. To dobrze. Lubi\u0119 \u0107wiczy\u0107. \u0106wiczenia
      s\u0105 bezpieczne."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "UDA CI SI\u0118?! Och, dzi\u0119ki Bogu. Dobra, dobra. Przekradnij
      si\u0119 obok ludzi. U\u017Cywaj przedmiot\xF3w jako os\u0142ony. Je\u015Bli
      ci\u0119 zobacz\u0105\u2026 lepiej przesu\u0144 te ma\u0142e st\xF3pki!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "To w\u0142a\u015Bciwie moja lampka nocna. S\u0142oik ze \u015Bwietlikami.
      Nie mog\u0119 bez niej zasn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "Czujesz si\u0119 pewnie? Potrzebuj\u0119 pomocy. Zgubi\u0142em\u2026
      kapelusz\u2026 w teatrze! A tam pe\u0142no ludzi!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Aby biec sprintem, przytrzymaj LEWY SHIFT LUB L3. To wy\u0142\u0105czy
      Ci\u0119 z trybu skradania, wi\u0119c b\u0105d\u017A szybki! Je\u015Bli zobaczysz
      co\u015B, czego chcesz\u2026 z\u0142ap to klawiszem F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Przytrzymaj LEWY CTRL LUB LEWY BUMPER i poruszaj si\u0119 powoli.
      Trzymaj si\u0119 z ty\u0142u. Skrzynek. \u0141awek. P\u0142ot\xF3w. Dekoracyjnych
      krzew\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Maj\u0105 tendencj\u0119 do rzucania przedmiotami, kopania lub
      gonienia ci\u0119, je\u015Bli ci\u0119 zauwa\u017C\u0105. Wi\u0119c je\u015Bli
      chcesz by\u0107 niewidzialny\u2026 musisz si\u0119 skrada\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "Brzmi szalenie, wiem. Teraz przewa\u017Cnie tylko nas goni\u0105
      i na nas krzycz\u0105. Straszne! Ludzie s\u0105 nieprzewidywalni."
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Byli\u015Bmy bohaterami! Podniebnymi pos\u0142a\u0144cami! Male\u0144kimi,
      pierzastymi legendami dostaw!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Czy wiesz, \u017Ce legenda g\u0142osi, i\u017C kiedy\u015B pomagali\u015Bmy
      ludziom? Nosili\u015Bmy dla nich poczt\u0119 na tysi\u0105ce kilometr\xF3w!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Prawie zniszczy\u0142em te\u017C swoj\u0105 kryj\xF3wk\u0119!!
      Ci ludzie tam zrzucili ze mnie upierzenie!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Och, to ty! Musisz przesta\u0107 mnie straszy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
