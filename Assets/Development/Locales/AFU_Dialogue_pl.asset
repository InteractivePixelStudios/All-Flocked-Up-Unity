  m_TableData:
  - m_Id: 47017676951552
    m_Localized: "Masz racj\u0119... Wszystkie moje kwiaty-"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Wszystkie moje kwiaty-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "W KA\u017BDYM RAZIE *Nie pyta\u0142em tutaj o ca\u0142\u0105 histori\u0119
      twojego \u017Cycia*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "Mam takie stare gniazdo w parku, je\u015Bli chcesz? Wymaga remontu,
      ale wci\u0105\u017C... jest dobre."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: "W porz\u0105dku"
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "\u015AWIETNIE! Pod\u0105\u017Caj za mn\u0105 do swojego nowego
      domu!"
    m_Metadata:
      m_Items: []
