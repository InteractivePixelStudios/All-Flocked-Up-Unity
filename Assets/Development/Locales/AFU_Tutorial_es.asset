  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: "\xA1WASD para caminar!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "\xA1Pulsa la barra espaciadora para saltar!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "\xA1Salta y vuelve a pulsar la barra espaciadora para empezar a
      volar!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "\xA1Hay otras palomas que deber\xEDas ir a ver!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "Coobert te ense\xF1ar\xE1 c\xF3mo escabullirse."
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle puede decirte d\xF3nde encontrar comida."
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "\xA1Corre contra Arnesto para poner a prueba tus habilidades!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "\xA1Cuando creas que est\xE1s listo, puedes tomar el autob\xFAs
      de Coober hasta el mercado de Pigeonton!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: Puedes usar E o X para interactuar o hablar con otras palomas.
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: "Si necesitas volver a ver los controles, puedes encontrarlos en
      el men\xFA PAUSA."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "Al pulsar M o la cruceta hacia arriba se mostrar\xE1 el mapa."
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "La tecla I o el bot\xF3n SELECCIONAR abrir\xE1n tu WINGVENTORY.
      Cualquier art\xEDculo o accesorio que encuentres puede ir aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "\xA1No pierdas de vista tu MINIMAPA y tu BR\xDAJULA!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: "\xBFEl BLANCO? \xBFQu\xE9 es lo que mejor hacemos? \xA1CACA! \xA1Aseg\xFArate
      de mantener esa barriga llena!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "\xBFEsa barra VERDE? La resistencia te ayuda a CORRER y AGITAR
      para escapar del peligro. O a entrar... T\xFA decides..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "\xBFVes tu cara ah\xED? \xA1Un p\xE1jaro sano es importante, as\xED
      que aseg\xFArate de lucir siempre lo mejor posible!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "Peep, mi amigo emplumado ... \xA1Tienes mucho que aprender!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
