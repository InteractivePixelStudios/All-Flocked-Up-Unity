  m_TableData:
  - m_Id: 478356196741120
    m_Localized: "G\u0141\xD3WNE ZADANIA"
    m_Metadata:
      m_Items: []
  - m_Id: 478415525171200
    m_Localized: ZADANIA POBOCZNE
    m_Metadata:
      m_Items: []
  - m_Id: 478567350587392
    m_Localized: "Zadanie \u015Bledzenia"
    m_Metadata:
      m_Items: []
  - m_Id: 12733910025687040
    m_Localized: "Podst\u0119pny Dziobak"
    m_Metadata:
      m_Items: []
  - m_Id: 12734028586078208
    m_Localized: "Naucz si\u0119 by\u0107 przebieg\u0142ym"
    m_Metadata:
      m_Items: []
  - m_Id: 12734078028533760
    m_Localized: "W\u015Blizgnij si\u0119 do teatru na Cooberta"
    m_Metadata:
      m_Items: []
  - m_Id: 12734130943873024
    m_Localized: "W\u015Blizgn\u0105\u0107 si\u0119 do teatru"
    m_Metadata:
      m_Items: []
  - m_Id: 12734174208118784
    m_Localized: "Coobert zobaczy\u0142 w teatrze jakie\u015B drobiazgi... Mo\u017Ce
      sam je we\u017Amiesz?"
    m_Metadata:
      m_Items: []
  - m_Id: 12734229006700544
    m_Localized: Zbierz drobiazgi
    m_Metadata:
      m_Items: []
  - m_Id: 12734258014507008
    m_Localized: Zbierz drobiazgi
    m_Metadata:
      m_Items: []
  - m_Id: 12736719018184704
    m_Localized: Recykling, jedzenie, powtarzanie
    m_Metadata:
      m_Items: []
  - m_Id: 12736818372857856
    m_Localized: "Dowiedz si\u0119, gdzie znale\u017A\u0107 jedzenie i jak zadba\u0107
      o czysto\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736838291607552
    m_Localized: "Dowiedz si\u0119, gdzie znale\u017A\u0107 jedzenie i jak zadba\u0107
      o czysto\u015B\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 12736858042585088
    m_Localized: "\u015Amieci...Ptak? A mo\u017Ce po prostu g\u0142odny..."
    m_Metadata:
      m_Items: []
  - m_Id: 12736881279029248
    m_Localized: "Czasami trzeba pracowa\u0107 na jedzenie"
    m_Metadata:
      m_Items: []
  - m_Id: 12736899411005440
    m_Localized: Brudni ludzie
    m_Metadata:
      m_Items: []
  - m_Id: 12737008773287936
    m_Localized: "Znajd\u017A pobliskie \u015Bmieci i wyrzu\u0107 je do \u015Bmietnika"
    m_Metadata:
      m_Items: []
  - m_Id: 12737056970035200
    m_Localized: "Odbierz swoj\u0105 NAGROD\u0118!"
    m_Metadata:
      m_Items: []
  - m_Id: 12737099546415104
    m_Localized: "Wejd\u017A w interakcj\u0119 ze \u015Bmieciami i znajd\u017A przek\u0105ski!"
    m_Metadata:
      m_Items: []
  - m_Id: 315913797554176
    m_Localized: AKCEPTUJ ZADANIE
    m_Metadata:
      m_Items: []
  - m_Id: 315952259321856
