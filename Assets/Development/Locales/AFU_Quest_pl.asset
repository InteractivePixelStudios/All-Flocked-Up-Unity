    m_Metadata:
      m_Items: []
  - m_Id: 22816668700672
    m_Localized: "Cz\u0119\u015B\u0107 druga korporacyjna"
    m_Metadata:
      m_Items: []
  - m_Id: 22907206946816
    m_Localized: "Naucz si\u0119 kilku rzeczy!"
