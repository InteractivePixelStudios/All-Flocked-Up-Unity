  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: "Si vous avez besoin de revoir les commandes, vous les trouverez
      dans le menu PAUSE\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: Vous pouvez utiliser E ou X pour interagir ou parler avec d'autres
      pigeons.
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "D\xE8s que vous vous sentirez pr\xEAt, vous pourrez prendre le
      Coober pour aller au march\xE9 de Pigeonton !"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "Affrontez Arnesto pour tester vos comp\xE9tences !"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle peut vous indiquer o\xF9 trouver de la nourriture"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert vous montrera comment vous faufiler autour
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Il y a quelques autres pigeons que vous devriez aller voir !
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Sautez puis appuyez \xE0 nouveau sur Espace pour commencer \xE0
      voler !"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Appuyez sur Espace pour sauter !
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: WASD pour marcher !
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "Peep, mon ami \xE0 plumes... Tu as encore tellement \xE0 apprendre
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "Tu vois ton visage l\xE0 ? Un oiseau en bonne sant\xE9 est important,
      alors assure-toi d'avoir toujours une apparence impeccable !"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "Cette barre VERTE\_? L\u2019endurance vous permet de COURIR et
      de BATTRE DES BATTEMENTS D\u2019AIR pour vous sortir du danger. Ou de vous
      y engager\u2026 \xC0 vous de choisir\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: Le BLANC ? Qu'est-ce qu'on fait de mieux ? CACA ! N'oubliez pas
      de bien remplir votre ventre !
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "Gardez toujours un \u0153il sur votre MINI-CARTE et votre BOUSSOLE
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "Appuyez sur le bouton I ou S\xC9LECTIONNER pour ouvrir votre INVENTAIRE.
      Vous pourrez y placer tous les ARTICLES et ACCESSOIRES que vous y trouverez."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "Appuyer sur M ou sur la fl\xE8che directionnelle haut affichera
      votre carte."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
