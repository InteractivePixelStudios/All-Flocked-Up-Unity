  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: "Si vous avez besoin de revoir les commandes, vous les trouverez
      dans le menu PAUSE\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: Vous pouvez utiliser E ou X pour interagir ou parler avec d'autres
      pigeons.
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "D\xE8s que vous vous sentirez pr\xEAt, vous pourrez prendre le
      Coober pour aller au march\xE9 de Pigeonton !"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "Affrontez Arnesto pour tester vos comp\xE9tences !"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle peut vous indiquer o\xF9 trouver de la nourriture"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert vous montrera comment vous faufiler autour
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Il y a quelques autres pigeons que vous devriez aller voir !
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Sautez puis appuyez \xE0 nouveau sur Espace pour commencer \xE0
      voler !"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: Appuyez sur Espace pour sauter !
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: WASD pour marcher !
    m_Metadata:
      m_Items: []
