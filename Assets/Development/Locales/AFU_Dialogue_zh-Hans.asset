    m_Localized: "\u4F7F\u7528Birdadette\u6559\u4F60\u7684WASD\u952E\u6216\u53F3\u6447\u6746\u6765\u63A7\u5236\u98DE\u884C\u65B9\u5411\u3002\u4E0D\u8981\u4E0E\u98CE\u5BF9\u6297\u2014\u2014\u987A\u5176\u81EA\u7136\u3002"
