  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: "WASD at g\xE5!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "Tryk p\xE5 mellemrumsknappen for at hoppe!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Hop, og tryk derefter p\xE5 Mellemrum igen for at begynde at flyve!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Der er et par andre duer, du bare skal se!
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert vil vise dig, hvordan du sniger dig rundt
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle kan fort\xE6lle dig, hvor du kan finde mad"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "K\xF8r l\xF8b mod Arnesto for at teste dine evner."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "N\xE5r som helst du tror, \u200B\u200Bdu er klar, kan du tage Coober
      til Pigeonton Market!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: Du kan bruge E eller X til at interagere eller tale med andre duer
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: Hvis du har brug for at se knapperne igen, kan du finde dem i PAUSE-menuen!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
