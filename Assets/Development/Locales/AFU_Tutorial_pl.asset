  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: WASD - chodzenie!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "Naci\u015Bnij spacj\u0119, aby skoczy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Skocz i naci\u015Bnij spacj\u0119 ponownie, aby zacz\u0105\u0107
      lata\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "Jest jeszcze kilka go\u0142\u0119bi, kt\xF3re powiniene\u015B zobaczy\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "Coobert poka\u017Ce Ci, jak si\u0119 SKRADA\u0106"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle mo\u017Ce ci powiedzie\u0107, gdzie znale\u017A\u0107 jedzenie"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "\u015Acigaj si\u0119 z Arnesto i sprawd\u017A swoje umiej\u0119tno\u015Bci!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "Kiedy tylko poczujesz, \u017Ce jeste\u015B gotowy, mo\u017Cesz
      wsi\u0105\u015B\u0107 do Coobera i pojecha\u0107 na Pigeonton Market!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "Za pomoc\u0105 klawiszy E i X mo\u017Cesz nawi\u0105za\u0107 interakcj\u0119
      lub porozmawia\u0107 z innymi go\u0142\u0119biami"
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: "Je\u015Bli chcesz ponownie zobaczy\u0107 elementy steruj\u0105ce,
      znajdziesz je w menu PAUZA!"
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "Naci\u015Bni\u0119cie przycisku M lub D-PAD UP spowoduje wy\u015Bwietlenie
      MAP"
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "Przycisk \u201EI\u201D lub \u201ESELECT\u201D otworzy Tw\xF3j WINGVENTORY.
      Mo\u017Cesz tu umie\u015Bci\u0107 wszystkie znalezione PRZEDMIOTY lub AKCESORIA."
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "Zawsze miej pod r\u0119k\u0105 MINIMAP\u0118 i KOMPAS!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: "BIA\u0141Y? Co robimy najlepiej? KUP\u0118! Upewnij si\u0119, \u017Ce
      masz pe\u0142ny brzuch!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "Ten ZIELONY pasek? Wytrzyma\u0142o\u015B\u0107 pomaga ci BIEGA\u0106
      i MACHA\u0106 PI\u0141KAMI, \u017Ceby uciec z niebezpiecze\u0144stwa. Albo
      w... Wyb\xF3r nale\u017Cy do ciebie..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "Widzisz swoj\u0105 twarz? Zdrowy ptak jest wa\u017Cny, wi\u0119c
      zadbaj o to, \u017Ceby zawsze wygl\u0105da\u0107 jak najlepiej!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "Peep, m\xF3j pierzasty przyjacielu... Musisz si\u0119 jeszcze wiele
      nauczy\u0107!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
