  m_TableData:
  - m_Id: 9050606470615040
    m_Localized: WASD zum Gehen!
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "Dr\xFCcken Sie die Leertaste zum Springen!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Springe und dr\xFCcke dann erneut die Leertaste, um zu fliegen!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: Es gibt noch ein paar andere Tauben, die du dir ansehen solltest!
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert wird dir zeigen, wie man sich herumschleicht
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle kann Ihnen sagen, wo Sie Essen finden k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "Tritt gegen Arnesto an und stelle dein K\xF6nnen unter Beweis!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "Sobald Sie sich bereit f\xFChlen, k\xF6nnen Sie mit dem Coober
      zum Pigeonton Market fahren!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "Mit E oder X k\xF6nnen Sie mit anderen Tauben interagieren oder
      sprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 10091160440590336
    m_Localized: "Falls Sie die Steuerelemente erneut ben\xF6tigen, finden Sie diese
      im PAUSE-Men\xFC!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
