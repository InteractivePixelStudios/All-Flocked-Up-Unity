  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0432\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0439\u0442\u0438 \u0438\u0445
      \u0432 \u043C\u0435\u043D\u044E \u041F\u0410\u0423\u0417\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "\u0414\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0438\u043B\u0438 \u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
      \u0433\u043E\u043B\u0443\u0431\u044F\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043A\u043B\u0430\u0432\u0438\u0448\u0438
      E \u0438\u043B\u0438 X."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "\u0412 \u043B\u044E\u0431\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0433\u043E\u0442\u043E\u0432\u044B, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0435\u0441\u0442\u044C \u043D\u0430 \u043F\u043E\u0435\u0437\u0434
      \u0434\u043E \u0440\u044B\u043D\u043A\u0430 \u041F\u0438\u0434\u0436\u043E\u043D\u0442\u043E\u043D
      \u0432 \u041A\u0443\u0431\u0435\u0440\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "\u041F\u0440\u0438\u043C\u0438\u0442\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
      \u0432 \u0433\u043E\u043D\u043A\u0435 \u0441 \u0410\u0440\u043D\u0435\u0441\u0442\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "\u0420\u0430\u0444\u0444\u043B \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0433\u0434\u0435 \u043D\u0430\u0439\u0442\u0438 \u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: "\u041A\u0443\u0431\u0435\u0440\u0442 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
      \u0432\u0430\u043C, \u043A\u0430\u043A \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "\u0415\u0441\u0442\u044C \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0438\u0434\u043E\u0432 \u0433\u043E\u043B\u0443\u0431\u0435\u0439,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u0430\u043C \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C
      \u043F\u043E\u043B\u0451\u0442, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043F\u0440\u044B\u0436\u043E\u043A,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043F\u0440\u043E\u0431\u0435\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u0440\u043E\u0431\u0435\u043B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: "WASD \u0434\u043B\u044F \u0445\u043E\u0434\u044C\u0431\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "\u041F\u0438\u043F, \u043C\u043E\u0439 \u043F\u0435\u0440\u043D\u0430\u0442\u044B\u0439
      \u0434\u0440\u0443\u0433... \u0422\u0435\u0431\u0435 \u0435\u0449\u0451 \u043C\u043D\u043E\u0433\u043E\u043C\u0443
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "\u0412\u0438\u0434\u0438\u0448\u044C \u0441\u0432\u043E\u0451 \u043B\u0438\u0446\u043E?
      \u0417\u0434\u043E\u0440\u043E\u0432\u0430\u044F \u043F\u0442\u0438\u0446\u0430
      \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043B\u0435\u0434\u0438 \u0437\u0430
      \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "\u042D\u0442\u0430 \u0417\u0415\u041B\u0415\u041D\u0410\u042F \u043F\u043E\u043B\u043E\u0441\u043A\u0430?
      \u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u0432\u0430\u043C \u0411\u0415\u0416\u0410\u0422\u042C \u0438 \u041C\u0410\u0428\u0423\u0422\u0421\u042F,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0438\u0437 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u0418\u043B\u0438...
      \u0412\u044B\u0431\u043E\u0440 \u0437\u0430 \u0432\u0430\u043C\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: "\u0411\u0415\u041B\u042B\u0415? \u0427\u0442\u043E \u043C\u044B
      \u0443\u043C\u0435\u0435\u043C \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E?
      \u041A\u0430\u043A\u0430\u0442\u044C! \u0421\u043B\u0435\u0434\u0438\u0442\u0435
      \u0437\u0430 \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u0432\u0430\u0448
      \u0436\u0438\u0432\u043E\u0442 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B
      \u0441\u044B\u0442\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "\u0412\u0441\u0435\u0433\u0434\u0430 \u0441\u043B\u0435\u0434\u0438\u0442\u0435
      \u0437\u0430 \u0441\u0432\u043E\u0435\u0439 \u043C\u0438\u043D\u0438-\u043A\u0430\u0440\u0442\u043E\u0439
      \u0438 \u043A\u043E\u043C\u043F\u0430\u0441\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "\u041D\u0430\u0436\u0430\u0442\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
      I \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0438 SELECT \u043E\u0442\u043A\u0440\u043E\u0435\u0442
      \u0432\u0430\u0448 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u043A\u0440\u044B\u043B\u044C\u0435\u0432.
      \u041B\u044E\u0431\u044B\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435
      \u0432\u0430\u043C\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438\u043B\u0438
      \u0430\u043A\u0441\u0435\u0441\u0441\u0443\u0430\u0440\u044B \u043C\u043E\u0436\u043D\u043E
      \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "\u041D\u0430\u0436\u0430\u0442\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
      M \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0438 \u0412\u0412\u0415\u0420\u0425
      \u043D\u0430 D-PAD \u043E\u0442\u043E\u0431\u0440\u0430\u0437\u0438\u0442 \u0432\u0430\u0448\u0443
      \u041A\u0410\u0420\u0422\u0423."
    m_Metadata:
      m_Items: []
