    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47017676951552
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: 'Buuuuttttttttt..... you MIGHT want to sneak into the park using
      "LEFT CTRL"...whatever that means...

'
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: 'Try heading EAST to the most popular park in town. There''s bounmd
      to be sticks there.

'
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: Test
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Oh ! C'est toi ! Arr\xEAte de me faire une peur bleue !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Ils ont failli d\xE9truire ma cachette aussi\_! Ces humains m'ont
      arrach\xE9 le plumage\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Saviez-vous que la l\xE9gende raconte que nous avons jadis aid\xE9
      les humains ? Nous avons transport\xE9 leur courrier sur des milliers de kilom\xE8tres
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Nous \xE9tions des h\xE9ros ! Des messagers du ciel ! De minuscules
      l\xE9gendes de la livraison, tout en plumes !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\xC7a para\xEEt dingue, je sais. Maintenant, ils se contentent
      de nous courir apr\xE8s en criant. C'est trop flippant ! Les humains sont impr\xE9visibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Ils ont tendance \xE0 vous lancer des objets, \xE0 vous donner
      des coups de pied ou \xE0 vous poursuivre s'ils vous rep\xE8rent. Alors, si
      vous voulez \xEAtre invisible\u2026 il faut se faufiler."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Maintenez la touche CTRL gauche ou la touche GAUCHE enfonc\xE9e
      et d\xE9placez-vous lentement. Restez \xE0 couvert derri\xE8re des objets\_:
      bo\xEEtes, bancs, cl\xF4tures, arbustes d\xE9coratifs."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Pour sprinter, maintenez la touche MAJ GAUCHE ou L3 enfonc\xE9e.
      Vous sortirez alors du mode furtif, alors d\xE9p\xEAchez-vous\_! Si vous voyez
      quelque chose qui vous int\xE9resse\u2026 attrapez-le avec F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "Vous vous sentez en confiance ? J'ai besoin d'aide. J'ai perdu
      mon chapeau au th\xE9\xE2tre ! Et il y a une foule immense !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: C'est en fait ma veilleuse. Un bocal de lucioles. Je ne peux pas
      dormir sans elle.
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Tu vas le faire ?! Ouf, merci mon Dieu ! Bon, d'accord. Faufile-toi
      devant les humains. Utilise des objets pour te cacher. S'ils te voient\u2026
      bouge-toi vite !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Oh. C'est bon. Parfait. Je vais juste\u2026 ne plus jamais dormir.
      On pourra s'entra\xEEner \xE0 se faufiler davantage. C'est bien. J'aime m'entra\xEEner.
      S'entra\xEEner, c'est sans danger."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: Je plaisante, j'ai BESOIN de ma veilleuse. MAINTENANT !
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "TU L'AS FAIT !!! Tu es l'oiseau le plus courageux que je connaisse.
      Ce n'est pas un exploit, mais quand m\xEAme !!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "Oh mon Dieu ! Salut !! Tu es l\xE0 !! Bon, bon, bon, pas de panique,
      mais j'ai trouv\xE9 des trucs g\xE9niaux !!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "C'\xE9tait dans une poubelle !! Ce qui signifie que c'est de premi\xE8re
      qualit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Alors voil\xE0\u2026 vous voyez, \xE7a brille\_? C\u2019est croustillant\_?
      \xC7a a vaguement la forme d\u2019un aliment\_? Vous pouvez le ramasser\_!
      Appuyez simplement sur F ou Y pour l\u2019attraper."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "OUI\_! Range-le dans ton inventaire\_! C\u2019est ta poche au tr\xE9sor\_!
      Appuie sur I OU SUR LA FL\xC8CHE DIRECTIONNELLE HAUT pour voir ce que tu as
      obtenu."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Voici la partie la plus importante\_: utilisez le clic gauche ou
      la g\xE2chette droite pour d\xE9f\xE9quer sur ces humains importuns\_! Et le
      clic droit ou la g\xE2chette gauche pour viser et gaspiller moins\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: Quand on a besoin de se soulager, il faut manger. Les en-cas issus
      de la poubelle permettent de se remplir. La nature est magnifique.
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Les poubelles sont comme des bo\xEEtes myst\xE8res ! Utilisez les
      touches E ou X pour interagir ! On ne sait jamais ce qu'on va trouver !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Des frites, peut-\xEAtre. Du pain, peut-\xEAtre. Quelque chose
      qui forge le caract\xE8re. Si \xE7a gigote, mieux vaut s'abstenir."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Salut petit bonhomme !! Pr\xEAt \xE0 apprendre des mouvements de
      malade ?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "D\xE9tends-toi. Le ciel est calme. Il para\xEEt immense, c'est
      tout. Bon, d'accord, il est gigantesque. Mais tout ira bien."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "OK, mec. Tu connais les bases, mais tu en veux plus\_! Premi\xE8re
      \xE9tape\_? Le d\xE9collage."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Utilisez les touches WASD OU LE JOUET DROIT, comme Birdadette vous
      l'a appris, pour contr\xF4ler votre trajectoire. Ne luttez pas contre le vent,
      laissez-vous porter."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "Rel\xE2chez le bouton de pilotage et planez jusqu'au sol. Voler
      vite, c'est facile. Voler avec style\_? \xC7a, c'est du talent."
    m_Metadata:
      m_Items: []
  - m_Id: 12859032170582016
    m_Localized: "Approchez-vous. Envie de plonger rapidement\_? Utilisez Q. Une
      approche plus douce\_? Restez en vol stationnaire avec G ou laissez-vous glisser."
    m_Metadata:
      m_Items: []
  - m_Id: 12859043797192704
    m_Localized: "Dernier mouvement. Perchez-vous. Les endroits o\xF9 vous pouvez
      vous percher sont signal\xE9s par un petit symbole pratique. Alignez-vous lentement,
      pieds en avant. Laissez-vous porter. Appuyez sur E d\xE8s que vous voyez l'ic\xF4ne\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859055969062912
    m_Localized: "Maintenant, montrez-moi ce que vous savez faire ! Cherchez des
      affiches de course comme celle-ci et prenez votre envol ! Montrez-moi ce dont
      vous \xEAtes capable !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
