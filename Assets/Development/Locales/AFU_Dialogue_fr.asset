%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47017676951552
    m_Localized: Salut jeune homme ! Tu as l'air perdu ? Besoin d'aide ?
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "Puisque vous \xEAtes nouveau ici, permettez-moi de vous donner
      quelques conseils."
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: Tout mon flo-
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "Bref, *je ne t'ai pas demand\xE9 de raconter toute ta vie ici*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "J'ai un vieux nid dans le coin si \xE7a t'int\xE9resse ? Il a besoin
      d'\xEAtre retap\xE9, mais il est encore... bien."
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "V\xE9rifie le nid ! J'en ai peut-\xEAtre laiss\xE9 tra\xEEner quelques-uns
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: Bien
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "Super ! C'est tout pr\xE8s des tables de pique-nique !"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "De mon temps, on dormait sur des piquets et on \xE9tait HEUREUX.
      *RIRE* Bon, peut-\xEAtre qu'on pourrait l'agr\xE9menter de quelques branches
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "Les nids de pigeons sont-ils cens\xE9s \xEAtre aussi... laids ?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858535531433984
    m_Localized: AHHHHHH!
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "Oh ! C'est toi ! Arr\xEAte de me faire une peur bleue !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "Ils ont failli d\xE9truire ma cachette aussi\_! Ces humains m'ont
      arrach\xE9 le plumage\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "Saviez-vous que la l\xE9gende raconte que nous avons jadis aid\xE9
      les humains ? Nous avons transport\xE9 leur courrier sur des milliers de kilom\xE8tres
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "Nous \xE9tions des h\xE9ros ! Des messagers du ciel ! De minuscules
      l\xE9gendes de la livraison, tout en plumes !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\xC7a para\xEEt dingue, je sais. Maintenant, ils se contentent
      de nous courir apr\xE8s en criant. C'est trop flippant ! Les humains sont impr\xE9visibles."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "Ils ont tendance \xE0 vous lancer des objets, \xE0 vous donner
      des coups de pied ou \xE0 vous poursuivre s'ils vous rep\xE8rent. Alors, si
      vous voulez \xEAtre invisible\u2026 il faut se faufiler."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "Maintenez la touche CTRL gauche ou la touche GAUCHE enfonc\xE9e
      et d\xE9placez-vous lentement. Restez \xE0 couvert derri\xE8re des objets\_:
      bo\xEEtes, bancs, cl\xF4tures, arbustes d\xE9coratifs."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "Pour sprinter, maintenez la touche MAJ GAUCHE ou L3 enfonc\xE9e.
      Vous sortirez alors du mode furtif, alors d\xE9p\xEAchez-vous\_! Si vous voyez
      quelque chose qui vous int\xE9resse\u2026 attrapez-le avec F."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "Vous vous sentez en confiance ? J'ai besoin d'aide. J'ai perdu
      ce joli porte-cl\xE9s dans le th\xE9\xE2tre ! Et il y a une foule immense !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "Si tu arrives \xE0 l'attraper, je te le laisse ! Tu pourras peut-\xEAtre
      lui servir plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "Essaie de te faufiler discr\xE8tement devant les humains. S'ils
      te voient\u2026 d\xE9p\xEAche-toi de bouger !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "Oh. Pas de probl\xE8me. Je vais aller le chercher moi-m\xEAme.
      C'est bien. J'aime m'entra\xEEner. S'entra\xEEner, c'est sans danger."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "Je plaisante. C'est \xE0 toi de jouer. Vas-y !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "TU L'AS FAIT !!! Tu es l'oiseau le plus courageux que je connaisse.
      Ce n'est pas un exploit, mais quand m\xEAme !!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "Oh mon Dieu ! Salut !! Tu es l\xE0 !! Bon, bon, bon, pas de panique,
      mais j'ai trouv\xE9 des trucs g\xE9niaux !!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "C'\xE9tait dans une poubelle !! Ce qui signifie que c'est de premi\xE8re
      qualit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "Alors voil\xE0\u2026 vous voyez quelque chose de brillant\_? De
      croustillant\_? Ou qui a vaguement la forme d\u2019un aliment\_? Foncez et
      mangez\_! Si vous ne pouvez pas le manger, essayez de l\u2019attraper en maintenant
      la touche F ou X enfonc\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "OUI\_! Range-le dans ton inventaire\_! C\u2019est ta poche au tr\xE9sor\_!
      Appuie sur I OU SUR LA FL\xC8CHE DIRECTIONNELLE HAUT pour voir ce que tu as
      obtenu."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "Voici la partie la plus importante\_: utilisez le clic gauche ou
      la g\xE2chette droite pour d\xE9f\xE9quer sur ces humains importuns\_! Et le
      clic droit ou la g\xE2chette gauche pour viser et gaspiller moins\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: Quand on a besoin de se soulager, il faut manger. Les en-cas issus
      de la poubelle permettent de se remplir. La nature est magnifique.
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "Les poubelles sont comme des bo\xEEtes myst\xE8res ! Utilisez les
      touches E ou X pour interagir ! On ne sait jamais ce qu'on va trouver !"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "Des frites, peut-\xEAtre. Du pain, peut-\xEAtre. Quelque chose
      qui forge le caract\xE8re. Si \xE7a gigote, mieux vaut s'abstenir."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "Salut gamin ! Pr\xEAt \xE0 apprendre des mouvements de malade ?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "D\xE9tends-toi. Le ciel est calme. Il para\xEEt immense, c'est
      tout. Bon, d'accord, il est gigantesque. Mais tout ira bien."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "Vous connaissez les bases, mais vous en voulez plus\_! Voler vite,
      c\u2019est facile. Voler avec style\_? \xC7a, c\u2019est du talent."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Besoin de descendre rapidement\_? Utilisez Q. Une approche plus
      douce\_? Restez en vol stationnaire avec G ou laissez-vous glisser."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "Maintenant, montrez-moi ce que vous savez faire ! Cherchez des
      affiches de course comme celle-ci et prenez votre envol ! Montrez-moi ce dont
      vous \xEAtes capable !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: Je vous connais?
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: "H\xC9 !! H\xC9 COO !!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "Je t'ai d\xE9j\xE0 tout appris. Il est temps d'aller emb\xEAter
      d'autres oiseaux !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "Vous voyez ces humains en bas\_? Vous savez ce qu'il vous reste
      \xE0 faire\_! Rendez-moi fier\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "Vous savez o\xF9 trouver \xE0 manger. Vous savez comment rester
      en s\xE9curit\xE9. J'ai gard\xE9 le meilleur pour la fin !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "Rapide\u2026 ? Vous avez mis tellement de temps que j'ai failli
      partir !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: Comment as-tu fait pour arriver ici si vite ?!
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "Essaie d'utiliser cette bouche d'\xE9gout pour prendre de l'\xE9lan
      et augmenter tes chances d'atteindre le sommet de l'immeuble. C'est un endroit
      id\xE9al pour se cacher des humains en col\xE8re !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "Je te dis \xE7a parce que je tiens \xE0 toi\u2026 mais tu as l\u2019air\u2026
      faible. Tu vas te fortifier, mais on a tous besoin d\u2019aide parfois."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "Tout le monde nous conna\xEEt pour faire nos besoins partout. Mais
      il faut d'abord remplir ton r\xE9servoir ! Il doit bien y avoir de la nourriture
      dans le coin."
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "Mais est-ce que quelqu'un vous a d\xE9j\xE0 dit que vous ressemblez
      \xC9NORM\xC9MENT \xE0 quelqu'un que je connais\_? Une ressemblance troublante\_!
      *PLOUFLE LES YEUX*"
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: Vous DEVEZ les rencontrer !
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: "Ce n'est pas tr\xE8s utile. Qui est-ce ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "Puisque tu y vas de toute fa\xE7on, peux-tu leur apporter le pain
      que je leur dois ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "Tu ne peux pas le faire toi-m\xEAme ? Je n'ai pas donn\xE9 mon
      accord pour \xE7a !"
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: ...Je m'en sors avec un peu d'aide de mes amis ?
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "Bien s\xFBr que oui."
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "Tu as l'air\u2026 familier ? \xC9trange."
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "Wingo m'a dit de vous apporter \xE7a ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: Ah, le pain qu'il doit ! Quelle nuit de folie ! Merci Wingo pour
      moi !
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "Oh, je n'y retournerai pas. Je ne les ai jamais rencontr\xE9s de
      ma vie\u2026 et ils m'intimident un peu."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "Nous sommes nombreux ! Nous, les pigeons, avons des g\xE8nes robustes
      *clin d'\u0153il*"
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "Tu trouveras bien quelqu'un \xE0 qui parler\u2026 J'ai crois\xE9
      un oiseau par ici il n'y a pas longtemps ! Il avait un accent bizarre."
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: Oh ! Tenez, prenez ceci pour vous remercier. C'est la moindre des
      choses.
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: JE DIS, mon bon ami !
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "Tu as l'air jeune et vif, assez costaud pour faire peur \xE0 un
      chat ou deux !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "Vous pourriez aider un vieux comme moi \xE0 r\xE9soudre un dilemme
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "Euh... Je suis un peu occup\xE9(e)..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: EXCELLENT mon cher oiseau ! Merci beaucoup !
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "Une meute de chiens errants a \xE9lu domicile dans ma ruelle pr\xE9f\xE9r\xE9e.
      Ils ont un choix de premier ordre ici, vous savez\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "Pas trop moisi\u2026 juste ce qu\u2019il faut pour donner du go\xFBt
      ! Rien d\u2019autre ne conviendra !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "Bref, ces brutes m'ont tenu \xE0 l'\xE9cart assez longtemps."
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "Donne-leur une bonne racl\xE9e de merde ! \xC7a devrait leur apprendre
      la le\xE7on !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "Oh, je crois qu'un oisillon s'est coinc\xE9 l\xE0 aussi. Tu lui
      ressembles beaucoup ! Oui ! Absolument !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "\u2026mais surtout, AIDEZ-MOI \xC0 R\xC9CUP\xC9RER MES COLLATIONS
      !!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: Tally Ho, cher ami ! - Oui. En avant !
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "Vous m'avez trouv\xE9 !! J'ai eu tellement peur !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "J'esp\xE9rais qu'Arnesto viendrait... mais je suis tellement contente
      de te voir !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "Merci\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "Connaissez-vous cet oiseau l\xE0-bas ? Il s'est enfui quand les
      chats sont arriv\xE9s en criant \" MANGEZ-LA ! MANGEZ-LA ! \""
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: Pish posh - Maintenant, allez-vous-en ! Hors de ma ruelle !
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "Ne t'inqui\xE8te pas, je suis parti..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "Je vais aller reposer mes ailes apr\xE8s une journ\xE9e aussi horrible
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "Oh ! Avant de partir, j'ai rencontr\xE9 un vieux corbeau tr\xE8s
      \xE9trange. Il a une boutique dans le coin ! Peut-\xEAtre qu'il aura quelque
      chose contre quoi \xE9changer ces babioles ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "Il tra\xEEne souvent dans les ruelles, mais attention \xE0 ces
      chats errants\_! Vous ne voudriez pas finir la nuit dans une benne \xE0 ordures
      comme moi."
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: J'ai entendu dire que vous cherchiez des babioles ?
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "La boutique est ferm\xE9e. Revenez plus tard\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "Je vois\u2026 Ok, je vois ce qui se passe. De quoi avez-vous besoin\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "Un \xE9change \xE9quitable, n'est-ce pas ? Des babioles contre
      des tr\xE9sors ? Un acte de propri\xE9t\xE9 contre un acte de propri\xE9t\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "Cet \xE9tal est devenu ma prison. Je cherche une rose pour mon
      v\xE9ritable amour. Seules elles peuvent me rendre la libert\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: Tu sais que tu peux simplement partir, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "Voyageur du ciel, charg\xE9 d'un dessein. Dis-moi, les vents te
      murmurent-ils des secrets comme ils le font \xE0 moi ?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "Je comprends. C'est tr\xE8s po\xE9tique."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "Apportez-moi la rose et vous pourrez faire affaire avec moi. En
      attendant, nous sommes ferm\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "Crow trouve des marchandises\u2026 si vous avez des babioles."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
