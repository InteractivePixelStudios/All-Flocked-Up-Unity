  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Tutorial_sv
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: 9c9210c1e5c71a044b015e1b14f66847, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10091160440590336
    m_Localized: "Om du beh\xF6ver se kontrollerna igen hittar du dem i PAUS-menyn!"
    m_Metadata:
      m_Items: []
  - m_Id: 10091154472095744
    m_Localized: "Du kan anv\xE4nda E eller X f\xF6r att interagera eller prata med
      andra duvor."
    m_Metadata:
      m_Items: []
  - m_Id: 10090115752710144
    m_Localized: "N\xE4r du \xE4n tror att du \xE4r redo kan du ta Coober till Pigeonton
      Market!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090101777289216
    m_Localized: "T\xE4vla mot Arnesto f\xF6r att testa dina f\xE4rdigheter."
    m_Metadata:
      m_Items: []
  - m_Id: 10090080671551488
    m_Localized: "Ruffle kan ber\xE4tta var du hittar mat"
    m_Metadata:
      m_Items: []
  - m_Id: 10090048312496128
    m_Localized: Coobert visar dig hur man smyger runt
    m_Metadata:
      m_Items: []
  - m_Id: 10090031031963648
    m_Localized: "Det finns n\xE5gra andra duvor du borde g\xE5 och titta p\xE5!"
    m_Metadata:
      m_Items: []
  - m_Id: 10090015567564800
    m_Localized: "Hoppa och tryck sedan p\xE5 mellanslag igen f\xF6r att b\xF6rja
      flyga!"
    m_Metadata:
      m_Items: []
  - m_Id: 10089984416468992
    m_Localized: "Tryck mellanslag f\xF6r att hoppa!"
    m_Metadata:
      m_Items: []
  - m_Id: 9050606470615040
    m_Localized: "WASD att g\xE5!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498174986440704
    m_Localized: "Peep, min befj\xE4drade v\xE4n... Du har f\xF6r mycket att l\xE4ra
      dig!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498211413970944
    m_Localized: "Ser du ditt ansikte d\xE4r? En frisk f\xE5gel \xE4r viktig s\xE5
      se till att alltid se s\xE5 bra ut som m\xF6jligt!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498241084477440
    m_Localized: "Den d\xE4r GR\xD6NA stapeln? Uth\xE5llighet hj\xE4lper dig att
      SPRINGA och FLASKA dig ut ur fara. Eller in... Det \xE4r ditt val..."
    m_Metadata:
      m_Items: []
  - m_Id: 13498264253812736
    m_Localized: "Den VITA? Vad g\xF6r vi b\xE4st? BAJS! Se till att h\xE5lla magen
      full!"
    m_Metadata:
      m_Items: []
  - m_Id: 13498282230599680
    m_Localized: "H\xE5ll alltid utkik p\xE5 din MINIKARTA och KOMPASS!"
    m_Metadata:
      m_Items: []
  - m_Id: 13499494753554432
    m_Localized: "Tryck p\xE5 I eller SELECT-KNAPPEN f\xF6r att \xF6ppna ditt WINGVENTORY.
      Alla artiklar eller tillbeh\xF6r du hittar kan placeras h\xE4r."
    m_Metadata:
      m_Items: []
  - m_Id: 13499516069007360
    m_Localized: "Om du trycker p\xE5 M eller D-PAD UP visas din karta."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
