  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12858535531433984
    m_Localized: "\uC544\uC544\uC544\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\uC5B4\uBA38, \uB108\uC600\uAD6C\uB098! \uC790\uAFB8 \uB0A0 \uB180\uB77C\uAC8C
      \uD558\uC9C0 \uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "\uB0B4 \uC740\uC2E0\uCC98\uB3C4 \uAC70\uC758 \uB9DD\uAC00\uB728\uB9B4
      \uBED4\uD588\uC5B4!! \uC800\uAE30 \uC788\uB294 \uC778\uAC04\uB4E4\uC774 \uB0B4
      \uAE43\uD138\uC744 \uB2E4 \uB5A8\uC5B4\uB728\uB838\uC796\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "\uC6B0\uB9AC\uAC00 \uD55C\uB54C \uC778\uAC04\uC744 \uB3C4\uC654\uB2E4\uB294
      \uC804\uC124\uC774 \uC788\uB2E4\uB294 \uAC70 \uC544\uC138\uC694? \uC218\uCC9C
      \uD0AC\uB85C\uBBF8\uD130\uC5D0 \uB2EC\uD558\uB294 \uC6B0\uD3B8\uBB3C\uC744
      \uBC30\uB2EC\uD574\uC92C\uB2E4\uACE0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "\uC6B0\uB9AC\uB294 \uC601\uC6C5\uC774\uC5C8\uC5B4! \uD558\uB298\uC758
      \uC804\uB839! \uC791\uACE0 \uAE43\uD138 \uB2EC\uB9B0 \uBC30\uB2EC\uC758 \uC804\uC124!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\uB9D0\uB3C4 \uC548 \uB418\uB294 \uC18C\uB9AC \uAC19\uC8E0? \uC774\uC81C\uB294
      \uAC70\uC758 \uCAD3\uC544\uC624\uBA74\uC11C \uC18C\uB9AC\uB9CC \uC9C8\uB7EC\uB300\uC694.
      \uB108\uBB34 \uBB34\uC11C\uC6CC\uC694! \uC778\uAC04\uC740 \uC815\uB9D0 \uC608\uCE21
      \uBD88\uAC00\uB2A5\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "\uADF8\uB4E4\uC740 \uB2F9\uC2E0\uC744 \uBC1C\uACAC\uD558\uBA74
      \uBB3C\uAC74\uC744 \uB358\uC9C0\uAC70\uB098 \uBC1C\uB85C \uCC28\uAC70\uB098
      \uCAD3\uC544\uC624\uB294 \uACBD\uD5A5\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB2C8
      \uB208\uC5D0 \uB744\uC9C0 \uC54A\uC73C\uB824\uBA74\u2026 \uBAB0\uB798 \uC228\uC5B4\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "\uC67C\uCABD Ctrl \uD0A4 \uB610\uB294 \uC67C\uCABD \uBC94\uD37C
      \uBC84\uD2BC\uC744 \uB204\uB978 \uC0C1\uD0DC\uC5D0\uC11C \uCC9C\uCC9C\uD788
      \uC6C0\uC9C1\uC774\uC138\uC694. \uC0C1\uC790, \uBCA4\uCE58, \uC6B8\uD0C0\uB9AC,
      \uC7A5\uC2DD\uC6A9 \uAD00\uBAA9 \uB4F1 \uC8FC\uBCC0 \uC0AC\uBB3C \uB4A4\uC5D0
      \uC228\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "\uB2EC\uB9AC\uB824\uBA74 \uC67C\uCABD Shift \uD0A4 \uB610\uB294
      L3 \uD0A4\uB97C \uAE38\uAC8C \uB204\uB974\uC138\uC694. \uC740\uC2E0 \uBAA8\uB4DC\uAC00
      \uD574\uC81C\uB418\uB2C8 \uBE60\uB974\uAC8C \uC774\uB3D9\uD558\uC138\uC694!
      \uC6D0\uD558\uB294 \uBB3C\uAC74\uC774 \uBCF4\uC774\uBA74 F \uD0A4\uB97C \uB20C\uB7EC
      \uC7BD\uC2F8\uAC8C \uC90D\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\uC790\uC2E0\uAC10 \uB118\uCE58\uC138\uC694? \uC800 \uC880 \uB3C4\uC640\uC8FC\uC138\uC694.
      \uADF9\uC7A5\uC5D0\uC11C \uBAA8\uC790\uB97C \uC783\uC5B4\uBC84\uB838\uC5B4\uC694!
      \uAC8C\uB2E4\uAC00 \uC0AC\uB78C\uB4E4\uB85C \uBD81\uC801\uAC70\uB824\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "\uC0AC\uC2E4 \uC800\uAC74 \uC81C \uC218\uBA74\uB4F1\uC774\uC5D0\uC694.
      \uBC18\uB527\uBD88\uC774\uAC00 \uB4E0 \uC720\uB9AC\uBCD1\uC774\uC8E0. \uC800\uAC70
      \uC5C6\uC73C\uBA74 \uC7A0\uC744 \uBABB \uC790\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "\uC815\uB9D0\uC694?! \uC624, \uB2E4\uD589\uC774\uB2E4. \uC54C\uC558\uC5B4,
      \uC54C\uC558\uC5B4. \uC0AC\uB78C\uB4E4 \uBAB0\uB798 \uC9C0\uB098\uAC00. \uC8FC\uBCC0
      \uBB3C\uAC74\uB4E4\uC744 \uBC29\uD328 \uC0BC\uC544 \uC228\uC5B4. \uB9CC\uC57D
      \uC0AC\uB78C\uB4E4\uC774 \uB110 \uBCF4\uBA74\u2026 \uC5BC\uB978 \uBC1C\uAC78\uC74C\uC744
      \uC62E\uACA8\uC57C \uD560 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\uC544, \uAD1C\uCC2E\uC544. \uC804\uD600 \uBB38\uC81C\uC5C6\uC5B4.
      \uADF8\uB0E5\u2026 \uB2E4\uC2DC\uB294 \uC7A0\uC744 \uBABB \uC798 \uAC83 \uAC19\uC544.
      \uBAB0\uB798 \uC7A0\uC790\uB294 \uC5F0\uC2B5\uC744 \uB354 \uD558\uBA74 \uB418\uACA0\uB124.
      \uC88B\uC544. \uC5F0\uC2B5\uC774 \uC88B\uC796\uC544. \uC5F0\uC2B5\uC740 \uC548\uC804\uD558\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\uB18D\uB2F4\uC774\uC57C, \uB098 \uC9C0\uAE08 \uB2F9\uC7A5 \uC218\uBA74\uB4F1\uC774
      \uD544\uC694\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\uD574\uB0C8\uAD6C\uB098!!! \uB10C \uB0B4\uAC00 \uC544\uB294 \uC0C8
      \uC911\uC5D0\uC11C \uC81C\uC77C \uC6A9\uAC10\uD574. \uBB3C\uB860 \uAE30\uC900\uC774
      \uADF8\uB9AC \uB192\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uADF8\uB798\uB3C4 \uB9D0\uC774\uC57C!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\uC138\uC0C1\uC5D0! \uC548\uB155!! \uC5EC\uAE30 \uC654\uAD6C\uB098!!
      \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544, \uB108\uBB34 \uB180\uB77C\uC9C0
      \uB9C8. \uB0B4\uAC00 \uCD5C\uACE0\uC758 \uBB3C\uAC74\uC744 \uCC3E\uC558\uAC70\uB4E0!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB824\uC838 \uC788\uC5C8\uC5B4\uC694!!
      \uADF8 \uB9D0\uC740 \uACE7 \uACE0\uAE09 \uC81C\uD488\uC774\uB77C\uB294 \uB73B\uC774\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "\uC790, \uBCF4\uC138\uC694. \uBC18\uC9DD\uAC70\uB9AC\uAC70\uB098,
      \uBC14\uC0AD\uAC70\uB9AC\uAC70\uB098, \uC544\uB2C8\uBA74 \uC74C\uC2DD \uBAA8\uC591\uCC98\uB7FC
      \uBCF4\uC774\uB294 \uAC8C \uC788\uB098\uC694? \uADF8\uB7F0 \uAC74 \uC9D1\uC5B4
      \uC62C\uB9B4 \uC218 \uC788\uC5B4\uC694! F \uD0A4\uB098 Y \uD0A4\uB97C \uB20C\uB7EC\uC11C
      \uC7A1\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\uADF8\uB798!! \uB0A0\uAC1C \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uC5B4\uB46C!
      \uAC70\uAE30\uAC00 \uBC14\uB85C \uBCF4\uBB3C \uC8FC\uBA38\uB2C8\uC57C! I \uBC84\uD2BC\uC774\uB098
      \uBC29\uD5A5\uD0A4 \uC704\uCABD\uC744 \uB20C\uB7EC\uC11C \uBB58 \uC5BB\uC5C8\uB294\uC9C0
      \uD655\uC778\uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "\uC790, \uC774\uC81C \uC911\uC694\uD55C \uBD80\uBD84\uC785\uB2C8\uB2E4.
      \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC774\uB098 \uB9C8\uC6B0\uC2A4
      \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC131\uAC00\uC2E0 \uC778\uAC04\uB4E4\uC5D0\uAC8C
      \uB625\uC744 \uC2F8\uC138\uC694! \uADF8\uB9AC\uACE0 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uBC84\uD2BC\uC774\uB098 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uC870\uC900\uD558\uBA74 \uB0AD\uBE44\uB97C \uC904\uC77C \uC218
      \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\uBC30\uBCC0 \uC695\uAD6C\uAC00 \uC904\uC5B4\uB4E4\uBA74? \uBA39\uC5B4\uC57C\uC9C0.
      \uC4F0\uB808\uAE30 \uAC19\uC740 \uAC04\uC2DD\uC73C\uB85C \uB2E4\uC2DC \uCC44\uC6CC\uBD10.
      \uC790\uC5F0\uC740 \uC544\uB984\uB2E4\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\uC4F0\uB808\uAE30\uD1B5\uC740 \uB9C8\uCE58 \uBBF8\uC2A4\uD130\uB9AC
      \uC0C1\uC790 \uAC19\uC544\uC694! E \uB610\uB294 X \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC0C1\uD638\uC791\uC6A9\uD574 \uBCF4\uC138\uC694! \uBB34\uC5C7\uC774 \uB098\uC62C\uC9C0\uB294
      \uC544\uBB34\uB3C4 \uBAB0\uB77C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "\uAC10\uC790\uD280\uAE40\uC77C\uC9C0\uB3C4 \uBAB0\uB77C. \uBE75\uC77C\uC9C0\uB3C4.
      \uC544\uB2C8\uBA74 \uBB54\uAC00 \uC778\uC131\uC744 \uAE38\uB7EC\uC8FC\uB294
      \uAC83\uC77C\uC9C0\uB3C4. \uB9CC\uC57D \uBB54\uAC00\uAC00 \uAFC8\uD2C0\uAC70\uB9B0\uB2E4\uBA74,
      \uBA39\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "\uC548\uB155 \uAF2C\uB9C8\uC57C!! \uBA4B\uC9C4 \uCDA4 \uB3D9\uC791\uB4E4\uC744
      \uBC30\uC6B8 \uC900\uBE44 \uB410\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "\uAE34\uC7A5\uC744 \uD478\uC138\uC694. \uD558\uB298\uC740 \uC2DC\uC6D0\uD574\uC694.
      \uCEE4 \uBCF4\uC77C \uBFD0\uC774\uC5D0\uC694. \uB124, \uC5C4\uCCAD\uB098\uAC8C
      \uD06C\uAE34 \uD558\uC9C0\uB9CC\uC694. \uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC744
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "\uC88B\uC544, \uCE5C\uAD6C. \uAE30\uBCF8\uC740 \uC54C\uACA0\uB294\uB370
      \uB354 \uC54C\uACE0 \uC2F6\uC5B4? \uADF8\uB7FC \uC81C\uC77C \uBA3C\uC800? \uC774\uB959!"
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "Birdadette\uAC00 \uC54C\uB824\uC900 WASD \uD0A4 \uB610\uB294 \uC624\uB978\uCABD
      \uC2A4\uD2F1\uC744 \uC0AC\uC6A9\uD558\uC5EC \uBE44\uD589 \uBC29\uD5A5\uC744
      \uC870\uC808\uD558\uC138\uC694. \uBC14\uB78C\uACFC \uC2F8\uC6B0\uC9C0 \uB9D0\uACE0
      \uBC14\uB78C\uC758 \uD750\uB984\uC744 \uD0C0\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "\uBE44\uD589 \uBC84\uD2BC\uC5D0\uC11C \uC190\uC744 \uB5BC\uACE0
      \uD65C\uAC15\uD558\uC138\uC694. \uBE60\uB974\uAC8C \uB098\uB294 \uAC74 \uC27D\uC9C0\uB9CC,
      \uBA4B\uC9C0\uAC8C \uB098\uB294 \uAC74 \uAE30\uC220\uC774 \uD544\uC694\uD558\uC8E0."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
