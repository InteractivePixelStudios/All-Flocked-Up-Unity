  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AFU_Dialogue_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 16bec568f3680914b892c4018b766c2f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12858535531433984
    m_Localized: "\uC544\uC544\uC544\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858615307096064
    m_Localized: "\uC5B4\uBA38, \uB108\uC600\uAD6C\uB098! \uC790\uAFB8 \uB0A0 \uB180\uB77C\uAC8C
      \uD558\uC9C0 \uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858656721653760
    m_Localized: "\uB0B4 \uC740\uC2E0\uCC98\uB3C4 \uAC70\uC758 \uB9DD\uAC00\uB728\uB9B4
      \uBED4\uD588\uC5B4!! \uC800\uAE30 \uC788\uB294 \uC778\uAC04\uB4E4\uC774 \uB0B4
      \uAE43\uD138\uC744 \uB2E4 \uB5A8\uC5B4\uB728\uB838\uC796\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858676174835712
    m_Localized: "\uC6B0\uB9AC\uAC00 \uD55C\uB54C \uC778\uAC04\uC744 \uB3C4\uC654\uB2E4\uB294
      \uC804\uC124\uC774 \uC788\uB2E4\uB294 \uAC70 \uC544\uC138\uC694? \uC218\uCC9C
      \uD0AC\uB85C\uBBF8\uD130\uC5D0 \uB2EC\uD558\uB294 \uC6B0\uD3B8\uBB3C\uC744
      \uBC30\uB2EC\uD574\uC92C\uB2E4\uACE0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858715718733824
    m_Localized: "\uC6B0\uB9AC\uB294 \uC601\uC6C5\uC774\uC5C8\uC5B4! \uD558\uB298\uC758
      \uC804\uB839! \uC791\uACE0 \uAE43\uD138 \uB2EC\uB9B0 \uBC30\uB2EC\uC758 \uC804\uC124!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858725592125440
    m_Localized: "\uB9D0\uB3C4 \uC548 \uB418\uB294 \uC18C\uB9AC \uAC19\uC8E0? \uC774\uC81C\uB294
      \uAC70\uC758 \uCAD3\uC544\uC624\uBA74\uC11C \uC18C\uB9AC\uB9CC \uC9C8\uB7EC\uB300\uC694.
      \uB108\uBB34 \uBB34\uC11C\uC6CC\uC694! \uC778\uAC04\uC740 \uC815\uB9D0 \uC608\uCE21
      \uBD88\uAC00\uB2A5\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858767568719872
    m_Localized: "\uADF8\uB4E4\uC740 \uB2F9\uC2E0\uC744 \uBC1C\uACAC\uD558\uBA74
      \uBB3C\uAC74\uC744 \uB358\uC9C0\uAC70\uB098 \uBC1C\uB85C \uCC28\uAC70\uB098
      \uCAD3\uC544\uC624\uB294 \uACBD\uD5A5\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB2C8
      \uB208\uC5D0 \uB744\uC9C0 \uC54A\uC73C\uB824\uBA74\u2026 \uBAB0\uB798 \uC228\uC5B4\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858778331303936
    m_Localized: "\uC67C\uCABD Ctrl \uD0A4 \uB610\uB294 \uC67C\uCABD \uBC94\uD37C
      \uBC84\uD2BC\uC744 \uB204\uB978 \uC0C1\uD0DC\uC5D0\uC11C \uCC9C\uCC9C\uD788
      \uC6C0\uC9C1\uC774\uC138\uC694. \uC0C1\uC790, \uBCA4\uCE58, \uC6B8\uD0C0\uB9AC,
      \uC7A5\uC2DD\uC6A9 \uAD00\uBAA9 \uB4F1 \uC8FC\uBCC0 \uC0AC\uBB3C \uB4A4\uC5D0
      \uC228\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858793414021120
    m_Localized: "\uB2EC\uB9AC\uB824\uBA74 \uC67C\uCABD Shift \uD0A4 \uB610\uB294
      L3 \uD0A4\uB97C \uAE38\uAC8C \uB204\uB974\uC138\uC694. \uC740\uC2E0 \uBAA8\uB4DC\uAC00
      \uD574\uC81C\uB418\uB2C8 \uBE60\uB974\uAC8C \uC774\uB3D9\uD558\uC138\uC694!
      \uC6D0\uD558\uB294 \uBB3C\uAC74\uC774 \uBCF4\uC774\uBA74 F \uD0A4\uB97C \uB20C\uB7EC
      \uC7BD\uC2F8\uAC8C \uC90D\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858805535559680
    m_Localized: "\uC790\uC2E0\uAC10 \uB118\uCE58\uC138\uC694? \uC800 \uC880 \uB3C4\uC640\uC8FC\uC138\uC694.
      \uADF9\uC7A5 \uC548\uC5D0\uC11C \uC774 \uC608\uC05C \uC5F4\uC1E0\uACE0\uB9AC\uB97C
      \uB5A8\uC5B4\uB728\uB838\uC5B4\uC694! \uAC8C\uB2E4\uAC00 \uC0AC\uB78C\uB4E4\uB85C
      \uBD81\uC801\uC774\uB294 \uACF3\uC778\uB370!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858816449138688
    m_Localized: "\uC7A1\uC744 \uC218 \uC788\uC73C\uBA74 \uAC00\uC838\uAC00\uC138\uC694!
      \uB098\uC911\uC5D0 \uC4F8\uBAA8\uAC00 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858827740205056
    m_Localized: "\uC0AC\uB78C\uB4E4 \uBAB0\uB798 \uC9C0\uB098\uAC00 \uBCF4\uC138\uC694.
      \uB9CC\uC57D \uC0AC\uB78C\uB4E4\uC774 \uB2F9\uC2E0\uC744 \uBCF4\uBA74\u2026
      \uC5BC\uB978 \uBC1C\uAC78\uC74C\uC744 \uC7AC\uCD09\uD574\uC57C \uD560 \uAC70\uC608\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858854894129152
    m_Localized: "\uC544, \uAD1C\uCC2E\uC544\uC694. \uAD1C\uCC2E\uC544\uC694. \uC81C\uAC00
      \uC9C1\uC811 \uAC00\uC11C \uAC00\uC838\uC62C\uAC8C\uC694. \uC88B\uC544\uC694.
      \uC804 \uC5F0\uC2B5\uD558\uB294 \uAC78 \uC88B\uC544\uD574\uC694. \uC5F0\uC2B5\uC740
      \uC548\uC804\uD558\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858866810146816
    m_Localized: "\uB18D\uB2F4\uC774\uC57C. \uC774\uBC88\uC5D4 \uB124 \uCC28\uB840\uC57C.
      \uC2DC\uC791\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858879363698688
    m_Localized: "\uD574\uB0C8\uAD6C\uB098!!! \uB10C \uB0B4\uAC00 \uC544\uB294 \uC0C8
      \uC911\uC5D0\uC11C \uC81C\uC77C \uC6A9\uAC10\uD574. \uBB3C\uB860 \uAE30\uC900\uC774
      \uADF8\uB9AC \uB192\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uADF8\uB798\uB3C4 \uB9D0\uC774\uC57C!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858898321952768
    m_Localized: "\uC138\uC0C1\uC5D0! \uC548\uB155!! \uC5EC\uAE30 \uC654\uAD6C\uB098!!
      \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544, \uB108\uBB34 \uB180\uB77C\uC9C0
      \uB9C8. \uB0B4\uAC00 \uCD5C\uACE0\uC758 \uBB3C\uAC74\uC744 \uCC3E\uC558\uAC70\uB4E0!!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858909378138112
    m_Localized: "\uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB824\uC838 \uC788\uC5C8\uC5B4\uC694!!
      \uADF8 \uB9D0\uC740 \uACE7 \uACE0\uAE09 \uC81C\uD488\uC774\uB77C\uB294 \uB73B\uC774\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 12858920618872832
    m_Localized: "\uC790, \uBCF4\uC138\uC694. \uBC18\uC9DD\uAC70\uB9AC\uAC70\uB098,
      \uBC14\uC0AD\uAC70\uB9AC\uAC70\uB098, \uC544\uB2C8\uBA74 \uC74C\uC2DD \uBAA8\uC591\uCC98\uB7FC
      \uBCF4\uC774\uB294 \uAC8C \uC788\uB098\uC694? \uADF8\uB7FC \uB2EC\uB824\uAC00\uC11C
      \uBA39\uC5B4 \uBCF4\uC138\uC694! \uB9CC\uC57D \uBA39\uC744 \uC218 \uC5C6\uB2E4\uBA74,
      F \uD0A4\uB098 X \uBC84\uD2BC\uC744 \uAE38\uAC8C \uB20C\uB7EC\uC11C \uC7A1\uC544
      \uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858930215440384
    m_Localized: "\uADF8\uB798!! \uB0A0\uAC1C \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uC5B4\uB46C!
      \uAC70\uAE30\uAC00 \uBC14\uB85C \uBCF4\uBB3C \uC8FC\uBA38\uB2C8\uC57C! I \uBC84\uD2BC\uC774\uB098
      \uBC29\uD5A5\uD0A4 \uC704\uCABD\uC744 \uB20C\uB7EC\uC11C \uBB58 \uC5BB\uC5C8\uB294\uC9C0
      \uD655\uC778\uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 12858930601316352
    m_Localized: "\uC790, \uC774\uC81C \uC911\uC694\uD55C \uBD80\uBD84\uC785\uB2C8\uB2E4.
      \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC774\uB098 \uB9C8\uC6B0\uC2A4
      \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC131\uAC00\uC2E0 \uC778\uAC04\uB4E4\uC5D0\uAC8C
      \uB625\uC744 \uC2F8\uC138\uC694! \uADF8\uB9AC\uACE0 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uBC84\uD2BC\uC774\uB098 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uC870\uC900\uD558\uBA74 \uB0AD\uBE44\uB97C \uC904\uC77C \uC218
      \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858949450518528
    m_Localized: "\uBC30\uBCC0 \uC695\uAD6C\uAC00 \uC904\uC5B4\uB4E4\uBA74? \uBA39\uC5B4\uC57C\uC9C0.
      \uC4F0\uB808\uAE30 \uAC19\uC740 \uAC04\uC2DD\uC73C\uB85C \uB2E4\uC2DC \uCC44\uC6CC\uBD10.
      \uC790\uC5F0\uC740 \uC544\uB984\uB2E4\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 12858957461639168
    m_Localized: "\uC4F0\uB808\uAE30\uD1B5\uC740 \uB9C8\uCE58 \uBBF8\uC2A4\uD130\uB9AC
      \uC0C1\uC790 \uAC19\uC544\uC694! E \uB610\uB294 X \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC0C1\uD638\uC791\uC6A9\uD574 \uBCF4\uC138\uC694! \uBB34\uC5C7\uC774 \uB098\uC62C\uC9C0\uB294
      \uC544\uBB34\uB3C4 \uBAB0\uB77C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 12858965699252224
    m_Localized: "\uAC10\uC790\uD280\uAE40\uC77C\uC9C0\uB3C4 \uBAB0\uB77C. \uBE75\uC77C\uC9C0\uB3C4.
      \uC544\uB2C8\uBA74 \uBB54\uAC00 \uC778\uC131\uC744 \uAE38\uB7EC\uC8FC\uB294
      \uAC83\uC77C\uC9C0\uB3C4. \uB9CC\uC57D \uBB54\uAC00\uAC00 \uAFC8\uD2C0\uAC70\uB9B0\uB2E4\uBA74,
      \uBA39\uC9C0 \uC54A\uB294 \uAC8C \uC88B\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 12858974268215296
    m_Localized: "\uC774\uBD10 \uAF2C\uB9C8! \uBA4B\uC9C4 \uCDA4 \uB3D9\uC791\uB4E4\uC744
      \uBC30\uC6B8 \uC900\uBE44 \uB410\uB2C8?"
    m_Metadata:
      m_Items: []
  - m_Id: 12858985622196224
    m_Localized: "\uAE34\uC7A5\uC744 \uD478\uC138\uC694. \uD558\uB298\uC740 \uC2DC\uC6D0\uD574\uC694.
      \uCEE4 \uBCF4\uC77C \uBFD0\uC774\uC5D0\uC694. \uB124, \uC5C4\uCCAD\uB098\uAC8C
      \uD06C\uAE34 \uD558\uC9C0\uB9CC\uC694. \uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC744
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12858996628049920
    m_Localized: "\uAE30\uBCF8\uC740 \uC54C\uC9C0\uB9CC \uB354 \uBC30\uC6B0\uACE0
      \uC2F6\uC73C\uC2DC\uC8E0? \uBE60\uB974\uAC8C \uB098\uB294 \uAC74 \uC27D\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uBA4B\uC9C0\uAC8C \uB098\uB294 \uAC74 \uAE30\uC220\uC774
      \uD544\uC694\uD558\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 12859006878928896
    m_Localized: "\uBE60\uB974\uAC8C \uD558\uAC15\uD574\uC57C \uD558\uB098\uC694?
      Q \uD0A4\uB97C \uC0AC\uC6A9\uD558\uC138\uC694. \uC880 \uB354 \uBD80\uB4DC\uB7FD\uAC8C
      \uB0B4\uB824\uAC00\uACE0 \uC2F6\uC73C\uC2E0\uAC00\uC694? G \uD0A4\uB85C \uACF5\uC911
      \uC815\uC9C0\uD558\uAC70\uB098, \uBD80\uB4DC\uB7FD\uAC8C \uD65C\uAC15\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12859020745297920
    m_Localized: "\uC790, \uC774\uC81C \uBAA8\uB4E0 \uAC78 \uC885\uD569\uD574 \uBCF4\uC138\uC694.
      \uC774 \uD45C\uC9C0\uD310\uC5D0 \uC788\uB294 \uAC83\uACFC \uAC19\uC740 \uB808\uC774\uC2A4
      \uD3EC\uC2A4\uD130\uB97C \uCC3E\uC544\uC11C \uC2E4\uB825\uC744 \uC2DC\uD5D8\uD574
      \uBCF4\uC138\uC694! \uB2F9\uC2E0\uC758 \uAE30\uB7C9\uC744 \uBCF4\uC5EC\uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 47017676951552
    m_Localized: "\uC774\uBD10, \uC80A\uC740\uC774! \uAE38\uC744 \uC783\uC740 \uAC83
      \uAC19\uAD70? \uB0B4\uAC00 \uB3C4\uC640\uC904\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 47031874670592
    m_Localized: "\uB0B4 \uBAA8\uB4E0 \uAF43-"
    m_Metadata:
      m_Items: []
  - m_Id: 47051256549376
    m_Localized: "\uC5B4\uCA0C\uB4E0 *\uC5EC\uAE30\uC11C \uB2F9\uC2E0\uC758 \uC778\uC0DD
      \uC774\uC57C\uAE30\uB97C \uC804\uBD80 \uBB3C\uC5B4\uBCF8 \uAC74 \uC544\uB2C8\uC796\uC544\uC694*"
    m_Metadata:
      m_Items: []
  - m_Id: 47061553565696
    m_Localized: "\uC774 \uADFC\uCC98\uC5D0 \uC81C\uAC00 \uC544\uB07C\uB294 \uC9D1\uC774
      \uD558\uB098 \uC788\uB294\uB370, \uD544\uC694\uD558\uC138\uC694? \uC880 \uC190\uBCFC
      \uACF3\uC740 \uC788\uC9C0\uB9CC \uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53441740066816
    m_Localized: "\uAD1C\uCC2E\uC740"
    m_Metadata:
      m_Items: []
  - m_Id: 53560052994048
    m_Localized: "\uC88B\uC544\uC694! \uD53C\uD06C\uB2C9 \uD14C\uC774\uBE14 \uADFC\uCC98\uC5D0
      \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 53686830026752
    m_Localized: "\uBE44\uB458\uAE30 \uB465\uC9C0\uB294 \uC6D0\uB798 \uC800\uB807\uAC8C
      \uD749\uCE21\uD558\uAC8C \uC0DD\uAE34 \uAC74\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 314207697293312
    m_Localized: "\uC6B0\uB9AC \uB54C\uB294 \uBFB0\uC871\uD55C \uB9D0\uB69D \uC704\uC5D0\uC11C
      \uC790\uBA74\uC11C \uD589\uBCF5\uD558\uAC8C \uC9C0\uB0C8\uC9C0. *\uBE44\uC6C3\uC74C*
      \uADF8\uB798, \uB098\uBB47\uAC00\uC9C0 \uBA87 \uAC1C\uB85C \uC880 \uAFB8\uBA70\uBCF4\uBA74
      \uC5B4\uB5A8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 314243671838720
    m_Localized: "\uB465\uC9C0\uB97C \uD655\uC778\uD574 \uBD10! \uD639\uC2DC \uBA87
      \uAC1C \uB0A8\uACA8\uB454 \uAC8C \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C?"
    m_Metadata:
      m_Items: []
  - m_Id: 314257315909632
    m_Localized: "\uB2F9\uC2E0\uC774 \uC5EC\uAE30 \uCC98\uC74C \uC624\uC168\uC73C\uB2C8
      \uBA87 \uAC00\uC9C0 \uD301\uC744 \uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22288765664808960
    m_Localized: "\uC6B0\uB9AC\uAC00 \uC544\uBB34 \uB370\uB098 \uB625 \uC2F8\uB294
      \uAC78\uB85C \uC720\uBA85\uD558\uC8E0. \uD558\uC9C0\uB9CC \uBA3C\uC800 \uBC30\uBD80\uD130
      \uCC44\uC6CC\uC57C \uD574\uC694! \uC5EC\uAE30 \uC8FC\uBCC0\uC5D0 \uBA39\uC744
      \uAC8C \uBD84\uBA85 \uC788\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22288790117601280
    m_Localized: "\uB0B4\uAC00 \uC774\uB807\uAC8C \uB9D0\uD558\uB294 \uAC74 \uB110
      \uAC71\uC815\uD574\uC11C \uD558\uB294 \uB9D0\uC774\uC57C... \uD558\uC9C0\uB9CC
      \uB10C... \uC880 \uC57D\uD574 \uBCF4\uC5EC. \uB10C \uAC15\uD574\uC9C8 \uAC70\uC57C.
      \uD558\uC9C0\uB9CC \uC6B0\uB9AC \uBAA8\uB450 \uAC00\uB054\uC740 \uB3C4\uC6C0\uC774
      \uD544\uC694\uD558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 22288797528936448
    m_Localized: "\uB9E8\uD640 \uB69C\uAED1\uC744 \uBC1F\uACE0 \uC62C\uB77C\uAC00\uBA74
      \uAC74\uBB3C \uAF2D\uB300\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uAC08 \uD655\uB960\uC774
      \uD6E8\uC52C \uB192\uC544\uC9C8 \uAC70\uC608\uC694. \uAC70\uAE30\uC120 \uD654\uB09C
      \uC0AC\uB78C\uB4E4\uC744 \uD53C\uD574 \uC228\uB294 \uAC8C \uC544\uC8FC \uC88B\uB2F5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288803342241792
    m_Localized: "\uC5B4\uB5BB\uAC8C \uC774\uB807\uAC8C \uBE68\uB9AC \uC62C\uB77C\uC654\uC5B4?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288808417349632
    m_Localized: "\uBE60\uB974\uB2E4\uACE0...? \uB108\uBB34 \uC624\uB798 \uAC78\uB824\uC11C
      \uD558\uB9C8\uD130\uBA74 \uB5A0\uB0A0 \uBED4\uD588\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288815488946176
    m_Localized: "\uC74C\uC2DD\uC744 \uC5B4\uB514\uC11C \uAD6C\uD560 \uC218 \uC788\uB294\uC9C0
      \uC544\uC2DC\uC8E0? \uC548\uC804\uD558\uAC8C \uC9C0\uB0B4\uB294 \uBC29\uBC95\uB3C4
      \uC544\uC2DC\uACE0\uC694. \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB9C8\uC9C0\uB9C9\uC5D0
      \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288820656328704
    m_Localized: "\uC800\uAE30 \uC544\uB798 \uC0AC\uB78C\uB4E4 \uBCF4\uC5EC? \uC5B4\uB5BB\uAC8C
      \uD574\uC57C \uD558\uB294\uC9C0 \uC54C\uC9C0! \uB0A0 \uC790\uB791\uC2A4\uB7FD\uAC8C
      \uB9CC\uB4E4\uC5B4\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288830890430464
    m_Localized: "\uB0B4\uAC00 \uC544\uB294 \uAC74 \uB2E4 \uAC00\uB974\uCCD0\uC92C\uC5B4.
      \uC774\uC81C \uB2E4\uB978 \uC0C8\uB4E4\uC744 \uAD34\uB86D\uD788\uB7EC \uAC00\uC57C\uACA0\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288840398917632
    m_Localized: "\uC57C!! \uC57C \uCFE0!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288848867217408
    m_Localized: "\uC800 \uC544\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288856677011456
    m_Localized: "\uC544\uB2C8\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22288863077519360
    m_Localized: "\uADF8\uB7F0\uB370 \uD639\uC2DC \uB204\uAC00 \uB2F9\uC2E0 \uC544\uB294
      \uC0AC\uB78C\uC774\uB791 \uB108\uBB34 \uB611\uAC19\uC774 \uC0DD\uACBC\uB2E4\uACE0
      \uB9D0\uD574\uC900 \uC801 \uC788\uC5B4\uC694? \uC815\uB9D0 \uC758\uC2EC\uC2A4\uB7EC\uC6B8
      \uC815\uB3C4\uB85C \uB611\uAC19\uC544\uC694. *\uB208\uC744 \uCC21\uADF8\uB9AC\uBA70*"
    m_Metadata:
      m_Items: []
  - m_Id: 22288910452183040
    m_Localized: "\uB2F9\uC2E0\uC740 \uADF8\uB4E4\uC744 \uAF2D \uB9CC\uB098\uBD10\uC57C
      \uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288919834841088
    m_Localized: "\uADF8\uAC74\u2026\uB3C4\uC6C0\uC774 \uC548 \uB418\uB124\uC694.
      \uB204\uAD6C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288926696722432
    m_Localized: "\uC5B4\uCC28\uD53C \uAC00\uC2DC\uB294 \uAE40\uC5D0 \uC81C\uAC00
      \uBE5A\uC9C4 \uBE75 \uC880 \uAC00\uC838\uB2E4\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288933424386048
    m_Localized: "\uB2F9\uC2E0\uC774 \uC9C1\uC811 \uD560 \uC218 \uC5C6\uB098\uC694?
      \uC800\uB294 \uC774\uB7F0 \uC77C\uC5D0 \uB3D9\uC758\uD55C \uC801\uC774 \uC5C6\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288944136638464
    m_Localized: "...\uC800\uB294 \uCE5C\uAD6C\uB4E4\uC758 \uC57D\uAC04\uC758 \uB3C4\uC6C0\uC73C\uB85C
      \uADF8\uB7ED\uC800\uB7ED \uC9C0\uB0B4\uACE0 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288956249788416
    m_Localized: "\uBB3C\uB860\uC774\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 22288964126691328
    m_Localized: "\uB2F9\uC2E0\u2026 \uC660\uC9C0 \uB0AF\uC774 \uC775\uB124\uC694?
      \uC774\uC0C1\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22288973677121536
    m_Localized: "\uC719\uACE0\uAC00 \uC774\uAC78 \uB108\uC5D0\uAC8C \uAC00\uC838\uB2E4\uC8FC\uB77C\uACE0
      \uD588\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 22288987216334848
    m_Localized: "\uC544, \uADF8\uAC00 \uBE5A\uC9C4 \uBE75\uC774\uB77C\uB2C8. \uC815\uB9D0
      \uC815\uC2E0\uC5C6\uB294 \uBC24\uC774\uC5C8\uC5B4. \uC719\uACE0\uC5D0\uAC8C
      \uACE0\uB9D9\uB2E4\uACE0 \uC804\uD574\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 22288994841579520
    m_Localized: "\uC544, \uB09C \uAC70\uAE30 \uB2E4\uC2DC\uB294 \uC548 \uAC08 \uAC70\uC57C.
      \uB09C \uADF8\uB4E4\uC744 \uD3C9\uC0DD \uB9CC\uB09C \uC801\uB3C4 \uC5C6\uACE0\u2026
      \uC194\uC9C1\uD788 \uC880 \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 22289000399032320
    m_Localized: "\uC6B0\uB9AC \uBE44\uB458\uAE30\uB4E4\uC740 \uC544\uC8FC \uB9CE\uC544\uC694!
      \uC6B0\uB9AC \uBE44\uB458\uAE30\uB4E4\uC740 \uC720\uC804\uC790\uAC00 \uAC15\uD558\uAC70\uB4E0\uC694
      *\uC719\uD06C*"
    m_Metadata:
      m_Items: []
  - m_Id: 22289005453168640
    m_Localized: "\uC6B0\uB9AC \uBE44\uB458\uAE30\uB4E4\uC740 \uC544\uC8FC \uB9CE\uC544\uC694!
      \uC6B0\uB9AC \uBE44\uB458\uAE30\uB4E4\uC740 \uC720\uC804\uC790\uAC00 \uAC15\uD558\uAC70\uB4E0\uC694
      *\uC719\uD06C*"
    m_Metadata:
      m_Items: []
  - m_Id: 22289010423418880
    m_Localized: "\uC624! \uC218\uACE0\uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.
      \uC774 \uC815\uB3C4\uB294 \uD574\uB4DC\uB9B4 \uC218 \uC788\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 22289023526424576
    m_Localized: "\uC774\uBD10, \uCE5C\uAD6C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289031155863552
    m_Localized: "\uB2F9\uC2E0\uC740 \uC80A\uACE0 \uD65C\uAE30\uCC28 \uBCF4\uC774\uC2DC\uB124\uC694.
      \uACE0\uC591\uC774 \uD55C\uB450 \uB9C8\uB9AC\uCBE4\uC740 \uAC81\uBA39\uAC8C
      \uD560 \uB9CC\uD07C \uAC15\uC778\uD574 \uBCF4\uC5EC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289039905181696
    m_Localized: "\uB098 \uAC19\uC740 \uB098\uC774 \uB4E0 \uC0AC\uB78C\uC774 \uACAA\uB294
      \uACE4\uACBD\uC744 \uC880 \uB3C4\uC640\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289049338171392
    m_Localized: "\uC74C... \uC81C\uAC00 \uC880 \uBC14\uBE60\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22289058607583232
    m_Localized: "\uC815\uB9D0 \uD6CC\uB96D\uD574\uC694, \uC0AC\uB791\uD558\uB294
      \uC0C8\uC57C! \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289068019601408
    m_Localized: "\uC7A1\uC885\uACAC \uBB34\uB9AC\uAC00 \uB0B4\uAC00 \uC81C\uC77C
      \uC88B\uC544\uD558\uB294 \uACE8\uBAA9\uAE38\uC5D0 \uC790\uB9AC\uB97C \uC7A1\uC558\uC5B4.
      \uC5EC\uAE30\uC5D4 \uAC54\uB124\uB4E4\uC774 \uC81C\uC77C \uC88B\uC740 \uAC83\uB4E4\uC744
      \uAD6C\uD560 \uC218 \uC788\uAC70\uB4E0\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289074185228288
    m_Localized: "\uACF0\uD321\uC774\uAC00 \uB108\uBB34 \uB9CE\uC774 \uD540 \uAC74
      \uC544\uB2C8\uACE0, \uD48D\uBBF8\uB97C \uB354\uD558\uAE30\uC5D0 \uB531 \uC801\uB2F9\uD55C
      \uC815\uB3C4! \uB2E4\uB978 \uAC74 \uD544\uC694 \uC5C6\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289080057253888
    m_Localized: "\uC5B4\uCA0C\uB4E0, \uC800 \uC9D0\uC2B9\uB4E4 \uB54C\uBB38\uC5D0
      \uB108\uBB34 \uC624\uB798 \uAF3C\uC9DD \uBABB \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 22289092292038656
    m_Localized: "\uC800\uB188\uB4E4\uC5D0\uAC8C \uB625 \uD55C \uBC29 \uC81C\uB300\uB85C
      \uBA39\uC5EC \uBC84\uB824! \uADF8\uB798\uC57C \uC815\uC2E0 \uCC28\uB9B4 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289097505558528
    m_Localized: "\uC544, \uC5B4\uB9B0 \uC0C8 \uD55C \uB9C8\uB9AC\uB3C4 \uAC70\uAE30\uC5D0
      \uAC07\uD78C \uAC83 \uAC19\uC544\uC694. \uB2F9\uC2E0\uC774 \uADF8 \uC0C8\uB791
      \uC815\uB9D0 \uB2EE\uC558\uB124\uC694! \uB124! \uC815\uB9D0 \uADF8\uB798\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289102974930944
    m_Localized: "\uD558\uC9C0\uB9CC \uB354 \uC911\uC694\uD55C \uAC74, \uC81C\uBC1C
      \uC81C \uAC04\uC2DD\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uB3C4\uB85D \uB3C4\uC640\uC8FC\uC138\uC694!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289110713421824
    m_Localized: "\uD0C8\uB9AC \uD638, \uCE5C\uAD6C! - \uADF8\uB798. \uC5B4\uC11C
      \uAC00\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289118481272832
    m_Localized: "\uB0A0 \uCC3E\uC544\uB0C8\uAD6C\uB098!! \uC815\uB9D0 \uB108\uBB34
      \uBB34\uC11C\uC6E0\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289125649338368
    m_Localized: "\uC544\uB974\uB124\uC2A4\uD1A0\uAC00 \uC640\uC8FC\uAE38 \uBC14\uB790\uC9C0\uB9CC,
      \uB2F9\uC2E0\uC744 \uB9CC\uB098\uC11C \uC815\uB9D0 \uAE30\uBED0\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289134994247680
    m_Localized: "\uAC10\uC0AC\uD574\uC694\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289144532094976
    m_Localized: "\uC800\uAE30 \uC788\uB294 \uC800 \uC0C8 \uC54C\uC544? \uACE0\uC591\uC774\uB4E4\uC774
      \"\uBA39\uC5B4! \uBA39\uC5B4!\" \uD558\uACE0 \uC18C\uB9AC\uCE58\uC790 \uB3C4\uB9DD\uCCE4\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 22289154355154944
    m_Localized: "\uC27F! \uC774\uC81C \uAEBC\uC838! \uB0B4 \uACE8\uBAA9\uC5D0\uC11C
      \uB098\uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289159644172288
    m_Localized: "\uAC71\uC815 \uB9C8\uC138\uC694, \uC804 \uC774\uC81C \uAC08\uAC8C\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 22289164488593408
    m_Localized: "\uC624\uB298 \uD558\uB8E8\uAC00 \uB108\uBB34 \uD798\uB4E4\uC5C8\uC73C\uB2C8
      \uB0A0\uAC1C\uB97C \uC880 \uC26C\uAC8C \uD574\uC57C\uACA0\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289168934555648
    m_Localized: "\uC544! \uAC00\uAE30 \uC804\uC5D0, \uC544\uC8FC \uD2B9\uC774\uD55C
      \uB299\uC740 \uAE4C\uB9C8\uADC0\uB97C \uB9CC\uB0AC\uC5B4\uC694. \uC774 \uADFC\uCC98
      \uC5B4\uB518\uAC00\uC5D0 \uAC00\uAC8C\uB97C \uD558\uB098 \uD558\uACE0 \uC788\uB354\uB77C\uACE0\uC694!
      \uD639\uC2DC \uADF8 \uC7A1\uB3D9\uC0AC\uB2C8\uB4E4\uC744 \uB2E4\uB978 \uBB3C\uAC74\uC73C\uB85C
      \uBC14\uAFC0 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289174479425536
    m_Localized: "\uADF8\uB294 \uC8FC\uB85C \uACE8\uBAA9\uAE38\uC5D0\uC11C \uC5B4\uC2AC\uB801\uAC70\uB9AC\uC9C0\uB9CC,
      \uC774 \uC131\uAC00\uC2E0 \uACE0\uC591\uC774\uB4E4\uC744 \uC870\uC2EC\uD558\uC138\uC694.
      \uC800\uCC98\uB7FC \uC4F0\uB808\uAE30\uD1B5\uC5D0\uC11C \uBC24\uC744 \uBCF4\uB0B4\uACE0
      \uC2F6\uC9C0\uB294 \uC54A\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22289185615302656
    m_Localized: "\uC7A5\uC2E0\uAD6C\uB97C \uCC3E\uACE0 \uACC4\uC2E0\uB2E4\uACE0
      \uB4E4\uC5C8\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289193580285952
    m_Localized: "\uAC00\uAC8C\uAC00 \uB2EB\uD614\uC2B5\uB2C8\uB2E4. \uB098\uC911\uC5D0
      \uB2E4\uC2DC \uC624\uC138\uC694\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22289225020788736
    m_Localized: "........ \uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uBB34\uC2A8 \uC77C\uC778\uC9C0
      \uC54C\uACA0\uC5B4\uC694. \uBB34\uC5C7\uC774 \uD544\uC694\uD558\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289232805416960
    m_Localized: "\uACF5\uC815\uD55C \uAC70\uB798 \uC544\uB2CC\uAC00\uC694? \uD558\uCC2E\uC740
      \uBB3C\uAC74\uC744 \uBCF4\uBB3C\uB85C \uBC14\uAFB8\uB294 \uAC74\uAC00\uC694?
      \uC18C\uC720\uAD8C\uC740 \uC18C\uC720\uAD8C\uC73C\uB85C \uBC14\uAFB8\uB294
      \uAC70\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22289259170811904
    m_Localized: "\uC774 \uAC00\uD310\uB300\uB294 \uB0B4 \uAC10\uC625\uC774 \uB418\uC5B4\uBC84\uB838\uC5B4.
      \uC9C4\uC815\uD55C \uC0AC\uB791\uC744 \uC704\uD574 \uC7A5\uBBF8\uB97C \uCC3E\uACE0
      \uC788\uC5B4. \uC7A5\uBBF8\uB9CC\uC774 \uB098\uB97C \uC790\uC720\uB86D\uAC8C
      \uD574\uC904 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22289271736946688
    m_Localized: "\uB2F9\uC2E0\uC740 \uC5B8\uC81C\uB4E0 \uB5A0\uB0A0 \uC218 \uC788\uB2E4\uB294
      \uAC78 \uC54C\uACE0 \uC788\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289281174130688
    m_Localized: "\uD558\uB298\uC744 \uB5A0\uB3C4\uB294 \uC5EC\uD589\uC790\uC5EC,
      \uBAA9\uC801\uC744 \uD488\uACE0 \uC788\uAD6C\uB098. \uB9D0\uD574\uB2E4\uC624,
      \uBC14\uB78C\uC774 \uB0B4\uAC8C \uC18D\uC0AD\uC774\uB4EF \uB108\uC5D0\uAC8C\uB3C4
      \uBE44\uBC00\uC744 \uC18D\uC0AD\uC774\uB294\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 22289290674229248
    m_Localized: "\uC774\uD574\uD588\uC5B4\uC694. \uCC38 \uC2DC\uC801\uC774\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 22289306096685056
    m_Localized: "\uC7A5\uBBF8\uB97C \uAC00\uC838\uC624\uC2DC\uBA74 \uC800\uC640
      \uAC70\uB798\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB54C\uAE4C\uC9C0\uB294
      \uC601\uC5C5\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 22289311423451136
    m_Localized: "\uAE4C\uB9C8\uADC0\uB294 \uBB3C\uAC74\uC744 \uCC3E\uC544\uB0C5\uB2C8\uB2E4\u2026
      \uB9CC\uC57D \uB2F9\uC2E0\uC774 \uC7A5\uC2E0\uAD6C\uB97C \uAC00\uC9C0\uACE0
      \uC788\uB2E4\uBA74\uC694."
    m_Metadata:
      m_Items: []
